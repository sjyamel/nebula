# toolkit.render.scene — the scene graph: what to paint, separated from painting.
#
# Until now `Interpreter.paint` walked the LayoutBox tree and called
# fill_rect/set_pixel as it went. That works, and it is what four shipping
# backends do today, but it forecloses three things the engine wants:
#
#   1. DIFFING. Comparing two flat command lists is tractable; comparing two
#      tree traversals is not. Measured (proposal v4 5a), this is the only
#      change that helps the tiers that are actually slow -- UEFI and bare
#      metal, where a frame costs hundreds of milliseconds and there is no
#      GPU to fall back on.
#   2. SUB-RECT RENDERING. `layout_tree` always sizes its root to the whole
#      canvas, so a second render_to() call repaints the entire surface and
#      erases whatever chrome was already there. Every widget demo works
#      around this by host-painting the dynamic part. Translating a command
#      list is a much smaller thing than parameterising the paint traversal.
#   3. A GPU renderer, if one is ever justified. You cannot batch set_pixel
#      calls; you can batch a list of rounded rects. (Measured as NOT
#      justified today -- see proposal v4 5a -- but the door stays open.)
#
# ## This module deliberately imports nothing
#
# toolkit.ui.interp owns both the emitter and the executor, and it already
# imports the rasterizer primitives. If scene.tr called those primitives it
# would have to import interp, which imports scene -- and Tauraro rejects
# circular imports. So this file is pure data: the command vocabulary and a
# list of commands, nothing that knows how to draw.
#
# ## Why a tagged class rather than an enum
#
# toolkit.ui.ast uses a real enum with Pointer boxing, because a UI tree is
# recursive and variants differ structurally. A command list is flat and the
# variants differ only in which fields matter, so a single tagged class costs
# one allocation per command instead of one allocation plus a box, and it
# needs no match arm to read a field. The unused fields are the price.

pub def cmd_rounded_rect() -> int:
    return 0

pub def cmd_rounded_box() -> int:
    return 1

pub def cmd_text() -> int:
    return 2

# Proposal v4 / nebula1.0 Phase 2 (clipping): bracket commands, not a shape
# to paint. execute_software/execute_diff track a clip STACK as they walk
# the flat command list: push installs toolkit.render.clipped_canvas around
# whatever canvas is currently active (x/y/w/h fields carry the new clip
# rect, in the same absolute coordinate space every other command already
# uses), pop restores the canvas active before the matching push. Kept as
# ordinary Cmd values (all other fields unused/zero) rather than a second
# variant kind, matching this file's existing "single tagged class" choice.
pub def cmd_clip_push() -> int:
    return 3

pub def cmd_clip_pop() -> int:
    return 4

# Markup-tag widgets (checkbox/switch/radio/slider dots and thumbs) are
# circles, which nothing in this file could express before -- every existing
# shape command is a rounded rect at radius<=w/2. Reuses the SAME Cmd fields
# rounded_rect/rounded_box already have (x/y as the CENTER instead of a
# top-left corner, radius as the circle's radius, border_w as the ring's
# width) rather than growing Cmd with circle-only fields -- cmd_eq/
# scenes_diffable stay untouched, since they already compare every field
# generically regardless of what a given kind means by each one.
pub def cmd_circle() -> int:
    return 5

pub def cmd_circle_ring() -> int:
    return 6

# nebula1.0 Phase 3: a two-color rect fill (linear gradient), and a partial
# ring stroke (radial gauge sweep) -- toolkit.ui.style's Style.bg2/grad_dir
# and toolkit.ui.widget_tags' dial/gauge tags are what produce these. Both
# reuse existing Cmd fields rather than adding new ones, same as
# cmd_circle/cmd_circle_ring already do:
#   gradient_rect: x/y/w/h/radius as usual, fill=start color, stroke=end
#     color, border_w=direction (0=horizontal,1=vertical,2=diagonal).
#   arc_ring: x/y=center, radius=r, border_w=ring width, fill=active
#     (swept) color, stroke=track (unswept) color, w=start angle in
#     degrees, h=sweep angle in degrees.
pub def cmd_gradient_rect() -> int:
    return 7

pub def cmd_arc_ring() -> int:
    return 8

# nebula1.0 Phase 4 (baked images): a plain RGBA blit -- x/y/w/h as usual,
# `pixels` a NEW field (row-major RGBA, 4 bytes/pixel, exactly the shape
# scripts/bake-image.ps1 emits) rather than reusing fill/stroke, since
# there is no way to pack a whole pixel buffer into an int. See that
# script's own header for why images are baked offline rather than decoded
# on-device (same reasoning as the font atlas: no decoder in Tauraro's
# stdlib, no filesystem on the freestanding tiers).
pub def cmd_image() -> int:
    return 9

pub class Cmd:
    pub kind:     int
    pub x:        int
    pub y:        int
    pub w:        int
    pub h:        int
    pub radius:   int
    pub border_w: int
    pub fill:     int
    pub stroke:   int
    # The flat colour already behind this command, which its antialiased
    # edges blend toward. Canvas has no alpha and no destination read-back
    # (RASTERIZER.md 0), so this has to be carried, not sampled.
    pub ambient:  int
    pub text:     str
    # nebula1.0 Phase 2: 0-255 (255 = fully opaque, the default every
    # existing Cmd factory sets, so nothing that predates opacity changes
    # behaviour). Only honoured for a PLAIN rect (radius<=0, border_w==0)
    # today -- see toolkit.ui.interp.execute_software's own comment for
    # why rounded/bordered opacity isn't attempted yet.
    pub alpha:    int
    # nebula1.0 Phase 2 (multi-size fonts): only meaningful for a cmd_text
    # command -- which of the three baked atlases (toolkit.text.font's
    # font_size_sm()/_base()/_lg(), the SAME numbers) to paint this label
    # with. 1 (base) on every non-text command's factory below, where it is
    # simply unused. This file cannot import toolkit.ui.style's identically-
    # numbered constants without risking a cycle (same reason this file
    # "imports nothing" -- see its own header), so the literal `1` here and
    # `font_size_base()` there are two names for the same number, not two
    # different defaults.
    pub font_size: int
    # Only meaningful for a cmd_image() command -- RGBA, row-major, 4
    # bytes/pixel, w*h*4 long. Empty (the default) on every other command's
    # factory below, where it is simply unused.
    pub pixels: List[u8]

extend Cmd:
    pub def rounded_rect(x: int, y: int, w: int, h: int, radius: int, fill: int, ambient: int) -> Cmd:
        return Cmd.rounded_rect_alpha(x, y, w, h, radius, fill, ambient, 255)

    # nebula1.0 Phase 2: like rounded_rect, but with an explicit alpha
    # (0-255) instead of the implicit fully-opaque 255. A separate factory
    # rather than a default parameter (Tauraro params are positional/
    # required) -- rounded_rect stays the zero-churn call every PRE-opacity
    # call site keeps using unchanged.
    pub def rounded_rect_alpha(x: int, y: int, w: int, h: int, radius: int, fill: int, ambient: int, alpha: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_rounded_rect()
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.radius = radius
        c.border_w = 0
        c.fill = fill
        c.stroke = 0
        c.ambient = ambient
        c.text = ""
        c.alpha = alpha
        c.font_size = 1
        c.pixels = []
        return c

    pub def rounded_box(x: int, y: int, w: int, h: int, radius: int, border_w: int, fill: int, stroke: int, ambient: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_rounded_box()
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.radius = radius
        c.border_w = border_w
        c.fill = fill
        c.stroke = stroke
        c.ambient = ambient
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = []
        return c

    # `x`/`y` are the circle's CENTER here, not a top-left corner -- the
    # only Cmd kind where that's true, since every other shape is rect-based.
    pub def circle(cx: int, cy: int, r: int, fill: int, ambient: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_circle()
        c.x = cx
        c.y = cy
        c.w = 0
        c.h = 0
        c.radius = r
        c.border_w = 0
        c.fill = fill
        c.stroke = 0
        c.ambient = ambient
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = []
        return c

    # An annulus: `fill` inside the inner radius (r - ring_w), `stroke` in
    # the ring itself, `ambient` outside -- same three-colour shape
    # `rounded_box`'s border already has, just circular. `border_w` here
    # means "ring width", exactly like it means "border width" on
    # `rounded_box`.
    pub def circle_ring(cx: int, cy: int, r: int, ring_w: int, fill: int, ring: int, ambient: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_circle_ring()
        c.x = cx
        c.y = cy
        c.w = 0
        c.h = 0
        c.radius = r
        c.border_w = ring_w
        c.fill = fill
        c.stroke = ring
        c.ambient = ambient
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = []
        return c

    pub def gradient_rect(x: int, y: int, w: int, h: int, radius: int, color_a: int, color_b: int, dir: int, ambient: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_gradient_rect()
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.radius = radius
        c.border_w = dir
        c.fill = color_a
        c.stroke = color_b
        c.ambient = ambient
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = []
        return c

    pub def arc_ring(cx: int, cy: int, r: int, ring_w: int, start_deg: int, sweep_deg: int, active: int, track: int, ambient: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_arc_ring()
        c.x = cx
        c.y = cy
        c.w = start_deg
        c.h = sweep_deg
        c.radius = r
        c.border_w = ring_w
        c.fill = active
        c.stroke = track
        c.ambient = ambient
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = []
        return c

    pub def clip_push(x: int, y: int, w: int, h: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_clip_push()
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.radius = 0
        c.border_w = 0
        c.fill = 0
        c.stroke = 0
        c.ambient = 0
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = []
        return c

    pub def clip_pop() -> Cmd:
        mut c = Cmd()
        c.kind = cmd_clip_pop()
        c.x = 0
        c.y = 0
        c.w = 0
        c.h = 0
        c.radius = 0
        c.border_w = 0
        c.fill = 0
        c.stroke = 0
        c.ambient = 0
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = []
        return c

    pub def label(x: int, y: int, text: str, fg: int, ambient: int, font_size: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_text()
        c.x = x
        c.y = y
        c.w = 0
        c.h = 0
        c.radius = 0
        c.border_w = 0
        c.fill = fg
        c.stroke = 0
        c.ambient = ambient
        c.alpha = 255
        c.text = text
        c.font_size = font_size
        c.pixels = []
        return c

    # `x/y/w/h` are the DESTINATION rect (wherever layout/Style put this
    # node, at whatever size a `w-N h-N` token asked for); `src_w`/`src_h`
    # (reusing `radius`/`border_w`, unused by every other image field) are
    # the BAKED buffer's OWN pixel dimensions -- `pixels` is exactly
    # scripts/bake-image.ps1's own `<name>_pixels()` output, src_w*src_h*4
    # bytes long. These are deliberately TWO separate sizes: an author's
    # `w-N h-N` almost never matches the source image's real aspect ratio
    # exactly, so a renderer needs both to scale correctly instead of
    # assuming pixels.length matches the destination rect (confirmed the
    # hard way -- the web renderer's `new ImageData(bytes, w, h)` throws
    # IndexSizeError the instant the two sizes disagree).
    # `tint`: -1 (unset()) paints the baked RGB as-is (a photo/hero image
    # -- tinting it would corrupt real colors an author never asked to
    # change). Any other value RECOLORS every pixel the baked alpha
    # covers to that flat color, alpha unchanged -- the `<image>` side of
    # the SAME "colored like text" convention `<icon>` already
    # established (see toolkit/ui/widget_tags.tr's `tint` token, an
    # explicit author opt-in -- there is no way to tell "a photo" and "a
    # monochrome icon someone downloaded" apart from the baked pixels
    # alone, so this is never automatic). Reuses `stroke`, unused by
    # every other cmd_image() field, the same way `radius`/`border_w`
    # already carry src_w/src_h here.
    pub def image(x: int, y: int, w: int, h: int, src_w: int, src_h: int, pixels: List[u8], ambient: int, tint: int) -> Cmd:
        mut c = Cmd()
        c.kind = cmd_image()
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.radius = src_w
        c.border_w = src_h
        c.fill = 0
        c.stroke = tint
        c.ambient = ambient
        c.text = ""
        c.alpha = 255
        c.font_size = 1
        c.pixels = pixels
        return c

pub class Scene:
    pub cmds: List[Cmd]

extend Scene:
    pub def init() -> Scene:
        mut s = Scene()
        s.cmds = []
        return s

    pub def add(self, c: Cmd) -> void:
        self.cmds.append(c)

    pub def len(self) -> int:
        return len(self.cmds)

# Field-by-field equality (proposal v4 step I: diffing). Pure data comparison,
# same charter as the rest of this file -- no rasterizer knowledge needed to
# tell whether two commands would paint the same pixels. `pixels` is
# deliberately NOT compared: a baked image's bytes never change at runtime
# (they come straight out of a generated `pub def <name>_pixels()`), so kind
# + position + size already fully determine whether two cmd_image()s paint
# the same thing -- comparing w*h*4 bytes every frame would defeat the
# point of diffing being cheap.
pub def cmd_eq(a: Cmd, b: Cmd) -> bool:
    if a.kind != b.kind: return false
    if a.x != b.x or a.y != b.y or a.w != b.w or a.h != b.h: return false
    if a.radius != b.radius or a.border_w != b.border_w: return false
    if a.fill != b.fill or a.stroke != b.stroke or a.ambient != b.ambient: return false
    if a.alpha != b.alpha or a.font_size != b.font_size: return false
    if a.text != b.text: return false
    return true

# True when `prev` and `curr` have the same command COUNT, so they can be
# compared position-by-position (the tree shape didn't change between
# frames -- same node count in, same command count out, since emit() is a
# deterministic walk of the same tree structure). A count mismatch means a
# conditional part of the tree grew or shrank; the caller should fall back
# to a full repaint rather than compare mismatched positions.
pub def scenes_diffable(prev: Scene, curr: Scene) -> bool:
    return len(prev.cmds) == len(curr.cmds)

# True if any command in the scene is a clip push/pop. execute_diff falls
# back to a full repaint whenever this is true, the same "always correct,
# just not optimized for that one frame" policy render_diff already uses
# for a shape change -- see its own comment. A clipped command's on-screen
# pixels depend on EVERY enclosing push's rect, not just its own unchanged
# fields, so position-by-position cmd_eq alone cannot tell whether a
# command that looks identical is still clipped the same way; skipping the
# repaint of an unchanged-looking command whose clip rect actually moved
# would leave stale pixels outside the new clip. Diffing clipped subtrees
# correctly is a real, separate feature (clip-aware diffing), not attempted
# here -- this only guarantees correctness, not the diffing speedup, for
# any frame that uses clip.
pub def scene_has_clip(s: Scene) -> bool:
    mut i = 0
    while i < len(s.cmds):
        mut k = s.cmds[i].kind
        if k == cmd_clip_push() or k == cmd_clip_pop():
            return true
        i = i + 1
    return false
