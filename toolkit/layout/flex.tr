# toolkit.layout.flex — a deliberately small flexbox subset.
#
# Supported: row/column direction, per-side padding and margins, per-axis gap,
# fixed / fractional (w-1/2, w-full) width and height, a single-flag `grow`
# that splits leftover main-axis space evenly, main-axis `justify-*` (start,
# center, end, between, around, evenly) and cross-axis `items-*` alignment.
# Not supported, on purpose: wrap, shrink, absolute positioning.
#
# Alignment stopped being optional the moment the toolkit had buttons: a
# `<button>` wrapping a `<text>` put its label hard against the top-left
# corner, which reads as broken next to any real UI, and no combination of
# padding fixes it because the label's own size varies with its content.
# `justify-center items-center` on the button is the whole fix.
#
# Three passes, in the order layout engines always want:
#   build   — UiNode tree -> LayoutBox tree, resolving each class string once
#   measure — bottom-up intrinsic sizing
#   place   — top-down positioning and grow distribution

from toolkit.ui.ast import UiNode, read_node, max_depth
from toolkit.ui.style import Style, StyleCache, dir_col, dir_grid, unset
from toolkit.ui.widget_tags import tag_checkbox, tag_switch, tag_radio, tag_slider, tag_progress, tag_dial, tag_icon, tag_textinput, tag_image
from toolkit.ui.style import align_stretch, align_center, align_end, align_between
from toolkit.ui.style import align_around, align_evenly
from toolkit.ui.style import font_size_sm, font_size_lg
from toolkit.text.font_data import font_cell_w, font_cell_h
from toolkit.text.font_data_sm import font_sm_cell_w, font_sm_cell_h
from toolkit.text.font_data_lg import font_lg_cell_w, font_lg_cell_h
from string.str import Str

# The real baked-font cell size (toolkit/text/font_data*.tr, generated by
# scripts/bake-font.ps1). These two functions used to return a hardcoded
# placeholder (6x10) before real glyph rendering existed; every call site in
# this file was already written against "the glyph cell size" as a concept
# rather than the literal numbers, so wiring them to the real font here is
# the only change needed for layout to match what toolkit.ui.interp actually
# paints.
#
# nebula1.0 Phase 2 (multi-size fonts): `size` is the SAME font_size_sm()/
# _base()/_lg() convention toolkit.ui.style.Style.font_size and toolkit.text.
# font.Font.load_size() use -- a text node's own measured size must pick the
# SAME atlas its paint will use, or layout and painting disagree about how
# wide/tall a line of text is (text painted wider than the box it was
# measured into, or a gap left where layout expected a taller line than what
# actually got drawn).
pub def glyph_w(size: int) -> int:
    if size == font_size_sm():
        return font_sm_cell_w()
    if size == font_size_lg():
        return font_lg_cell_w()
    return font_cell_w()

pub def glyph_h(size: int) -> int:
    if size == font_size_sm():
        return font_sm_cell_h()
    if size == font_size_lg():
        return font_lg_cell_h()
    return font_cell_h()

pub def kind_element() -> int:
    return 0

pub def kind_text() -> int:
    return 1

pub class LayoutBox:
    pub kind:     int
    pub tag:      str
    pub text:     str
    pub event_name: str
    pub handler:  str
    pub style:    Style
    pub x:        int
    pub y:        int
    pub w:        int
    pub h:        int
    pub children: List[LayoutBox]
    # Proposal v4 step F: a key stable across frames for the SAME logical
    # node, so per-node state (checked, scroll offset, animation progress)
    # can be looked up again after the tree is rebuilt from scratch next
    # frame. Set by build() -- see its own comment for how. Empty only for
    # a LayoutBox nothing ever assigned one to (there is no such path today,
    # but treat "" as "no identity" rather than a valid key, the same
    # "malformed input degrades safely" policy the rest of this file uses).
    pub node_key: str
    # Markup-tag widgets (phase 1): parsed ONCE in build() from the SAME
    # class string `style` was resolved from (toolkit.ui.style.StyleCache.
    # resolve_widget(), cached the same way `resolve()` already caches
    # `Style`) -- see toolkit/ui/widget_tags.tr's own header for why this is
    # a second, independent parse rather than fields on `Style`. Meaningless
    # (left at their defaults) on any box whose `tag` isn't one of the five
    # widget tags; `emit()`'s per-tag branches are the only readers.
    pub w_checked:  bool
    pub w_selected: bool
    pub w_group:    str
    pub w_min:      int
    pub w_max:      int
    pub w_value:    int
    pub w_name:     str
    pub w_sel_bg:   int
    pub w_sel_bg2:  int
    pub w_placeholder: str

extend LayoutBox:
    pub def init(kind: int, tag: str, text: str, event_name: str, handler: str, style: Style) -> LayoutBox:
        mut b = LayoutBox()
        b.kind = kind
        b.tag = tag
        b.text = text
        b.event_name = event_name
        b.handler = handler
        b.style = style
        b.x = 0
        b.y = 0
        b.w = 0
        b.h = 0
        b.children = []
        b.node_key = ""
        b.w_checked = false
        b.w_selected = false
        b.w_group = ""
        b.w_min = 0
        b.w_max = 100
        b.w_value = 0
        b.w_name = ""
        b.w_sel_bg = unset()
        b.w_sel_bg2 = unset()
        b.w_placeholder = ""
        return b

    pub def contains(self, px: int, py: int) -> bool:
        if px < self.x:
            return false
        if py < self.y:
            return false
        if px >= self.x + self.w:
            return false
        if py >= self.y + self.h:
            return false
        return true

# --- pass 1: build ---------------------------------------------------------
# Depth is bounded here rather than trusted. A tree deep enough to overflow the
# stack is a denial of service hosted and a dead machine bare-metal, and the
# parser's own clamp is not sufficient once trees can be built programmatically.

# Proposal v4 step F: `path` is this node's STRUCTURAL identity -- "0" for
# the root, "0.1" for its second child, "0.1.0" for that child's first
# child, and so on. It is purely positional, so calling build() twice on
# the SAME markup source (two frames of a static tree) assigns the SAME
# path to the same logical node both times -- that positional stability,
# not any object identity, is what "a key stable across frames" means here.
#
# A `key-<name>` token in that node's own class string overrides the
# positional path with an author-chosen name instead ("K:" + name, the
# prefix keeping it out of the plain-digit-and-dot namespace positional
# keys use, so the two schemes can never collide by accident). That is the
# escape hatch for a reordering list: position changes when an item moves,
# an explicit key does not.
pub def build(node: Pointer[UiNode], cache: StyleCache, depth: int, path: str, viewport_w: int) -> LayoutBox:
    mut n = read_node(node)
    match n:
        case UiNode.Element(tag, cls, evt, handler, kids):
            mut st = cache.resolve(cls, viewport_w)
            mut box = LayoutBox.init(kind_element(), tag, "", evt, handler, st)
            if st.key != "":
                box.node_key = "K:" + st.key
            else:
                box.node_key = path
            # Markup-tag widgets (phase 1): parse widget-config tokens from
            # the SAME class string, cached independently of `st` -- see
            # WidgetTokens' own header. Every element pays this (a cache
            # lookup, same cost `cache.resolve(cls)` above already pays),
            # not just the five widget tags, since `build()` has no cheap
            # way to know a tag is one of the five before parsing anyway --
            # harmless for an ordinary `<panel>`/`<button>`, whose class
            # string yields an all-defaults WidgetTokens nothing ever reads.
            mut wt = cache.resolve_widget(cls)
            box.w_checked = wt.checked
            box.w_selected = wt.selected
            box.w_group = wt.group
            box.w_min = wt.min
            box.w_max = wt.max
            box.w_value = wt.value
            box.w_name = wt.name
            box.w_sel_bg = wt.sel_bg
            box.w_sel_bg2 = wt.sel_bg2
            box.w_placeholder = wt.placeholder
            if depth < max_depth():
                mut i = 0
                while i < len(kids):
                    box.children.append(build(kids[i], cache, depth + 1, path + "." + i.to_str(), viewport_w))
                    i = i + 1
            return box
        case UiNode.Text(cls, value):
            mut st2 = cache.resolve(cls, viewport_w)
            mut tbox = LayoutBox.init(kind_text(), "text", value, "", "", st2)
            if st2.key != "":
                tbox.node_key = "K:" + st2.key
            else:
                tbox.node_key = path
            return tbox
        case _:
            mut ubox = LayoutBox.init(kind_element(), "unknown", "", "", "", Style.default())
            ubox.node_key = path
            return ubox

# --- pass 2: measure -------------------------------------------------------
#
# Bottom-up intrinsic sizing. A child's MARGINS count toward its parent's
# content size (that is what makes m-4 push a parent wider rather than
# silently overlapping a sibling), but a child sized as a FRACTION of its
# parent contributes nothing -- its size is not known until the parent's own
# size is, which is a pass later. That matches CSS, where a percentage width
# does not feed back into its container's intrinsic width.

# Main-axis extent of a child including its margins, for direction is_col.
def outer_main(c: LayoutBox, is_col: bool) -> int:
    if is_col:
        return c.h + c.style.mar_t + c.style.mar_b
    return c.w + c.style.mar_l + c.style.mar_r

def outer_cross(c: LayoutBox, is_col: bool) -> int:
    if is_col:
        return c.w + c.style.mar_l + c.style.mar_r
    return c.h + c.style.mar_t + c.style.mar_b

# The gap that applies along a box's own main axis. Gap is stored per axis
# (gap-x-* / gap-y-*) so one class string can serve both a row and a column,
# but only the matching one is ever read.
def main_gap(box: LayoutBox) -> int:
    if box.style.dir == dir_col():
        return box.style.gap_y
    return box.style.gap_x

# Intrinsic default size for a markup-tag widget with no explicit w-/h-
# override -- same override rule kind_text() uses just below (an explicit
# style still wins), so `<checkbox "w-8 h-8"/>` sizes up exactly like every
# other markup element already lets an author override intrinsic sizing.
# checkbox/radio/switch are small fixed-size controls almost always used at
# one natural size, so BOTH dimensions default; slider/progress default only
# their HEIGHT (a sensible row height even with no h- token) and leave WIDTH
# at 0, same as a plain `<panel>` with no w- token -- an author sizes a
# slider's width the same way they'd size anything else (`grow`, `w-full`,
# `w-[300px]`), not via hidden widget-specific magic.
def widget_intrinsic_w(tag: str) -> int:
    if tag == tag_checkbox(): return 20
    if tag == tag_radio(): return 18
    if tag == tag_switch(): return 48
    # dial is a small fixed-size radial control, same "both dimensions
    # default" reasoning as checkbox/radio/switch just above -- see this
    # function's own header comment.
    if tag == tag_dial(): return 96
    if tag == tag_icon(): return 24
    # A baked image's REAL size lives in its own generated `<name>_w()`/
    # `_h()` (see toolkit.ui.widget_tags' tag_image() comment) which this
    # file has no access to -- an author almost always sizes `<image>`
    # explicitly with `w-N h-N` anyway (to control on-screen scale, not
    # just to satisfy layout), same as `icon` already expects; this is only
    # the no-token fallback, matching icon's own default.
    if tag == tag_image(): return 48
    return 0

def widget_intrinsic_h(tag: str) -> int:
    if tag == tag_checkbox(): return 20
    if tag == tag_radio(): return 18
    if tag == tag_switch(): return 26
    if tag == tag_slider(): return 24
    if tag == tag_progress(): return 10
    if tag == tag_dial(): return 96
    if tag == tag_icon(): return 24
    # textinput: height-only default (a sensible row height), same
    # "leave WIDTH at 0" reasoning as slider/progress above -- an author
    # sizes it with `grow`/`w-full` like anything else.
    if tag == tag_textinput(): return 36
    if tag == tag_image(): return 48
    return 0

def is_measured_widget_tag(tag: str) -> bool:
    if tag == tag_checkbox(): return true
    if tag == tag_radio(): return true
    if tag == tag_switch(): return true
    if tag == tag_slider(): return true
    if tag == tag_progress(): return true
    if tag == tag_dial(): return true
    if tag == tag_icon(): return true
    if tag == tag_textinput(): return true
    if tag == tag_image(): return true
    return false

pub def measure(box: LayoutBox) -> void:
    if box.kind == kind_text():
        mut tw = Str.len(box.text) * glyph_w(box.style.font_size)
        mut th = glyph_h(box.style.font_size)
        if box.style.w >= 0:
            tw = box.style.w
        if box.style.h >= 0:
            th = box.style.h
        box.w = tw
        box.h = th
        return

    if is_measured_widget_tag(box.tag):
        mut ww = widget_intrinsic_w(box.tag)
        mut wh = widget_intrinsic_h(box.tag)
        if box.style.w >= 0:
            ww = box.style.w
        if box.style.h >= 0:
            wh = box.style.h
        box.w = ww
        box.h = wh
        return

    mut i = 0
    while i < len(box.children):
        measure(box.children[i])
        i = i + 1

    # Proposal v4 step E: a grid container sizes itself by a different rule
    # (row-major wrap into N equal columns) than flex's single-axis main/
    # cross model below, so it gets its own function -- called here, kept
    # separate rather than inlined for the same __chkstk reason
    # toolkit.ui.style splits its token families (see that file's own note).
    if box.style.dir == dir_grid():
        measure_grid(box)
        return

    mut gap = main_gap(box)
    mut nkids = len(box.children)
    mut is_col = box.style.dir == dir_col()

    mut main = 0
    mut cross = 0
    mut j = 0
    while j < nkids:
        mut c = box.children[j]
        main = main + outer_main(c, is_col)
        mut oc = outer_cross(c, is_col)
        if oc > cross:
            cross = oc
        j = j + 1

    if nkids > 1:
        main = main + gap * (nkids - 1)

    mut content_w = cross
    mut content_h = main
    if not is_col:
        content_w = main
        content_h = cross

    if box.style.w >= 0:
        box.w = box.style.w
    else:
        box.w = content_w + box.style.pad_l + box.style.pad_r

    if box.style.h >= 0:
        box.h = box.style.h
    else:
        box.h = content_h + box.style.pad_t + box.style.pad_b

def measure_grid(box: LayoutBox) -> void:
    mut cols = box.style.grid_cols
    if cols < 1:
        cols = 1
    mut nkids = len(box.children)
    mut gap_x = box.style.gap_x
    mut gap_y = box.style.gap_y

    mut max_child_w = 0
    mut i = 0
    while i < nkids:
        mut c = box.children[i]
        if c.w > max_child_w:
            max_child_w = c.w
        i = i + 1
    mut content_w = max_child_w * cols
    if cols > 1:
        content_w = content_w + gap_x * (cols - 1)

    mut nrows = 0
    if nkids > 0:
        nrows = (nkids + cols - 1) / cols
    mut content_h = 0
    mut row = 0
    while row < nrows:
        mut row_h = 0
        mut ci = row * cols
        mut cend = ci + cols
        if cend > nkids:
            cend = nkids
        while ci < cend:
            mut cc = box.children[ci]
            if cc.h > row_h:
                row_h = cc.h
            ci = ci + 1
        content_h = content_h + row_h
        row = row + 1
    if nrows > 1:
        content_h = content_h + gap_y * (nrows - 1)

    if box.style.w >= 0:
        box.w = box.style.w
    else:
        box.w = content_w + box.style.pad_l + box.style.pad_r

    if box.style.h >= 0:
        box.h = box.style.h
    else:
        box.h = content_h + box.style.pad_t + box.style.pad_b

# box.x/box.y are already set by place() before it dispatches here.
def place_grid(box: LayoutBox) -> void:
    mut nkids = len(box.children)
    mut cols = box.style.grid_cols
    if cols < 1:
        cols = 1
    mut gap_x = box.style.gap_x
    mut gap_y = box.style.gap_y

    mut inner_w = box.w - box.style.pad_l - box.style.pad_r
    mut track_w = inner_w
    if cols > 1:
        track_w = (inner_w - gap_x * (cols - 1)) / cols

    mut nrows = 0
    if nkids > 0:
        nrows = (nkids + cols - 1) / cols

    mut cursor_y = box.y + box.style.pad_t
    mut row = 0
    while row < nrows:
        mut ci = row * cols
        mut cend = ci + cols
        if cend > nkids:
            cend = nkids

        mut row_h = 0
        mut ri = ci
        while ri < cend:
            mut rc = box.children[ri]
            if rc.h > row_h:
                row_h = rc.h
            ri = ri + 1

        mut cursor_x = box.x + box.style.pad_l
        while ci < cend:
            mut c = box.children[ci]
            c.w = track_w
            place(c, cursor_x, cursor_y)
            cursor_x = cursor_x + track_w + gap_x
            ci = ci + 1
        cursor_y = cursor_y + row_h + gap_y
        row = row + 1

# --- pass 3: place ---------------------------------------------------------

pub def place(box: LayoutBox, x: int, y: int) -> void:
    box.x = x
    box.y = y

    mut nkids = len(box.children)
    if nkids == 0:
        return

    # Proposal v4 step E: same reason as measure()'s own dispatch above.
    if box.style.dir == dir_grid():
        place_grid(box)
        return

    mut gap = main_gap(box)
    mut is_col = box.style.dir == dir_col()

    # The content box: what is left of this box after its own padding.
    # Everything below positions and sizes children inside this rectangle.
    mut inner_w = box.w - box.style.pad_l - box.style.pad_r
    mut inner_h = box.h - box.style.pad_t - box.style.pad_b
    mut inner_main = inner_w
    mut inner_cross = inner_h
    if is_col:
        inner_main = inner_h
        inner_cross = inner_w

    # Fractional sizes resolve here, against the content box, and before any
    # of the arithmetic below reads a child size. Kept as num/den rather than
    # a percentage so w-1/3 of 300px is exactly 100px -- see toolkit.ui.scale
    # on why three 33% children fail to fill a row.
    mut f = 0
    while f < nkids:
        mut cf = box.children[f]
        if cf.style.w_den > 0:
            cf.w = inner_w * cf.style.w_num / cf.style.w_den
        if cf.style.h_den > 0:
            cf.h = inner_h * cf.style.h_num / cf.style.h_den
        f = f + 1

    mut used = 0
    mut growers = 0
    mut i = 0
    while i < nkids:
        mut c = box.children[i]
        used = used + outer_main(c, is_col)
        if c.style.grow > 0:
            growers = growers + 1
        i = i + 1

    if nkids > 1:
        used = used + gap * (nkids - 1)

    mut extra = 0
    if growers > 0:
        if inner_main > used:
            extra = (inner_main - used) / growers

    # Main-axis distribution. grow and justify answer the same question --
    # what happens to leftover main-axis space -- so a box with any growing
    # child has no leftover space to distribute and justify becomes a no-op
    # there. That mirrors real flexbox and means the two features never fight.
    mut slack = inner_main - used
    if slack < 0:
        slack = 0
    if growers > 0:
        slack = 0

    # lead is space before the first child; spread is extra space added after
    # each child on top of the gap. The distributed modes differ only in how
    # they split slack between those two.
    mut lead = 0
    mut spread = 0
    if box.style.justify == align_center():
        lead = slack / 2
    elif box.style.justify == align_end():
        lead = slack
    elif box.style.justify == align_between():
        # First child flush to the start, last flush to the end. With one
        # child there is no gap to put anything in, so it stays at the start.
        if nkids > 1:
            spread = slack / (nkids - 1)
    elif box.style.justify == align_around():
        # Each child gets equal space on both sides, so the outer edges get
        # half of what sits between any two children.
        spread = slack / nkids
        lead = spread / 2
    elif box.style.justify == align_evenly():
        # Every space -- both edges and every gap between children -- is the
        # same size, so there are nkids+1 of them.
        spread = slack / (nkids + 1)
        lead = spread

    mut cursor_x = box.x + box.style.pad_l
    mut cursor_y = box.y + box.style.pad_t
    if is_col:
        cursor_y = cursor_y + lead
    else:
        cursor_x = cursor_x + lead

    mut k = 0
    while k < nkids:
        mut c2 = box.children[k]

        if c2.style.grow > 0:
            if is_col:
                c2.h = c2.h + extra
            else:
                c2.w = c2.w + extra

        # Cross-axis sizing and offset. Stretch (the default) grows a child
        # with no explicit cross size to fill the content box, which leaves
        # nothing to align; every other mode leaves the child at its measured
        # cross size and shifts it within the leftover room instead. A
        # stretched child cross margins eat into what it fills.
        mut cross_off = 0
        if box.style.align == align_stretch():
            if is_col:
                if c2.style.w < 0 and c2.style.w_den <= 0:
                    c2.w = inner_w - c2.style.mar_l - c2.style.mar_r
            else:
                if c2.style.h < 0 and c2.style.h_den <= 0:
                    c2.h = inner_h - c2.style.mar_t - c2.style.mar_b
        else:
            mut cross_slack = inner_cross - outer_cross(c2, is_col)
            if cross_slack < 0:
                cross_slack = 0
            if box.style.align == align_center():
                cross_off = cross_slack / 2
            elif box.style.align == align_end():
                cross_off = cross_slack

        if is_col:
            place(c2, cursor_x + cross_off + c2.style.mar_l, cursor_y + c2.style.mar_t)
            cursor_y = cursor_y + outer_main(c2, is_col) + gap + spread
        else:
            place(c2, cursor_x + c2.style.mar_l, cursor_y + cross_off + c2.style.mar_t)
            cursor_x = cursor_x + outer_main(c2, is_col) + gap + spread
        k = k + 1

pub def layout_tree(node: Pointer[UiNode], cache: StyleCache, vw: int, vh: int) -> LayoutBox:
    return layout_tree_at(node, cache, 0, 0, vw, vh)

# The same pipeline, but into a SUB-RECTANGLE of the canvas rather than the
# whole of it.
#
# This is the entire fix for a limitation that has shaped every widget demo in
# the repo: layout_tree always sized its root to the full canvas, so a second
# render call repainted the whole surface and erased the chrome already drawn.
# Both examples/widgets_demo and examples/uefi_demo/render_widgets.tr work
# around it by host-painting their tab content with raw primitives rather than
# writing it as markup.
#
# It needs no new machinery: place() has always taken an origin, and
# layout_tree simply passed (0, 0). Sizing the root to the sub-rect and
# placing it there gives boxes with correct ABSOLUTE coordinates -- which
# matters because hit-testing walks this same tree, so shifting the painted
# output afterwards instead would have left dispatch() testing the wrong space.
pub def layout_tree_at(node: Pointer[UiNode], cache: StyleCache, x: int, y: int, vw: int, vh: int) -> LayoutBox:
    mut root = build(node, cache, 0, "0", vw)
    measure(root)
    # The root fills the given box unless it asked for a specific size.
    if root.style.w < 0:
        root.w = vw
    if root.style.h < 0:
        root.h = vh
    place(root, x, y)
    return root

pub def dump_layout(box: LayoutBox, indent: int) -> void:
    mut pad = ""
    mut i = 0
    while i < indent:
        pad = pad + "  "
        i = i + 1
    mut label = box.tag
    if box.kind == kind_text():
        label = "text \"" + box.text + "\""
    print(pad + label + " @(" + box.x.to_str() + "," + box.y.to_str() + ") " + box.w.to_str() + "x" + box.h.to_str())
    mut j = 0
    while j < len(box.children):
        dump_layout(box.children[j], indent + 1)
        j = j + 1
