# toolkit.ui.interp — the tree-walking interpreter and the host bridge.
#
# This is where "declarative, interpreted at runtime" stops being a design note
# and becomes code: a UiNode tree plus a style cache in, painted pixels and
# dispatched events out, with no compiler involved in anything the UI author
# wrote.
#
# The handler table is an ALLOWLIST, and that is a security property rather than
# a convenience. UI content names a handler as a string; if that string is not a
# key someone deliberately registered, nothing happens. There is deliberately no
# path from a name in a UI file to an arbitrary function in the host.

from toolkit.types import Event, EventHandler, event_name_for_kind, ev_key, rgb, red_of, green_of, blue_of
from toolkit.ui.ast import UiNode, max_depth
from toolkit.ui.style import StyleCache, unset
from toolkit.layout.flex import LayoutBox, layout_tree, kind_text
from toolkit.render.canvas import Canvas
from toolkit.text.font import Font
from string.str import Str

# One entry in the handler allowlist: a name UI content may reference, and the
# host object it resolves to.
pub class HandlerSlot:
    pub name: str
    pub h:    EventHandler

pub class Interpreter:
    pub cache:    StyleCache
    pub font:     Font
    pub handlers: List[HandlerSlot]
    pub root:     LayoutBox
    pub has_root: bool
    pub renders:  int
    # Native-like button feedback: any box with a non-empty event_name (i.e.
    # anything a UI author wired to `@on_click(...)`) darkens on hover, darker
    # still while pressed -- callers set these from their own per-frame input
    # state (SDL2's polled mouse position, UEFI's tauraro_uefi_frame args, ...)
    # before calling render(); left at (-1,-1)/false, nothing is ever "hot".
    pub hover_x:  int
    pub hover_y:  int
    pub pressed:  bool

extend Interpreter:
    pub def init() -> Interpreter:
        mut it = Interpreter()
        it.cache = StyleCache.init()
        it.font = Font.load()
        it.handlers = []
        it.has_root = false
        it.renders = 0
        it.hover_x = 0 - 1
        it.hover_y = 0 - 1
        it.pressed = false
        return it

    # Takes an already-interface-typed handler; callers should go through the
    # free function register_handler() below so the upcast happens without a move.
    pub def add_slot(self, name: str, h: EventHandler) -> void:
        mut slot = HandlerSlot()
        slot.name = name
        slot.h = h
        self.handlers.append(slot)

    pub def is_registered(self, name: str) -> bool:
        mut i = 0
        while i < len(self.handlers):
            if self.handlers[i].name == name:
                return true
            i = i + 1
        return false

    # Walk the tree, lay it out against the canvas viewport, and paint it.
    # Re-running this on a new tree is the whole live-reload story: no rebuild,
    # no restart, and the style cache survives across reloads.
    pub def render(self, node: Pointer[UiNode], c: Canvas) -> void:
        # Assign first, then paint through the field. Assigning to self.root
        # MOVES the local, and touching it afterwards is [M-1].
        self.root = layout_tree(node, self.cache, c.width(), c.height())
        self.has_root = true
        self.renders = self.renders + 1
        self.paint(self.root, c)

    def paint(self, box: LayoutBox, c: Canvas) -> void:
        # Native-like hover/pressed feedback: only for boxes an author wired
        # to an event (event_name != "") -- a plain decorative panel never
        # darkens just because the cursor happens to be over it.
        mut is_hot = box.event_name != "" and box.contains(self.hover_x, self.hover_y)
        mut bg = box.style.bg
        mut border = box.style.border
        if is_hot:
            mut pct = 15
            if self.pressed:
                pct = 30
            if bg != unset():
                bg = darken_color(bg, pct)
            if border != unset():
                border = darken_color(border, pct)

        mut has_border = border != unset() and box.style.border_w > 0
        if has_border:
            # Outline via two nested fills, not a stroke primitive: Canvas only
            # exposes fill_rect/set_pixel (see toolkit/render/canvas.tr -- kept
            # deliberately minimal so every backend, including the bare-metal
            # and UEFI framebuffer ones, implements the same four methods).
            # Paint the full box in the border color, then paint an inset
            # box (by border_w on every side) in the background color on top,
            # leaving exactly a border_w-wide ring visible.
            paint_rounded_rect(c, box.x, box.y, box.w, box.h, box.style.radius, border)
            if bg != unset():
                mut bw = box.style.border_w
                mut inner_r = box.style.radius - bw
                if inner_r < 0:
                    inner_r = 0
                mut iw = box.w - bw * 2
                mut ih = box.h - bw * 2
                if iw > 0 and ih > 0:
                    paint_rounded_rect(c, box.x + bw, box.y + bw, iw, ih, inner_r, bg)
        elif bg != unset():
            paint_rounded_rect(c, box.x, box.y, box.w, box.h, box.style.radius, bg)

        if box.kind == kind_text():
            self.paint_text(box, c)

        mut i = 0
        while i < len(box.children):
            self.paint(box.children[i], c)
            i = i + 1

    # (paint_rounded_rect / paint_corner are free functions below -- see their
    # own comments for why: Canvas has no fill-rounded-rect or circle
    # primitive, deliberately, so this stays plain fill_rect/set_pixel calls
    # a method can make just as easily as a free function could; they're
    # free functions purely to sit next to hit_test/find_handler_by_event,
    # the toolkit's other tree/paint free functions, not because of the
    # method-vs-free-function recursion gotcha those two have (this isn't
    # recursive).

    # Real glyph painting from the baked bitmap font (toolkit/text/), one
    # pixel at a time via Canvas.set_pixel -- an irregular glyph shape has no
    # rectangle decomposition worth the bookkeeping at this cell size. Layout
    # already reserves exactly `font.cell_w() x font.cell_h()` per character
    # (toolkit.layout.flex's glyph_w()/glyph_h() are wired to the same baked
    # font data), so glyph positions here match where layout placed them with
    # no separate metrics to keep in sync.
    def paint_text(self, box: LayoutBox, c: Canvas) -> void:
        mut cw = self.font.cell_w()
        mut ch = self.font.cell_h()
        mut n = Str.len(box.text)
        mut i = 0
        while i < n:
            mut codepoint = Str.char_at(box.text, i)
            mut col = 0
            while col < cw:
                mut row = 0
                while row < ch:
                    if self.font.pixel_set(codepoint, col, row):
                        c.set_pixel(box.x + i * cw + col, box.y + row, box.style.fg)
                    row = row + 1
                col = col + 1
            i = i + 1

    # --- events ----------------------------------------------------------

    # Returns true only when a registered handler actually ran.
    pub def dispatch(self, e: Event) -> bool:
        if not self.has_root:
            return false

        mut wanted = event_name_for_kind(e.kind)
        if wanted == "":
            return false

        # Key events have no (x,y) to hit-test against -- Event.key() sets
        # both to 0, and hit-testing at literal pixel (0,0) would only ever
        # match whatever happens to sit in the top-left corner, not "the
        # thing that wants keyboard input". Dispatch by tree scan instead:
        # the first node anywhere in the tree with `@on_key(...)` wins, a
        # global (focus-less) listener rather than per-widget focus tracking
        # -- enough for the toolkit's current single-active-handler demos,
        # and matches how the allowlist itself has no concept of "the
        # currently focused widget" either.
        mut name = ""
        if e.kind == ev_key():
            name = find_handler_by_event(self.root, 0, wanted)
        else:
            name = hit_test(self.root, e.x, e.y, 0, wanted)
        if name == "":
            return false

        # Linear scan of the allowlist. A handful of handlers makes a hash
        # table pointless, and a name with no slot is ignored on purpose.
        mut i = 0
        while i < len(self.handlers):
            mut slot = self.handlers[i]
            if slot.name == name:
                slot.h.handle(e)
                return true
            i = i + 1
        return false

    pub def stats(self) -> str:
        return "Interpreter(renders=" + self.renders.to_str() + " handlers=" + len(self.handlers).to_str() + ") " + self.cache.stats()

# Scales each channel down by pct% -- used for hover/pressed feedback
# (Interpreter.paint). Integer math only (no float channel needed for a
# handful of discrete darken levels), consistent with toolkit.types packing
# color as a plain 0xRRGGBB int rather than a class.
def darken_color(color: int, pct: int) -> int:
    mut r = red_of(color) * (100 - pct) / 100
    mut g = green_of(color) * (100 - pct) / 100
    mut b = blue_of(color) * (100 - pct) / 100
    return rgb(r, g, b)

# A rounded rect, built from three plain fills (the straight edges) and four
# per-pixel quarter-circles (the corners) -- Canvas has no fill-rounded-rect
# or circle primitive (see Interpreter.paint's comment for why: fill_rect/
# set_pixel only, so every backend -- hosted, SDL2, Cortex-M framebuffer,
# UEFI GOP -- stays this simple and gets rounded corners for free with no
# backend-specific code). `radius<=0` (or too big for the box) clamps to a
# plain fill_rect, so this is a strict superset of the old square-corner
# behavior, not a separate cost every caller pays.
pub def paint_rounded_rect(c: Canvas, x: int, y: int, w: int, h: int, radius: int, color: int) -> void:
    if w <= 0:
        return
    if h <= 0:
        return
    mut r = radius
    if r < 0:
        r = 0
    if r * 2 > w:
        r = w / 2
    if r * 2 > h:
        r = h / 2
    if r <= 0:
        c.fill_rect(x, y, w, h, color)
        return

    c.fill_rect(x, y + r, w, h - r * 2, color)
    c.fill_rect(x + r, y, w - r * 2, r, color)
    c.fill_rect(x + r, y + h - r, w - r * 2, r, color)

    paint_corner(c, x, y, r, color, true, true)
    paint_corner(c, x + w - r, y, r, color, false, true)
    paint_corner(c, x, y + h - r, r, color, true, false)
    paint_corner(c, x + w - r, y + h - r, r, color, false, false)

# Fills the quarter-circle within an r x r square anchored at (ax,ay) (the
# square's top-left pixel, one of the four corner squares a rounded rect's
# straight fills leave uncovered). `inner_right`/`inner_bottom` say which
# edge of THIS square borders the box's already-filled straight interior
# (true) vs. the box's own outer corner (false) -- that is where the circle
# center sits, in local square coordinates: (r,r) if both true (top-left
# corner of the box), (0,r)/(r,0)/(0,0) for the other three. A pixel near
# the outer-corner side is farther from that center and gets rounded off;
# a pixel near the inner side is within radius and stays filled, connecting
# smoothly to the straight edges either side of it.
def paint_corner(c: Canvas, ax: int, ay: int, r: int, color: int, inner_right: bool, inner_bottom: bool) -> void:
    mut center_x = 0
    if inner_right:
        center_x = r
    mut center_y = 0
    if inner_bottom:
        center_y = r
    mut yy = 0
    while yy < r:
        mut xx = 0
        while xx < r:
            mut dx = xx - center_x
            mut dy = yy - center_y
            if dx * dx + dy * dy <= r * r:
                c.set_pixel(ax + xx, ay + yy, color)
            xx = xx + 1
        yy = yy + 1

# Deepest-first hit test: the innermost box containing the point that names a
# handler wins, which is what makes a button inside a panel behave.
#
# A FREE FUNCTION, not a method, and that is load-bearing rather than stylistic.
# As a private recursive method returning str this hangs under --freestanding on
# Cortex-M -- it runs correctly hosted, and the byte-identical logic as a free
# function runs correctly on both. (Interpreter.paint is also private and
# recursive but returns void, and is fine, so the trigger appears to be the
# string return rather than the recursion alone.) Verified under
# qemu-system-arm -M mps2-an385.
#
# Depth-bounded: a bare metal stack is a few KB, and a malformed tree must
# degrade to a wrong answer rather than run off the end of it.
pub def hit_test(box: LayoutBox, x: int, y: int, depth: int, wanted_event: str) -> str:
    if depth > max_depth():
        return ""
    if not box.contains(x, y):
        return ""
    mut found = ""
    mut i = 0
    while i < len(box.children):
        mut r = hit_test(box.children[i], x, y, depth + 1, wanted_event)
        if r != "":
            found = r
        i = i + 1
    if found != "":
        return found
    if box.event_name != wanted_event:
        return ""
    return box.handler

# Position-free counterpart to hit_test: the first node anywhere in the tree
# (depth-first, pre-order) whose event_name matches wins -- used for event
# kinds like key input that have no (x,y) to test against. Same depth cap and
# free-function-not-method shape as hit_test, for the same reason (see its
# comment): a private recursive method returning str hangs under
# --freestanding on Cortex-M.
pub def find_handler_by_event(box: LayoutBox, depth: int, wanted_event: str) -> str:
    if depth > max_depth():
        return ""
    if box.event_name == wanted_event:
        return box.handler
    mut i = 0
    while i < len(box.children):
        mut r = find_handler_by_event(box.children[i], depth + 1, wanted_event)
        if r != "":
            return r
        i = i + 1
    return ""

# Register a host handler under the name UI content may reference.
#
# A free function because a method call does NOT auto-upcast a concrete class to
# an interface, while a free function's parameter does -- and doing the upcast
# by hand with `mut x: EventHandler = obj` would MOVE obj away from the caller.
# NB: named register_handler, not register -- `register` is a C storage-class
# keyword, and emitting it mangles the symbol and loses the interface upcast.
pub def register_handler(it: Interpreter, name: str, h: EventHandler) -> void:
    it.add_slot(name, h)

# Render a tree to a concrete canvas without giving up ownership of it.
#
# Tauraro upcasts a concrete class to an interface automatically at a free
# function's call site, but not at a method's, and writing the upcast out by
# hand (`mut view: Canvas = canvas`) MOVES the canvas -- after which the caller
# can no longer touch its own buffer to save or inspect it ([M-1]). Routing the
# upcast through a free function is what keeps the canvas usable afterwards, so
# callers should prefer this over Interpreter.render.
pub def render_to(it: Interpreter, node: Pointer[UiNode], c: Canvas) -> void:
    it.render(node, c)
