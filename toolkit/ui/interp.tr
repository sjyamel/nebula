# toolkit.ui.interp — the tree-walking interpreter and the host bridge.
#
# This is where "declarative, interpreted at runtime" stops being a design note
# and becomes code: a UiNode tree plus a style cache in, painted pixels and
# dispatched events out, with no compiler involved in anything the UI author
# wrote.
#
# The handler table is an ALLOWLIST, and that is a security property rather than
# a convenience. UI content names a handler as a string; if that string is not a
# key someone deliberately registered, nothing happens. There is deliberately no
# path from a name in a UI file to an arbitrary function in the host.

from toolkit.types import Event, EventHandler, event_name_for_kind, ev_key, rgb, red_of, green_of, blue_of
from toolkit.ui.ast import UiNode, max_depth
from toolkit.ui.style import StyleCache, unset
from toolkit.render.scene import Scene, Cmd, cmd_rounded_rect, cmd_rounded_box, cmd_text, cmd_clip_push, cmd_clip_pop, cmd_circle, cmd_circle_ring, cmd_eq, scenes_diffable, scene_has_clip
from toolkit.layout.flex import LayoutBox, layout_tree, layout_tree_at, kind_text
from toolkit.render.canvas import Canvas
from toolkit.render.clipped_canvas import clip_canvas
from toolkit.render.renderer import Renderer
from toolkit.render.software_renderer import default_renderer
from toolkit.ui.widget_tags import tag_checkbox, tag_switch, tag_radio, tag_slider, tag_progress, tag_tabitem, tag_listitem, is_widget_tag
from toolkit.text.font import Font, Fonts
from string.str import Str
from math.int import Math
from toolkit.render.gamma import srgb_to_linear, linear_to_srgb

# One entry in the handler allowlist: a name UI content may reference, and the
# host object it resolves to.
pub class HandlerSlot:
    pub name: str
    pub h:    EventHandler

pub class Interpreter:
    pub cache:    StyleCache
    # nebula1.0 Phase 2 (multi-size fonts): one Interpreter needs all THREE
    # baked atlases loaded, not just one -- a single scene routinely mixes
    # text-sm/text-base/text-lg nodes. See toolkit.text.font.Fonts.
    pub fonts:    Fonts
    pub handlers: List[HandlerSlot]
    pub root:     LayoutBox
    pub has_root: bool
    pub renders:  int
    # Proposal v4 step I (diffing): the PREVIOUS frame's scene, kept around so
    # render_diff() can skip repainting whatever didn't change. Only touched
    # by render_diff() -- render()/render_rect() never read or write these,
    # so calling render() after render_diff() (or never calling render_diff()
    # at all) behaves exactly as before.
    pub last_scene:     Scene
    pub has_last_scene: bool
    # Native-like button feedback: any box with a non-empty event_name (i.e.
    # anything a UI author wired to `@on_click(...)`) darkens on hover, darker
    # still while pressed -- callers set these from their own per-frame input
    # state (SDL2's polled mouse position, UEFI's tauraro_uefi_frame args, ...)
    # before calling render(); left at (-1,-1)/false, nothing is ever "hot".
    pub hover_x:  int
    pub hover_y:  int
    pub pressed:  bool
    # Markup-tag widgets (phase 1: checkbox/switch/radio/slider/progress):
    # a `<slider>` node dragging needs the CURRENT mouse position while the
    # button is held, the same way hover_x/hover_y already are -- set every
    # frame by the caller alongside hover_x/hover_y/pressed, before
    # render()/render_diff(). Left at (-1,-1) for a caller that never sets
    # them (every existing example): harmless, since nothing reads these
    # unless a node's own drag state (Interpreter.state, "#dragging" suffix)
    # is already active, which only a `<slider>` tag can set in the first
    # place -- see emit()'s slider branch.
    pub mouse_x:  int
    pub mouse_y:  int
    # The flat color the canvas was actually cleared to before this frame's
    # render() call -- the root of the "what's behind me" chain every panel's
    # anti-aliased edges blend against (see paint()'s own comment for the
    # full mechanism). Defaults to this project's common dark demo
    # background; set it directly if a caller clears its canvas to something
    # else, the same way each widget's own `page_bg` field works.
    pub root_bg:  int
    # Proposal v4 step F: per-node state, keyed by LayoutBox.node_key. THIS
    # is what survives a re-render -- the Interpreter itself is a long-lived
    # host object (one per screen/view, created once), unlike self.root,
    # which is thrown away and rebuilt from scratch on every render() call.
    # A plain int store rather than a variant/union: every stateful widget
    # this toolkit has today (checked, focused, scroll offset, drag-in-
    # progress) is representable as one int, and a second typed store can be
    # added later without disturbing this one if that stops being true.
    pub state:    Dict[str, int]
    # Markup-tag widgets (phase 1): the same "every widget class already has
    # one, defaulted the same way" field every host-owned widget
    # (toolkit.ui.checkbox.Checkbox etc.) already carries -- see
    # toolkit.render.software_renderer's own comment on why a concrete
    # class can't be assigned to an interface-typed field directly
    # (a real compiler gap; default_renderer() is the workaround). Reassign
    # to `gl_renderer_of(canvas)`/`canvas2d_renderer_of(canvas)` for GPU/
    # Canvas2D quality, exactly like every other widget's `.renderer` field.
    pub renderer: Renderer

extend Interpreter:
    pub def init() -> Interpreter:
        mut it = Interpreter()
        it.cache = StyleCache.init()
        it.fonts = Fonts.load()
        it.handlers = []
        it.has_root = false
        it.renders = 0
        it.last_scene = Scene.init()
        it.has_last_scene = false
        it.hover_x = 0 - 1
        it.hover_y = 0 - 1
        it.pressed = false
        it.mouse_x = 0 - 1
        it.mouse_y = 0 - 1
        it.root_bg = 0x0B1120
        it.state = {}
        it.renderer = default_renderer()
        return it

    # Proposal v4 step F: read a node's persisted state, or `default` if
    # nothing has been stored under that key yet (the first frame a widget
    # exists, or any key nothing ever wrote to). `key` is a LayoutBox's
    # `node_key` -- see toolkit.layout.flex's build() for how that is
    # derived and why it is stable across the rebuild render() does every
    # frame.
    pub def state_get(self, key: str, default: int) -> int:
        if key in self.state:
            return self.state[key]
        return default

    pub def state_set(self, key: str, val: int) -> void:
        self.state[key] = val

    # Convenience for the common boolean-toggle case (checkbox/switch
    # `checked`, expander `open`, ...): reads the current value (or
    # `default` if unset), flips between 0 and 1, stores and returns the
    # new value -- one call from an `@on_click` handler instead of a
    # get-then-set pair at every call site.
    pub def state_toggle(self, key: str, default: int) -> int:
        mut cur = self.state_get(key, default)
        mut next = 1
        if cur != 0:
            next = 0
        self.state_set(key, next)
        return next

    # Proposal v4 step G: one step of a linear animation toward `target`,
    # stored under `key` in the same state map step F added -- the exact
    # generalization of toolkit.ui.checkbox/switch.Switch.tick()'s hand-
    # rolled "step knob_pos toward target by a fixed amount per call"
    # pattern, made reusable for ANY node's ANY int-valued property instead
    # of one hardcoded field on one hand-written class. Call once per frame
    # (once per emit() call is once per frame, by construction) with the
    # same target and step; returns the new current value to paint with.
    #
    # An unset key starts already AT `target`, not at 0 -- the same choice
    # Switch.init() makes (knob_pos starts snapped to its initial on/off
    # state) so a node's first-ever frame never animates in from a bogus
    # zero value it was never actually at.
    pub def anim_toward(self, key: str, target: int, step: int) -> int:
        mut cur = self.state_get(key, target)
        if cur < target:
            cur = cur + step
            if cur > target:
                cur = target
        elif cur > target:
            cur = cur - step
            if cur < target:
                cur = target
        self.state_set(key, cur)
        return cur

    # Takes an already-interface-typed handler; callers should go through the
    # free function register_handler() below so the upcast happens without a move.
    pub def add_slot(self, name: str, h: EventHandler) -> void:
        mut slot = HandlerSlot()
        slot.name = name
        slot.h = h
        self.handlers.append(slot)

    pub def is_registered(self, name: str) -> bool:
        mut i = 0
        while i < len(self.handlers):
            if self.handlers[i].name == name:
                return true
            i = i + 1
        return false

    # Walk the tree, lay it out against the canvas viewport, and paint it.
    # Re-running this on a new tree is the whole live-reload story: no rebuild,
    # no restart, and the style cache survives across reloads.
    pub def render(self, node: Pointer[UiNode], c: Canvas) -> void:
        # Assign first, then paint through the field. Assigning to self.root
        # MOVES the local, and touching it afterwards is [M-1].
        self.root = layout_tree(node, self.cache, c.width(), c.height())
        self.has_root = true
        self.renders = self.renders + 1
        # Two passes now, not one: emit a scene, then execute it. The split
        # is invisible from here on purpose -- every Canvas backend keeps
        # working unchanged, and the scene graph stays an internal detail
        # rather than a breaking change to the four shipping tiers.
        mut scene = self.build_scene(self.root_bg)
        execute_software(scene, c, self.fonts, self.renderer)

    # Renders a tree into a SUB-RECTANGLE instead of the whole canvas.
    #
    # `ambient` is what the sub-rect is being drawn on top of -- the colour
    # its antialiased outer edges blend toward. It is a parameter rather than
    # self.root_bg because the whole point of a sub-rect is that something
    # else already painted there.
    #
    # self.root is replaced, so dispatch() hit-tests against THIS tree until
    # the next render. A caller compositing several sub-rects and wanting
    # clicks on all of them needs one Interpreter per region, or to re-render
    # the region under the pointer before dispatching -- there is one root,
    # by design, and pretending otherwise would be worse.
    pub def render_rect(self, node: Pointer[UiNode], c: Canvas, x: int, y: int, w: int, h: int, ambient: int) -> void:
        self.root = layout_tree_at(node, self.cache, x, y, w, h)
        self.has_root = true
        self.renders = self.renders + 1
        mut scene = self.build_scene(ambient)
        execute_software(scene, c, self.fonts, self.renderer)

    # Proposal v4 step I: like render(), but repaints only the commands that
    # actually changed since the last render_diff() call on this Interpreter
    # (measured as the change that helps every tier, including the ones with
    # no GPU to fall back on -- see proposal-v4-renderer-architecture.md 5a).
    #
    # A NEW method rather than a change to render()'s own behavior: skipping
    # unchanged commands is only correct if the caller ALSO stops clearing
    # the canvas every frame (a clear erases the very pixels this is meant to
    # leave alone), which is a caller-side contract change every existing
    # example/backend would need to adopt. render() stays exactly as it was
    # so nothing already shipping is at risk; render_diff() is opt-in for a
    # frame loop that clears ONCE up front and calls this every frame after.
    #
    # Falls back to a full repaint (execute_software) whenever there is no
    # previous scene yet, or the tree's SHAPE changed since last frame (a
    # conditional part of the tree grew/shrank, so commands no longer line
    # up index-for-index with last frame's) -- always correct, just not
    # optimized for that one frame.
    pub def render_diff(self, node: Pointer[UiNode], c: Canvas) -> void:
        self.root = layout_tree(node, self.cache, c.width(), c.height())
        self.has_root = true
        self.renders = self.renders + 1
        mut scene = self.build_scene(self.root_bg)
        # nebula1.0 Phase 2 (clipping): see scene_has_clip's own comment --
        # a clipped command's on-screen pixels depend on its enclosing
        # push's rect, not just its own fields, so position-by-position
        # cmd_eq alone cannot safely skip repainting inside a clipped
        # region. Always correct (full repaint), not yet optimized, for
        # any frame that uses clip.
        if self.has_last_scene and scenes_diffable(self.last_scene, scene) and not scene_has_clip(scene):
            execute_diff(self.last_scene, scene, c, self.fonts, self.renderer)
        else:
            execute_software(scene, c, self.fonts, self.renderer)
        self.last_scene = scene
        self.has_last_scene = true

    # `ambient_bg` is the flat color already sitting behind THIS box, before
    # anything below paints over it -- the canvas clear color at the root,
    # cascading down as each panel's own resolved background for its
    # children (a panel with no bg of its own is transparent, so its
    # children still see through to WHATEVER is behind the panel, same as
    # real UI layering). This is what makes anti-aliased rounded corners work
    # for ordinary markup panels/buttons, not just the hand-painted widgets
    # (toolkit/ui/checkbox.tr and friends) that already had a `page_bg` field
    # for exactly this: paint_rounded_rect_aa/fill_circle_aa need to know
    # what color to blend an edge pixel TOWARD, and Canvas.set_pixel has no
    # alpha channel or destination read-back to find that out on its own
    # (see paint_rounded_rect_aa's own comment for the full reasoning) --
    # bare-metal/UEFI framebuffers are plain write-only memory and genuinely
    # cannot blend even in principle, so this had to be solved by tracking
    # the answer ourselves, not by asking the backend.
    # Walks the laid-out tree and EMITS paint commands rather than painting.
    # The logic is exactly what paint() used to do -- hover/press darkening,
    # the ambient-backdrop cascade, bordered vs plain boxes -- with the
    # canvas calls replaced by scene.add(). Splitting it this way is what
    # makes diffing and sub-rect rendering possible; see toolkit/render/scene.tr.
    #
    # Still a private recursive method returning void, which is the safe
    # shape on the freestanding tiers: a recursive method returning `str` is
    # the one that hangs there (bugs.txt, "not bugs" section).
    def emit(self, box: LayoutBox, scene: Scene, ambient_bg: int) -> void:
        # Native-like hover/pressed feedback: only for boxes an author wired
        # to an event (event_name != "") -- a plain decorative panel never
        # darkens just because the cursor happens to be over it.
        #
        # Proposal v4 step G: the darken amount EASES toward its target
        # (0 / 15 / 30) via anim_toward rather than snapping to it in one
        # frame -- a "#hover" suffix on the node's own node_key keeps this
        # animation-internal bookkeeping out of the same namespace a host
        # or a future native widget uses for its own state (state_get/set
        # on the bare node_key). Every existing hosted/SDL2/UEFI/bare-metal
        # example that reads hover_x/y already calls render()/render_diff()
        # every frame, so this needs no new call anywhere -- the eased value
        # is just what those calls now compute.
        mut is_hot = box.event_name != "" and box.contains(self.hover_x, self.hover_y)
        mut target_pct = 0
        if is_hot:
            target_pct = 15
            if self.pressed:
                target_pct = 30
        mut pct = self.anim_toward(box.node_key + "#hover", target_pct, 5)
        mut bg = box.style.bg
        mut border = box.style.border
        if pct > 0:
            if bg != unset():
                bg = darken_color(bg, pct)
            if border != unset():
                border = darken_color(border, pct)

        # What this box's OWN children (and its own text, if it's a text
        # node) will see as their ambient backdrop: this box's resolved fill
        # if it painted one, otherwise unchanged -- a transparent panel is
        # exactly that, transparent, so whatever was behind IT is still
        # behind its children too.
        mut child_ambient = ambient_bg
        if bg != unset():
            child_ambient = bg

        mut has_border = border != unset() and box.style.border_w > 0
        if has_border:
            # Fill + ring + outer edge in ONE command -- see
            # paint_rounded_box_aa's comment for why this is not two nested
            # rounded rects (the short version: two overlapping antialiased
            # ramps cannot be made to agree, and leave a halo tracing every
            # corner).
            #
            # A bordered box with no background of its own is a genuine
            # outline: the ring's inside shows whatever was already behind
            # the box, so `ambient_bg` is the correct fill to blend toward.
            mut inner_fill = bg
            if bg == unset():
                inner_fill = ambient_bg
            scene.add(Cmd.rounded_box(box.x, box.y, box.w, box.h, box.style.radius, box.style.border_w, inner_fill, border, ambient_bg))
        elif bg != unset():
            # nebula1.0 Phase 2: opacity-N -> a 0-255 alpha byte, carried on
            # the Cmd so execute_software/execute_diff decide (backend-
            # dependent) whether it can actually be honoured -- see
            # Style.opacity_pct's own comment for the current scope
            # (plain, unbordered fills only).
            mut alpha_byte = box.style.opacity_pct * 255 / 100
            scene.add(Cmd.rounded_rect_alpha(box.x, box.y, box.w, box.h, box.style.radius, bg, ambient_bg, alpha_byte))

        if box.kind == kind_text():
            # Text sits directly on THIS box's own resolved surface (its own
            # bg if it set one, otherwise whatever shows through it) -- not
            # on `ambient_bg`, which is what's behind the box as a WHOLE, a
            # different thing whenever the box itself painted something.
            scene.add(Cmd.label(box.x, box.y, box.text, box.style.fg, child_ambient, box.style.font_size))

        # Markup-tag widgets (phase 1): checkbox/switch/radio/slider/progress
        # paint themselves here, on `child_ambient` -- the same backdrop this
        # box's own children would see -- since a bare `<checkbox/>` almost
        # never sets its own bg (nothing above this point painted anything to
        # sit on top of). Gated on tag rather than kind: these are all
        # kind_element() nodes, same as a plain `<panel>`, so `box.tag` is
        # the only thing that tells them apart.
        if is_widget_tag(box.tag):
            child_ambient = self.emit_widget(box, scene, child_ambient)

        # nebula1.0 Phase 2 (clipping): `clip` bounds everything painted by
        # this box's CHILDREN to this box's own rect -- not this box's own
        # background/border above, which paint unclipped (matches CSS:
        # overflow:hidden clips a container's content, not the container
        # itself). See toolkit/render/clipped_canvas.tr for the mechanism
        # execute_software/execute_diff apply these bracketing commands with.
        if box.style.clip:
            scene.add(Cmd.clip_push(box.x, box.y, box.w, box.h))

        mut i = 0
        while i < len(box.children):
            self.emit(box.children[i], scene, child_ambient)
            i = i + 1

        if box.style.clip:
            scene.add(Cmd.clip_pop())

    # Markup-tag widgets (phase 1): one branch per tag, porting the exact
    # geometry/colors each widget's own host-owned `.paint()` already used
    # (toolkit/ui/checkbox.tr and friends -- see each for the reasoning
    # behind its specific numbers, not repeated here) but emitting `Cmd`s
    # into `scene` instead of calling a renderer directly, the same
    # scene-graph discipline every other shape in `emit()` already follows.
    #
    # Persisted/live values read through `state_get`/`anim_toward` (Proposal
    # v4 step F/G, keyed on `box.node_key` bare for a widget's OWN primary
    # value, with a `#`-suffixed secondary key for anything that needs one --
    # `#knob` for the switch's animated slide, `#dragging` for the slider's
    # drag flag -- so a widget's own bookkeeping can never collide with the
    # bare key its primary value lives at, or with the unrelated `#hover`
    # suffix `emit()` already uses above for hover/press darkening). The
    # FIRST read of an unset key falls back to the value the markup author
    # declared (`box.w_checked`/`w_selected`/`w_value`), so a widget's
    # initial frame shows exactly what its tag asked for; every frame after
    # shows whatever the last interaction (hit_test_widget, below) set.
    #
    # Phase 2 ("Nebula Studio"): returns the ambient color this box's OWN
    # children should blend their antialiased edges against, instead of
    # `void`. The five phase-1 tags are leaves (no children) and just hand
    # back `ambient_bg` unchanged -- but `tabitem`/`listitem` are
    # containers wrapping a `<text>` label, and when one paints its own
    # dynamic highlight (a selected tab/row), that highlight -- not
    # whatever was behind the box before this call -- is the real backdrop
    # its label now sits on. Without this, the label's glyph-edge blend
    # would target the WRONG color on every highlighted tab/row (see
    # emit()'s own call site, `child_ambient = self.emit_widget(...)`).
    def emit_widget(self, box: LayoutBox, scene: Scene, ambient_bg: int) -> int:
        if box.tag == tag_checkbox():
            mut checked = self.state_get(box.node_key, b2i(box.w_checked)) != 0
            mut bg_off = 0xFFFFFF
            mut bg_on = 0x3B82F6
            mut border = 0x64748B
            mut mark = 0xFFFFFF
            if checked:
                scene.add(Cmd.rounded_rect(box.x, box.y, box.w, box.h, 4, bg_on, ambient_bg))
            else:
                scene.add(Cmd.rounded_box(box.x, box.y, box.w, box.h, 4, 2, bg_off, border, ambient_bg))
            if checked:
                mut thick = box.w / 8
                if thick < 1:
                    thick = 1
                emit_thick_line(scene, box.x + box.w * 28 / 100, box.y + box.h * 52 / 100, box.x + box.w * 42 / 100, box.y + box.h * 68 / 100, thick, mark, bg_on)
                emit_thick_line(scene, box.x + box.w * 42 / 100, box.y + box.h * 68 / 100, box.x + box.w * 74 / 100, box.y + box.h * 32 / 100, thick, mark, bg_on)
            return ambient_bg

        if box.tag == tag_switch():
            mut on = self.state_get(box.node_key, b2i(box.w_checked)) != 0
            mut track_off = 0xCBD5E1
            mut track_on = 0x3B82F6
            mut knob = 0xFFFFFF
            mut track = track_off
            if on:
                track = track_on
            mut target = 0
            if on:
                target = 100
            # See anim_toward's own comment: an unset "#knob" key starts
            # already AT `target`, so a switch's first-ever frame renders
            # snapped to its declared initial state rather than animating in
            # from a bogus 0 -- exactly Switch.init()'s own behaviour.
            mut knob_pos = self.anim_toward(box.node_key + "#knob", target, 12)
            scene.add(Cmd.rounded_rect(box.x, box.y, box.w, box.h, box.h / 2, track, ambient_bg))
            mut r = box.h / 2 - 2
            mut travel = box.w - box.h
            mut knob_x = box.x + box.h / 2 + travel * knob_pos / 100
            mut knob_y = box.y + box.h / 2
            scene.add(Cmd.circle(knob_x, knob_y, r, knob, track))
            return ambient_bg

        if box.tag == tag_radio():
            mut selected = self.state_get(box.node_key, b2i(box.w_selected)) != 0
            mut ring = 0x64748B
            mut accent = 0x3B82F6
            mut fill = 0xFFFFFF
            mut r = box.w / 2
            if box.h / 2 < r:
                r = box.h / 2
            mut cx = box.x + box.w / 2
            mut cy = box.y + box.h / 2
            mut ring_color = ring
            if selected:
                ring_color = accent
            scene.add(Cmd.circle_ring(cx, cy, r, 2, fill, ring_color, ambient_bg))
            if selected:
                scene.add(Cmd.circle(cx, cy, r - 5, accent, fill))
            return ambient_bg

        if box.tag == tag_slider():
            mut span = box.w_max - box.w_min
            mut tm = box.h / 2
            mut travel = box.w - tm * 2
            mut value = self.state_get(box.node_key, box.w_value)
            if value < box.w_min:
                value = box.w_min
            if value > box.w_max:
                value = box.w_max

            # Continues an in-progress drag (started by hit_test_widget's
            # press-on-thumb check) using the CURRENT mouse position, exactly
            # like Slider.drag_to() did -- self-heals the moment `pressed`
            # goes false, so a drag can never get stuck active if a release
            # event is ever missed (e.g. the pointer leaves the window).
            mut dragging = self.state_get(box.node_key + "#dragging", 0) != 0
            mut tx = box.x + tm
            if span > 0 and travel > 0:
                tx = box.x + tm + travel * (value - box.w_min) / span
            if dragging:
                if self.pressed:
                    mut clamped = self.mouse_x
                    if clamped < box.x + tm:
                        clamped = box.x + tm
                    if clamped > box.x + box.w - tm:
                        clamped = box.x + box.w - tm
                    tx = clamped
                    if span > 0 and travel > 0:
                        mut rel = clamped - box.x - tm
                        value = box.w_min + span * rel / travel
                    self.state_set(box.node_key, value)
                else:
                    self.state_set(box.node_key + "#dragging", 0)
            else:
                self.state_set(box.node_key, value)

            mut track_h = 6
            mut track_y = box.y + (box.h - track_h) / 2
            mut track = 0xE2E8F0
            mut fill = 0x3B82F6
            mut thumb = 0xFFFFFF
            mut thumb_border = 0x3B82F6
            scene.add(Cmd.rounded_rect(box.x + tm, track_y, box.w - tm * 2, track_h, track_h / 2, track, ambient_bg))
            mut fill_w = tx - (box.x + tm)
            if fill_w > 0:
                scene.add(Cmd.rounded_rect(box.x + tm, track_y, fill_w, track_h, track_h / 2, fill, track))
            mut thumb_r = box.h / 2
            scene.add(Cmd.circle_ring(tx, box.y + box.h / 2, thumb_r, 3, thumb, thumb_border, fill))
            return ambient_bg

        if box.tag == tag_progress():
            mut value = self.state_get(box.node_key, box.w_value)
            if value < 0:
                value = 0
            if value > 100:
                value = 100
            mut track = 0xE2E8F0
            mut fill = 0x22C55E
            mut r = box.h / 2
            scene.add(Cmd.rounded_rect(box.x, box.y, box.w, box.h, r, track, ambient_bg))
            mut fw = box.w * value / 100
            if fw > 0:
                scene.add(Cmd.rounded_rect(box.x, box.y, fw, box.h, r, fill, track))
            return ambient_bg

        if box.tag == tag_tabitem():
            mut selected = self.state_get(box.node_key, b2i(box.w_selected)) != 0
            if not selected:
                return ambient_bg
            # Selected tab: a flat highlight the same color as the editor
            # pane it "belongs to" -- the classic modern-IDE look where the
            # active tab visually merges with the content below it -- plus
            # a thin accent-blue underline. No radius: a crisp top-tab edge
            # reads better here than a fully rounded pill.
            mut active_bg = 0x0F172A
            mut accent = 0x3B82F6
            scene.add(Cmd.rounded_rect(box.x, box.y, box.w, box.h, 0, active_bg, ambient_bg))
            mut bar_h = 3
            scene.add(Cmd.rounded_rect(box.x, box.y + box.h - bar_h, box.w, bar_h, 0, accent, active_bg))
            return active_bg

        if box.tag == tag_listitem():
            mut selected = self.state_get(box.node_key, b2i(box.w_selected)) != 0
            mut hovered = box.contains(self.hover_x, self.hover_y)
            if not selected and not hovered:
                return ambient_bg
            # Full-width row highlight -- selected gets a stronger accent
            # tint, hover-only (not selected) a subtler one. Two flat pre-
            # muted colors rather than a real alpha blend: execute_software
            # only honours Cmd alpha on a radius<=0 rect (see its own
            # comment) -- a rounded, alpha-blended row is a real gap, not
            # attempted here, so this picks colors that already LOOK like a
            # blend instead.
            mut row_bg = 0x1E293B
            if selected:
                row_bg = 0x1E3A8A
            scene.add(Cmd.rounded_rect(box.x, box.y, box.w, box.h, 6, row_bg, ambient_bg))
            return row_bg

        return ambient_bg

    # Builds the scene for the current tree without painting it. Public so a
    # caller can inspect, translate or diff a frame before it is drawn.
    pub def build_scene(self, ambient_bg: int) -> Scene:
        mut scene = Scene.init()
        if self.has_root:
            self.emit(self.root, scene, ambient_bg)
        return scene

    # (paint_rounded_rect_aa / paint_corner_aa are free functions below --
    # see their own comments for why: Canvas has no fill-rounded-rect or
    # circle primitive, deliberately, so this stays plain fill_rect/set_pixel
    # calls a method can make just as easily as a free function could;
    # they're free functions purely to sit next to hit_test/
    # find_handler_by_event, the toolkit's other tree/paint free functions,
    # not because of the method-vs-free-function recursion gotcha those two
    # have (this isn't recursive).

    # Real glyph painting from the baked antialiased font (toolkit/text/),
    # blended per-pixel via draw_text against `own_bg` -- see draw_text's own
    # comment for the blend mechanism, which is identical to
    # fill_circle_aa/paint_rounded_rect_aa's (a caller-known flat backdrop,
    # since Canvas.set_pixel has no alpha channel to blend with on its own).
    def paint_text(self, box: LayoutBox, c: Canvas, own_bg: int) -> void:
        draw_text(c, self.fonts.pick(box.style.font_size), box.text, box.x, box.y, box.style.fg, own_bg)

    # --- events ----------------------------------------------------------

    # Returns true only when a registered handler actually ran.
    pub def dispatch(self, e: Event) -> bool:
        if not self.has_root:
            return false

        mut wanted = event_name_for_kind(e.kind)
        if wanted == "":
            return false

        # Key events have no (x,y) to hit-test against -- Event.key() sets
        # both to 0, and hit-testing at literal pixel (0,0) would only ever
        # match whatever happens to sit in the top-left corner, not "the
        # thing that wants keyboard input". Dispatch by tree scan instead:
        # the first node anywhere in the tree with `@on_key(...)` wins, a
        # global (focus-less) listener rather than per-widget focus tracking
        # -- enough for the toolkit's current single-active-handler demos,
        # and matches how the allowlist itself has no concept of "the
        # currently focused widget" either.
        mut name = ""
        if e.kind == ev_key():
            name = find_handler_by_event(self.root, 0, wanted)
        else:
            # Markup-tag widgets (phase 1): mutate widget state BEFORE the
            # ordinary handler-allowlist lookup below -- a bare `<checkbox/>`
            # has no `event_name` at all, so hit_test would never find it on
            # its own, and a tag that DOES also carry `@on_click(...)` should
            # still get both (the toggle AND the handler) from one click.
            hit_test_widget(self, self.root, self.root, e.x, e.y, 0)
            name = hit_test(self.root, e.x, e.y, 0, wanted)
        if name == "":
            return false

        # Linear scan of the allowlist. A handful of handlers makes a hash
        # table pointless, and a name with no slot is ignored on purpose.
        mut i = 0
        while i < len(self.handlers):
            mut slot = self.handlers[i]
            if slot.name == name:
                slot.h.handle(e)
                return true
            i = i + 1
        return false

    pub def stats(self) -> str:
        return "Interpreter(renders=" + self.renders.to_str() + " handlers=" + len(self.handlers).to_str() + ") " + self.cache.stats()

# Scales each channel down by pct% -- used for hover/pressed feedback
# (Interpreter.paint). Integer math only (no float channel needed for a
# handful of discrete darken levels), consistent with toolkit.types packing
# color as a plain 0xRRGGBB int rather than a class.
def darken_color(color: int, pct: int) -> int:
    mut r = red_of(color) * (100 - pct) / 100
    mut g = green_of(color) * (100 - pct) / 100
    mut b = blue_of(color) * (100 - pct) / 100
    return rgb(r, g, b)

# Interpreter.state stores ints (Proposal v4 step F -- see the field's own
# comment for why), but a widget-tag's declared initial value
# (`LayoutBox.w_checked`/`w_selected`) is a bool -- this is the one-line
# conversion `emit_widget`'s checkbox/switch/radio branches each need for
# their very first `state_get` call, spelled out once rather than inlined
# three times.
def b2i(b: bool) -> int:
    if b:
        return 1
    return 0

# Checkbox's checkmark, ported to emit `Cmd`s instead of calling
# `c.fill_rect` directly -- `emit_widget` (an `emit()` helper) must only
# ever call `scene.add(...)`, never paint straight to a Canvas, the same
# hard rule every other shape in `emit()` already follows (see toolkit/
# render/scene.tr's own header on why: painting straight to a Canvas here
# would defeat diffing/sub-rect rendering for every widget tag). Otherwise
# byte-identical Bresenham-ish stepper to toolkit/ui/checkbox.tr's
# `draw_thick_line` -- see that function's own comment for the algorithm;
# only the one line that used to call `c.fill_rect` differs here, now
# emitting a same-sized `Cmd.rounded_rect` (radius 0, so it paints as a
# plain flat-filled square exactly like the original fill_rect did -- see
# `paint_rounded_rect_aa`'s own r<=0 fallback) at each step instead.
def emit_thick_line(scene: Scene, x0: int, y0: int, x1: int, y1: int, thick: int, color: int, ambient: int) -> void:
    mut dx = x1 - x0
    if dx < 0:
        dx = 0 - dx
    mut dy = y1 - y0
    if dy < 0:
        dy = 0 - dy
    mut sx = 1
    if x0 >= x1:
        sx = 0 - 1
    mut sy = 1
    if y0 >= y1:
        sy = 0 - 1
    mut err = dx - dy

    mut cx = x0
    mut cy = y0
    mut guard = 0
    mut max_steps = dx + dy + 4
    while guard <= max_steps:
        scene.add(Cmd.rounded_rect(cx - thick / 2, cy - thick / 2, thick, thick, 0, color, ambient))
        if cx == x1 and cy == y1:
            guard = max_steps + 1
        else:
            mut e2 = err * 2
            if e2 > 0 - dy:
                err = err - dy
                cx = cx + sx
            if e2 < dx:
                err = err + dx
                cy = cy + sy
            guard = guard + 1

# A rounded rect, built from three plain fills (the straight edges) and four
# per-pixel quarter-circles (the corners) -- Canvas has no fill-rounded-rect
# or circle primitive (see Interpreter.paint's comment for why: fill_rect/
# set_pixel only, so every backend -- hosted, SDL2, Cortex-M framebuffer,
# UEFI GOP -- stays this simple and gets rounded corners for free with no
# backend-specific code). `radius<=0` (or too big for the box) clamps to a
# plain fill_rect, so this is a strict superset of the old square-corner
# behavior, not a separate cost every caller pays.
pub def paint_rounded_rect(c: Canvas, x: int, y: int, w: int, h: int, radius: int, color: int) -> void:
    if w <= 0:
        return
    if h <= 0:
        return
    mut r = radius
    if r < 0:
        r = 0
    if r * 2 > w:
        r = w / 2
    if r * 2 > h:
        r = h / 2
    if r <= 0:
        c.fill_rect(x, y, w, h, color)
        return

    c.fill_rect(x, y + r, w, h - r * 2, color)
    c.fill_rect(x + r, y, w - r * 2, r, color)
    c.fill_rect(x + r, y + h - r, w - r * 2, r, color)

    paint_corner(c, x, y, r, color, true, true)
    paint_corner(c, x + w - r, y, r, color, false, true)
    paint_corner(c, x, y + h - r, r, color, true, false)
    paint_corner(c, x + w - r, y + h - r, r, color, false, false)

# Fills the quarter-circle within an r x r square anchored at (ax,ay) (the
# square's top-left pixel, one of the four corner squares a rounded rect's
# straight fills leave uncovered). `inner_right`/`inner_bottom` say which
# edge of THIS square borders the box's already-filled straight interior
# (true) vs. the box's own outer corner (false) -- that is where the circle
# center sits, in local square coordinates: (r,r) if both true (top-left
# corner of the box), (0,r)/(r,0)/(0,0) for the other three. A pixel near
# the outer-corner side is farther from that center and gets rounded off;
# a pixel near the inner side is within radius and stays filled, connecting
# smoothly to the straight edges either side of it.
def paint_corner(c: Canvas, ax: int, ay: int, r: int, color: int, inner_right: bool, inner_bottom: bool) -> void:
    mut center_x = 0
    if inner_right:
        center_x = r
    mut center_y = 0
    if inner_bottom:
        center_y = r
    mut yy = 0
    while yy < r:
        mut xx = 0
        while xx < r:
            mut dx = xx - center_x
            mut dy = yy - center_y
            if dx * dx + dy * dy <= r * r:
                c.set_pixel(ax + xx, ay + yy, color)
            xx = xx + 1
        yy = yy + 1

# Anti-aliased rounded rect -- same fg/bg-blend approach as fill_circle_aa
# (see its comment for the underlying reasoning: no real alpha channel
# anywhere in Canvas, so this blends the edge colors itself, in Tauraro,
# before ever calling set_pixel). Only the four corners actually need
# softening -- the straight edges paint_rounded_rect already draws are
# axis-aligned rects, which are already pixel-exact with no jagged edge to
# begin with -- so this reuses paint_rounded_rect's own straight-fill calls
# unchanged and only swaps paint_corner for an anti-aliased corner.
#
# `bg` must be the solid color already sitting where this shape is about to
# be drawn (its own container's flat backdrop) for the blend to be correct --
# exactly the same requirement fill_circle_aa has, and the same reason: nothing
# here can read the real destination pixel back to find out.
pub def paint_rounded_rect_aa(c: Canvas, x: int, y: int, w: int, h: int, radius: int, fg: int, bg: int) -> void:
    if w <= 0:
        return
    if h <= 0:
        return
    mut r = radius
    if r < 0:
        r = 0
    if r * 2 > w:
        r = w / 2
    if r * 2 > h:
        r = h / 2
    if r <= 0:
        c.fill_rect(x, y, w, h, fg)
        return

    c.fill_rect(x, y + r, w, h - r * 2, fg)
    c.fill_rect(x + r, y, w - r * 2, r, fg)
    c.fill_rect(x + r, y + h - r, w - r * 2, r, fg)

    paint_corner_aa(c, x, y, r, fg, bg, true, true)
    paint_corner_aa(c, x + w - r, y, r, fg, bg, false, true)
    paint_corner_aa(c, x, y + h - r, r, fg, bg, true, false)
    paint_corner_aa(c, x + w - r, y + h - r, r, fg, bg, false, false)

# Anti-aliased counterpart to paint_corner -- analytic distance-field
# coverage (see analytic_coverage's own comment) applied to a quarter-circle
# instead of a full one.
def paint_corner_aa(c: Canvas, ax: int, ay: int, r: int, fg: int, bg: int, inner_right: bool, inner_bottom: bool) -> void:
    mut center_x = 0
    if inner_right:
        center_x = r
    mut center_y = 0
    if inner_bottom:
        center_y = r

    mut yy = 0 - 1
    while yy <= r:
        mut xx = 0 - 1
        while xx <= r:
            mut coverage = analytic_coverage(xx - center_x, yy - center_y, r)
            if coverage == 255:
                c.set_pixel(ax + xx, ay + yy, fg)
            elif coverage > 0:
                c.set_pixel(ax + xx, ay + yy, mix_color_hq(fg, bg, coverage))
            xx = xx + 1
        yy = yy + 1

# A bordered rounded box -- fill, ring, and outer edge resolved in ONE pass.
#
# The obvious way to draw this is two calls to paint_rounded_rect_aa: the
# whole box in `border`, then an inset box in `fill` on top, leaving a ring.
# That is what this toolkit did until 2026-09-05, and it ghosts. The reason
# is worth stating once, here, because it is not obvious: the inset fill's
# antialiased corner ramp blends toward whatever the caller SAYS is behind
# it, and the honest answer there is "the border color" -- but only where
# the ring is actually solid. Wherever the two ramps overlap (which is
# always, once border_w is 1-2px against a radius of 8-12), the pixels under
# the inner ramp are themselves already a border/ambient MIX, not solid
# border, so blending toward solid border overshoots and leaves a visible
# lighter halo tracing each corner. No choice of backdrop argument fixes it;
# the information needed simply isn't available to the second call.
#
# So the ring is resolved per-subsample instead, exactly as RASTERIZER.md 5c
# prescribes: one pass over each corner asks each of the 16 subsamples which
# of THREE regions it lands in (inside the inner radius -> fill, between the
# radii -> border, outside -> ambient) and mixes all three at once. The two
# ramps can't disagree because there are no longer two of them.
#
# The straight edges need none of this -- they're axis-aligned rectangles
# with no curved boundary to soften -- so they stay plain exact fill_rect
# calls and only the four corner squares pay the 16x supersampling cost.
pub def paint_rounded_box_aa(c: Canvas, x: int, y: int, w: int, h: int, radius: int, border_w: int, fill: int, border: int, ambient: int) -> void:
    if w <= 0:
        return
    if h <= 0:
        return

    mut r = radius
    if r < 0:
        r = 0
    if r * 2 > w:
        r = w / 2
    if r * 2 > h:
        r = h / 2

    mut b = border_w
    if b < 0:
        b = 0
    if b == 0:
        paint_rounded_rect_aa(c, x, y, w, h, r, fill, ambient)
        return
    # A border thick enough to meet itself leaves no interior at all -- draw
    # it as a solid box in the border color rather than emitting a
    # zero-or-negative-sized inner fill.
    if b * 2 >= w or b * 2 >= h:
        paint_rounded_rect_aa(c, x, y, w, h, r, border, ambient)
        return

    if r <= 0:
        c.fill_rect(x, y, w, b, border)
        c.fill_rect(x, y + h - b, w, b, border)
        c.fill_rect(x, y + b, b, h - b * 2, border)
        c.fill_rect(x + w - b, y + b, b, h - b * 2, border)
        c.fill_rect(x + b, y + b, w - b * 2, h - b * 2, fill)
        return

    # Border strips along the four straight edges, between the corner squares.
    c.fill_rect(x + r, y, w - r * 2, b, border)
    c.fill_rect(x + r, y + h - b, w - r * 2, b, border)
    c.fill_rect(x, y + r, b, h - r * 2, border)
    c.fill_rect(x + w - b, y + r, b, h - r * 2, border)

    # Interior fill as a plus shape: the full-width middle band, plus the two
    # narrower strips above and below it that the corner squares don't reach.
    c.fill_rect(x + b, y + r, w - b * 2, h - r * 2, fill)
    c.fill_rect(x + r, y + b, w - r * 2, r - b, fill)
    c.fill_rect(x + r, y + h - r, w - r * 2, r - b, fill)

    paint_border_corner_aa(c, x, y, r, b, fill, border, ambient, true, true)
    paint_border_corner_aa(c, x + w - r, y, r, b, fill, border, ambient, false, true)
    paint_border_corner_aa(c, x, y + h - r, r, b, fill, border, ambient, true, false)
    paint_border_corner_aa(c, x + w - r, y + h - r, r, b, fill, border, ambient, false, false)

# One corner of paint_rounded_box_aa. Same square/anchor/inner_right/
# inner_bottom convention as paint_corner and paint_corner_aa (see
# paint_corner's comment for what those two flags mean geometrically).
#
# The inner rounded rect is inset by `b` on every side with radius `r - b`,
# which puts its corner arc's center at exactly the same point as the outer
# arc's -- the two circles are concentric -- so classifying a subsample is a
# plain annulus test against two radii sharing one center, not two separate
# distance fields.
def paint_border_corner_aa(c: Canvas, ax: int, ay: int, r: int, b: int, fill: int, border: int, ambient: int, inner_right: bool, inner_bottom: bool) -> void:
    mut center_x = 0
    if inner_right:
        center_x = r
    mut center_y = 0
    if inner_bottom:
        center_y = r

    mut ir = r - b
    if ir < 0:
        ir = 0

    mut yy = 0 - 1
    while yy <= r:
        mut xx = 0 - 1
        while xx <= r:
            mut dx = xx - center_x
            mut dy = yy - center_y
            mut co = analytic_coverage(dx, dy, r)
            if co > 0:
                mut ci = analytic_coverage(dx, dy, ir)
                if ci == 255:
                    c.set_pixel(ax + xx, ay + yy, fill)
                elif co == 255 and ci == 0:
                    c.set_pixel(ax + xx, ay + yy, border)
                else:
                    c.set_pixel(ax + xx, ay + yy, mix3_color_hq(fill, border, ambient, ci, co))
            xx = xx + 1
        yy = yy + 1

# High-resolution (0..255 scale) counterpart to mix_color -- see
# analytic_coverage's comment for why shape rasterization needs a finer
# scale than mix_color's 0..16 (which stays exactly as it was, unchanged,
# because draw_text's baked font atlas genuinely IS 0..16 data and mixing
# scales there would need re-baking three atlases for no visual benefit --
# glyphs are small enough that 17 levels was never the limiting factor).
#
# Blended in linear light -- see mix_color's own comment for why (same
# reasoning, same toolkit/render/gamma.tr tables); this is the function
# that actually blends every rounded corner and circle edge in the
# toolkit, so it is where gamma-correct blending matters most.
def mix_color_hq(fg: int, bg: int, coverage: int) -> int:
    mut fr = srgb_to_linear(red_of(fg))
    mut fgc = srgb_to_linear(green_of(fg))
    mut fb = srgb_to_linear(blue_of(fg))
    mut br = srgb_to_linear(red_of(bg))
    mut bgc = srgb_to_linear(green_of(bg))
    mut bb = srgb_to_linear(blue_of(bg))
    mut r = linear_to_srgb((fr * coverage + br * (255 - coverage) + 128) / 255)
    mut g = linear_to_srgb((fgc * coverage + bgc * (255 - coverage) + 128) / 255)
    mut b = linear_to_srgb((fb * coverage + bb * (255 - coverage) + 128) / 255)
    return rgb(r, g, b)

# Three-way weighted mix for a pixel straddling fill, border ring, and
# whatever is behind the box -- same shape as the original mix3_color, just
# on mix_color_hq's 0..255 scale and blended in the same linear light. `ci`
# is the inner radius's analytic coverage, `co` the outer's; because the
# two circles are concentric and the inner one is smaller, ci is always
# <= co, so the three weights (ci, co - ci, 255 - co) are non-negative and
# sum to exactly 255.
def mix3_color_hq(fill: int, border: int, ambient: int, ci: int, co: int) -> int:
    mut wf = ci
    mut wb = co - ci
    mut wa = 255 - co
    mut flr = srgb_to_linear(red_of(fill))
    mut flg = srgb_to_linear(green_of(fill))
    mut flb = srgb_to_linear(blue_of(fill))
    mut bor = srgb_to_linear(red_of(border))
    mut bog = srgb_to_linear(green_of(border))
    mut bob = srgb_to_linear(blue_of(border))
    mut amr = srgb_to_linear(red_of(ambient))
    mut amg = srgb_to_linear(green_of(ambient))
    mut amb = srgb_to_linear(blue_of(ambient))
    mut r = linear_to_srgb((flr * wf + bor * wb + amr * wa + 128) / 255)
    mut g = linear_to_srgb((flg * wf + bog * wb + amg * wa + 128) / 255)
    mut b = linear_to_srgb((flb * wf + bob * wb + amb * wa + 128) / 255)
    return rgb(r, g, b)

# Draws one line of text at the baked font's cell size, top-left anchored at
# (x, y) -- the ONE glyph-painting implementation Interpreter.paint_text,
# TextInput.paint, and every text-drawing widget (dropdown/tabs/list) all
# call, rather than each keeping its own copy (there used to be three
# separate copies of this loop; consolidated 2026-09-05 when the font
# changed from a 1-bit mask to a 0-16 coverage atlas -- three places
# independently relearning the same blend math was exactly the kind of
# duplication not worth carrying forward).
#
# `bg` is blended against exactly the way fill_circle_aa/paint_rounded_rect_aa
# blend edge pixels: the baked atlas (toolkit/text/font_data.tr) stores a
# real 0-16 antialiased coverage level per pixel, not a bit, and
# Canvas.set_pixel has no alpha channel of its own to do that blending for
# us -- so it's computed here, in Tauraro, before the one final solid color
# is ever handed to set_pixel. `bg` must be the flat color already sitting
# where this text is about to be drawn (see paint_rounded_rect_aa's own
# comment for the same requirement, same reason).
pub def draw_text(c: Canvas, font: Font, text: str, x: int, y: int, fg: int, bg: int) -> void:
    mut cw = font.cell_w()
    mut ch = font.cell_h()
    mut n = Str.len(text)
    mut i = 0
    while i < n:
        mut codepoint = Str.char_at(text, i)
        mut col = 0
        while col < cw:
            mut row = 0
            while row < ch:
                mut coverage = font.pixel_coverage(codepoint, col, row)
                if coverage == 16:
                    c.set_pixel(x + i * cw + col, y + row, fg)
                elif coverage > 0:
                    c.set_pixel(x + i * cw + col, y + row, mix_color(fg, bg, coverage))
                row = row + 1
            col = col + 1
        i = i + 1

# A filled circle, via the exact same midpoint-in-a-square test paint_corner
# already uses for a rounded rect's quarter-circle corners -- pulled out as
# its own function because the new widgets (radio button, switch knob, slider
# thumb) all want a plain full circle, not one quartered off against two
# straight edges. Same per-pixel set_pixel cost as paint_corner, same reason
# it stays that way: Canvas has no circle primitive, deliberately (see
# toolkit/render/canvas.tr).
#
# Hard-edged -- every pixel is fully `color` or fully untouched, which is
# what makes a small circle look visibly stepped/jagged at these sizes
# (a radio dot, a switch knob). See fill_circle_aa below for the smoothed
# version; this one stays as the cheap primitive it always was, for anything
# that doesn't care.
pub def fill_circle(c: Canvas, cx: int, cy: int, r: int, color: int) -> void:
    if r <= 0:
        return
    mut yy = 0 - r
    while yy <= r:
        mut xx = 0 - r
        while xx <= r:
            if xx * xx + yy * yy <= r * r:
                c.set_pixel(cx + xx, cy + yy, color)
            xx = xx + 1
        yy = yy + 1

# Anti-aliased filled circle. Canvas.set_pixel takes one solid, final color --
# there is no alpha channel or destination read-back anywhere in the Canvas
# interface (deliberately minimal, see toolkit/render/canvas.tr; the
# bare-metal/UEFI framebuffer backends are plain write-only memory, they
# cannot blend even if asked to) -- so this does the blending itself, in
# Tauraro, before the pixel is ever written: each boundary pixel's OWN color
# is computed as a straight-line mix between `fg` and the caller-supplied
# `bg`, weighted by analytic_coverage() -- a true distance-field ramp, not a
# supersampled approximation of one (see that function's own comment for why
# this replaced the original 4x4-subsample version, and RASTERIZER.md
# section 4b, which specified this exact approach). A pixel fully inside
# gets pure `fg`; fully outside is skipped entirely (never touched, so
# whatever was already there -- which had better be `bg`, or close to it --
# still shows); only the ring of boundary pixels costs the extra work and
# gets an intermediate shade. Correct as long as `bg` genuinely is the solid
# color already sitting under this circle (every call site here paints its
# own flat backdrop first, then the circle on top of it, so that always
# holds).
pub def fill_circle_aa(c: Canvas, cx: int, cy: int, r: int, fg: int, bg: int) -> void:
    if r <= 0:
        return
    mut yy = 0 - r - 1
    while yy <= r + 1:
        mut xx = 0 - r - 1
        while xx <= r + 1:
            mut coverage = analytic_coverage(xx, yy, r)
            if coverage == 255:
                c.set_pixel(cx + xx, cy + yy, fg)
            elif coverage > 0:
                c.set_pixel(cx + xx, cy + yy, mix_color_hq(fg, bg, coverage))
            xx = xx + 1
        yy = yy + 1

# The circular counterpart to paint_rounded_box_aa: a filled disc with a
# ring around it, all three regions resolved per-subsample in one pass.
# Exists for the same reason and fixes the same defect -- a radio button and
# a slider thumb were each drawn as two overlapping fill_circle_aa calls, an
# outer disc in the ring color and a smaller one in the fill color, and the
# inner disc's antialiased rim blended toward solid ring color over pixels
# that were themselves already a ring/ambient mix. On a 9px radio dot that
# halo is a meaningful fraction of the whole widget.
pub def fill_circle_ring_aa(c: Canvas, cx: int, cy: int, r: int, ring_w: int, fill: int, ring: int, ambient: int) -> void:
    if r <= 0:
        return
    mut rw = ring_w
    if rw < 0:
        rw = 0
    if rw == 0:
        fill_circle_aa(c, cx, cy, r, fill, ambient)
        return
    if rw >= r:
        fill_circle_aa(c, cx, cy, r, ring, ambient)
        return

    mut ir = r - rw

    mut yy = 0 - r - 1
    while yy <= r + 1:
        mut xx = 0 - r - 1
        while xx <= r + 1:
            mut co = analytic_coverage(xx, yy, r)
            if co > 0:
                mut ci = analytic_coverage(xx, yy, ir)
                if ci == 255:
                    c.set_pixel(cx + xx, cy + yy, fill)
                elif co == 255 and ci == 0:
                    c.set_pixel(cx + xx, cy + yy, ring)
                else:
                    c.set_pixel(cx + xx, cy + yy, mix3_color_hq(fill, ring, ambient, ci, co))
            xx = xx + 1
        yy = yy + 1

# Analytic (signed-distance-field) coverage for a circle boundary, replacing
# the toolkit's original 4x4=16-subsample supersampling with a true
# distance-based ramp -- RASTERIZER.md section 4b specified exactly this,
# reserving supersampling only for corner radii below ~2px where an SDF
# visibly rounds off; every shape in this toolkit (radio/switch/slider
# circles, rounded-rect/box corners) uses a radius well above that, so the
# hybrid was never actually needed here.
#
# No floating point: Math.isqrt (std/math/int.tr, pure integer Newton's
# method) computes floor(sqrt(dist_sq * 256)), i.e. distance scaled by 16
# for 1/16-pixel sub-integer precision, keeping this file's own "integer
# math throughout" rule intact -- portable to the freestanding/bare-metal
# targets this toolkit also builds for for exactly the reason RASTERIZER.md
# gives: no FPU dependency.
#
# The ramp itself is the standard analytic-AA formula: full coverage at
# distance <= r - 0.5, zero at distance >= r + 0.5, linear in between (one
# pixel wide, centered on the true boundary). Returns 0..255, not 0..16 --
# a continuous distance measurement naturally resolves far more than 17
# shades, which is what actually removes the visible banding a discrete
# 4x4 grid leaves around a circle this size, not just a more accurate guess
# at which of the same 17 buckets a pixel belongs in.
def analytic_coverage(dx: int, dy: int, r: int) -> int:
    if r <= 0:
        return 0
    mut dist_sq = dx * dx + dy * dy
    mut dist16 = Math.isqrt(dist_sq * 256)
    mut r16 = r * 16
    mut raw = r16 + 8 - dist16
    if raw <= 0:
        return 0
    if raw >= 16:
        return 255
    return raw * 255 / 16

# Straight-line per-channel mix of fg and bg, weighted by coverage/16 --
# coverage==16 (fully inside) is handled as a fast path by the caller and
# never reaches here; this only ever blends a genuine partial-coverage edge
# pixel.
#
# Blended in LINEAR light (srgb_to_linear in, linear_to_srgb out), not in
# the raw sRGB-encoded channel values every #hex colour in this toolkit is
# written in -- averaging gamma-ENCODED bytes directly is a well-known,
# named rendering bug: it biases every blended edge toward the darker of
# the two colours, because sRGB encodes light non-linearly. This is what
# makes naive software antialiasing read as slightly "muddy" next to a
# real vector renderer (Skia, browsers) even with equally good sampling --
# see toolkit/render/gamma.tr's own comment for the full reasoning and
# where the two lookup tables came from.
#
# The `+ 8` before the divide is the rounding correction, not decoration:
# `(x + 2^(n-1)) / 2^n` rounds to nearest where a bare `/ 16` truncates
# toward zero, which biases EVERY blended pixel about half a level toward
# black. One edge pixel wouldn't matter; a whole UI's worth of edges reads
# as a faint dark fringe around every rounded corner and every glyph.
# (RASTERIZER.md 5d -- the same reason its blend_channel adds 128 before
# dividing by 255.)
def mix_color(fg: int, bg: int, coverage: int) -> int:
    mut fr = srgb_to_linear(red_of(fg))
    mut fgc = srgb_to_linear(green_of(fg))
    mut fb = srgb_to_linear(blue_of(fg))
    mut br = srgb_to_linear(red_of(bg))
    mut bgc = srgb_to_linear(green_of(bg))
    mut bb = srgb_to_linear(blue_of(bg))
    mut r = linear_to_srgb((fr * coverage + br * (16 - coverage) + 8) / 16)
    mut g = linear_to_srgb((fgc * coverage + bgc * (16 - coverage) + 8) / 16)
    mut b = linear_to_srgb((fb * coverage + bb * (16 - coverage) + 8) / 16)
    return rgb(r, g, b)

# Deepest-first hit test: the innermost box containing the point that names a
# handler wins, which is what makes a button inside a panel behave.
#
# A FREE FUNCTION, not a method, and that is load-bearing rather than stylistic.
# As a private recursive method returning str this hangs under --freestanding on
# Cortex-M -- it runs correctly hosted, and the byte-identical logic as a free
# function runs correctly on both. (Interpreter.paint is also private and
# recursive but returns void, and is fine, so the trigger appears to be the
# string return rather than the recursion alone.) Verified under
# qemu-system-arm -M mps2-an385.
#
# Depth-bounded: a bare metal stack is a few KB, and a malformed tree must
# degrade to a wrong answer rather than run off the end of it.
pub def hit_test(box: LayoutBox, x: int, y: int, depth: int, wanted_event: str) -> str:
    if depth > max_depth():
        return ""
    if not box.contains(x, y):
        return ""
    mut found = ""
    mut i = 0
    while i < len(box.children):
        mut r = hit_test(box.children[i], x, y, depth + 1, wanted_event)
        if r != "":
            found = r
        i = i + 1
    if found != "":
        return found
    if box.event_name != wanted_event:
        return ""
    return box.handler

# Position-free counterpart to hit_test: the first node anywhere in the tree
# (depth-first, pre-order) whose event_name matches wins -- used for event
# kinds like key input that have no (x,y) to test against. Same depth cap and
# free-function-not-method shape as hit_test, for the same reason (see its
# comment): a private recursive method returning str hangs under
# --freestanding on Cortex-M.
pub def find_handler_by_event(box: LayoutBox, depth: int, wanted_event: str) -> str:
    if depth > max_depth():
        return ""
    if box.event_name == wanted_event:
        return box.handler
    mut i = 0
    while i < len(box.children):
        mut r = find_handler_by_event(box.children[i], depth + 1, wanted_event)
        if r != "":
            return r
        i = i + 1
    return ""

# Markup-tag widgets (phase 1): deepest-first widget-state mutation, parallel
# to hit_test but distinct from it -- a bare `<checkbox/>` has NO
# `event_name` at all (no `@on_click(...)` needed for it to work), so
# hit_test's own event_name match would never find it. `root` is threaded
# through unchanged at every recursive call (not walked itself here) purely
# so the radio/tabitem/listitem branches below can reach every OTHER node
# in the tree once one of them is clicked -- see select_in_group.
#
# Same depth-bounded free-function shape as hit_test, for the same reason
# (see its own comment): safe under --freestanding; a recursive private
# METHOD returning str is the one that hangs there, and this returns bool
# and is a free function, so neither trigger applies -- kept the same shape
# anyway for consistency with the rest of this file's tree-walking helpers.
pub def hit_test_widget(it: Interpreter, root: LayoutBox, box: LayoutBox, x: int, y: int, depth: int) -> bool:
    if depth > max_depth():
        return false
    if not box.contains(x, y):
        return false

    mut i = 0
    while i < len(box.children):
        if hit_test_widget(it, root, box.children[i], x, y, depth + 1):
            return true
        i = i + 1

    if box.tag == tag_checkbox():
        it.state_toggle(box.node_key, b2i(box.w_checked))
        return true

    if box.tag == tag_switch():
        it.state_toggle(box.node_key, b2i(box.w_checked))
        return true

    if box.tag == tag_radio():
        select_in_group(it, root, tag_radio(), box)
        return true

    if box.tag == tag_tabitem():
        select_in_group(it, root, tag_tabitem(), box)
        return true

    if box.tag == tag_listitem():
        select_in_group(it, root, tag_listitem(), box)
        return true

    if box.tag == tag_slider():
        # Same hit region Slider.press_inside used: within the thumb's
        # current pixel position +/- one box-height -- clicking elsewhere on
        # the track does nothing on its own, matching that widget's own
        # documented scope (see toolkit/ui/slider.tr's header).
        mut tm = box.h / 2
        mut span = box.w_max - box.w_min
        mut travel = box.w - tm * 2
        mut value = it.state_get(box.node_key, box.w_value)
        mut tx = box.x + tm
        if span > 0 and travel > 0:
            tx = box.x + tm + travel * (value - box.w_min) / span
        mut hit_r = box.h
        if x >= tx - hit_r and x <= tx + hit_r:
            it.state_set(box.node_key + "#dragging", 1)
        return true

    return false

# Selects `box` and, if it opted into a group, clears every other node
# sharing that group -- the one piece of click handling radio/tabitem/
# listitem all share verbatim, factored out once those three tags all
# needed it identically (phase 2). Also writes a group-wide convenience
# key, `"G:" + group` -> `box.w_value`, so host code that needs "which
# value is active in this group" (e.g. syncing a sidebar file-list
# selection to a tab strip -- two different TAGS, one conceptual
# selection) can read one key instead of scanning every member's own
# bare-node_key state by hand.
def select_in_group(it: Interpreter, root: LayoutBox, tag: str, box: LayoutBox) -> void:
    it.state_set(box.node_key, 1)
    # Ungrouped (no `group-NAME` token) members stay independent, exactly
    # like a checkbox -- grouping is something an author opts INTO, not a
    # default every bare tag pays for just by sharing an empty group name
    # with every other bare one of the same tag in the tree.
    if box.w_group != "":
        deselect_group_siblings(it, root, tag, box.w_group, box.node_key, 0)
        it.state_set("G:" + box.w_group, box.w_value)

# Clears every OTHER node sharing (tag, group) -- the tree-walk counterpart
# to toolkit/ui/radio.tr's `select_only`, which could only clear a caller-
# held `List[Radio]` since host-owned radios were never part of one tree to
# walk in the first place. Whole-tree, not scoped to any one parent,
# matching how the group name token itself reads (two radios in different
# panels sharing `group-theme` are still one group). Matched on `tag` AND
# `group` together, not group alone -- a `<listitem>` click must never
# clear a `<tabitem>`'s selection even if a caller reused one group name
# for both (e.g. this file's own "G:active-file" convenience-key pattern).
def deselect_group_siblings(it: Interpreter, box: LayoutBox, tag: str, group: str, except_key: str, depth: int) -> void:
    if depth > max_depth():
        return
    if box.tag == tag and box.w_group == group and box.node_key != except_key:
        it.state_set(box.node_key, 0)
    mut i = 0
    while i < len(box.children):
        deselect_group_siblings(it, box.children[i], tag, group, except_key, depth + 1)
        i = i + 1

# Register a host handler under the name UI content may reference.
#
# A free function because a method call does NOT auto-upcast a concrete class to
# an interface, while a free function's parameter does -- and doing the upcast
# by hand with `mut x: EventHandler = obj` would MOVE obj away from the caller.
# NB: named register_handler, not register -- `register` is a C storage-class
# keyword, and emitting it mangles the symbol and loses the interface upcast.
pub def register_handler(it: Interpreter, name: str, h: EventHandler) -> void:
    it.add_slot(name, h)

# Render a tree to a concrete canvas without giving up ownership of it.
#
# Tauraro upcasts a concrete class to an interface automatically at a free
# function's call site, but not at a method's, and writing the upcast out by
# hand (`mut view: Canvas = canvas`) MOVES the canvas -- after which the caller
# can no longer touch its own buffer to save or inspect it ([M-1]). Routing the
# upcast through a free function is what keeps the canvas usable afterwards, so
# callers should prefer this over Interpreter.render.
pub def render_to(it: Interpreter, node: Pointer[UiNode], c: Canvas) -> void:
    it.render(node, c)

# Sub-rect rendering. Same reason this is a free function as render_to: a
# method call does not auto-upcast a concrete backend to the Canvas
# interface, so `it.render_rect(tree, my_sdl_canvas, ...)` fails to compile
# while passing the same value through a free function's interface parameter
# upcasts without moving it.
pub def render_into(it: Interpreter, node: Pointer[UiNode], c: Canvas, x: int, y: int, w: int, h: int, ambient: int) -> void:
    it.render_rect(node, c, x, y, w, h, ambient)

# Same reason this is a free function as render_to/render_into: a concrete
# backend (SdlCanvas, GopCanvas, ...) upcasts to Canvas automatically at a
# free function's call site, not at a method's -- so a real frame loop calls
# THIS, not it.render_diff(...) directly, the same way it already calls
# render_to rather than it.render(...).
pub def render_diff_to(it: Interpreter, node: Pointer[UiNode], c: Canvas) -> void:
    it.render_diff(node, c)

# Replays a scene onto any Canvas, using the same rasterizer primitives the
# interpreter used to call directly. This is the whole compatibility story
# for the scene graph: BufferCanvas, FrameBuffer, GopCanvas, WebCanvas and
# SdlCanvas are untouched, because the commands bottom out in exactly the
# functions they already supported.
#
# Kept in this module rather than in toolkit/render/scene.tr because the
# primitives live here, and scene.tr must import nothing to stay off the
# import cycle (Tauraro rejects circular imports).
#
# Markup-tag widgets (phase 1): `r: Renderer` is new here -- this whole
# scene-execution path was CPU-only before, bypassing the `Renderer`
# abstraction every host-painted widget already uses for real GPU/Canvas2D
# shapes (a gap proposal-v6-renderer-abstraction.md already documented as
# deferred, not new). `exec_cmds`/`execute_diff` dispatch the two NEW
# circle/circle_ring Cmd kinds through `r` for that reason -- but
# `rounded_rect`/`rounded_box` keep calling `paint_rounded_rect_aa`/
# `paint_rounded_box_aa` directly, UNCHANGED, on purpose: routing every
# existing panel/button through Renderer too is a strict-superset
# improvement with a much larger blast radius (every markup node on every
# backend, not just the widget tags this phase adds), correctly left for a
# later pass. `r` reaches here via `Interpreter.renderer`, defaulted to
# `default_renderer()` (SoftwareRenderer) so every existing example keeps
# its exact current behaviour with zero source changes.
pub def execute_software(scene: Scene, c: Canvas, fonts: Fonts, r: Renderer) -> void:
    exec_cmds(scene, 0, c, fonts, r)

# Proposal v4 / nebula1.0 Phase 2 (clipping): processes commands starting at
# `start`, painting through `active`, until either the list ends or a
# clip_pop closes an enclosing push (the CALLER's own, if this call is
# itself nested inside one) -- returns the index of the first unprocessed
# command. RECURSION, not an explicit stack: Canvas is an INTERFACE, and
# Tauraro's generic List[T]/Array[T] storage is a raw void*-based slot that
# cannot hold an interface's fat-pointer representation directly (confirmed
# by trying it -- `List[Canvas]` fails to compile, "incompatible type...
# expected 'void *' but argument is of type 'Canvas_obj'"). Each nesting
# level's own `active` is a plain function PARAMETER instead, never
# collection-stored, which sidesteps that entirely. A recursive FREE
# FUNCTION returning non-void is the proven-safe shape on freestanding
# targets (see hit_test's own comment: the hang is specific to a private
# recursive METHOD returning str, not recursion or a non-void return in
# general), and nesting depth is already bounded by toolkit.ui.ast's
# max_depth() -- the same cap that bounded how deeply emit() could have
# nested these pushes to begin with.
def exec_cmds(scene: Scene, start: int, active: Canvas, fonts: Fonts, r: Renderer) -> int:
    mut i = start
    while i < len(scene.cmds):
        mut cmd = scene.cmds[i]
        if cmd.kind == cmd_rounded_rect():
            # nebula1.0 Phase 2: opacity. Only honoured for a PLAIN rect
            # (radius<=0) -- paint_rounded_rect_aa's antialiased corners
            # blend per-pixel toward `ambient` via set_pixel, which has no
            # alpha parameter at all, so real translucency there would need
            # those corner blends to ALSO factor in destination alpha, not
            # attempted yet. A rounded+opaque rect (the overwhelmingly
            # common case) is unaffected either way -- alpha==255 always
            # takes this same paint_rounded_rect_aa path it always did.
            if cmd.alpha < 255 and cmd.radius <= 0:
                active.fill_rect_alpha(cmd.x, cmd.y, cmd.w, cmd.h, cmd.fill, cmd.alpha)
            else:
                r.rounded_rect(active, cmd.x, cmd.y, cmd.w, cmd.h, cmd.radius, cmd.fill, cmd.ambient)
            i = i + 1
        elif cmd.kind == cmd_rounded_box():
            r.rounded_box(active, cmd.x, cmd.y, cmd.w, cmd.h, cmd.radius, cmd.border_w, cmd.fill, cmd.stroke, cmd.ambient)
            i = i + 1
        elif cmd.kind == cmd_text():
            r.text(active, fonts.pick(cmd.font_size), cmd.text, cmd.x, cmd.y, cmd.fill, cmd.ambient)
            i = i + 1
        elif cmd.kind == cmd_circle():
            r.circle(active, cmd.x, cmd.y, cmd.radius, cmd.fill, cmd.ambient)
            i = i + 1
        elif cmd.kind == cmd_circle_ring():
            r.circle_ring(active, cmd.x, cmd.y, cmd.radius, cmd.border_w, cmd.fill, cmd.stroke, cmd.ambient)
            i = i + 1
        elif cmd.kind == cmd_clip_push():
            mut next_active: Canvas = clip_canvas(active, cmd.x, cmd.y, cmd.w, cmd.h)
            i = exec_cmds(scene, i + 1, next_active, fonts, r)
        elif cmd.kind == cmd_clip_pop():
            return i + 1
        else:
            i = i + 1
    return i

# Proposal v4 step I: like execute_software, but skips any command that's
# identical to the SAME position in `prev` -- the pixels it would paint are
# already on the canvas from last frame, since render_diff() (the only
# caller) never lets the canvas be cleared between calls. Caller must have
# already confirmed scenes_diffable(prev, curr) (same command count); this
# does not re-check it, so an out-of-bounds prev.cmds[i] is a caller bug,
# not a runtime possibility it needs to defend against here.
#
# KNOWN LIMITATION, not yet reachable: a changed TEXT command repaints only
# the new string's own pixels, over whatever the old string already painted
# -- correct as long as the new text is at least as wide as the old text
# (true for every current use: hover/press only ever changes a command's
# COLOR fields, never .text), but would leave stray pixels ("ghosting") from
# a wider old string if text content itself ever became dynamic per frame.
# Cmd.label() always sets w=0/h=0 (labels aren't boxes), so there's no
# stored width to clear even if this needed to. Revisit when proposal step F
# (node identity + state) lands real per-frame-changing text content.
pub def execute_diff(prev: Scene, curr: Scene, c: Canvas, fonts: Fonts, r: Renderer) -> void:
    mut i = 0
    while i < len(curr.cmds):
        mut cmd = curr.cmds[i]
        mut prev_cmd = prev.cmds[i]
        if not cmd_eq(prev_cmd, cmd):
            if cmd.kind == cmd_rounded_rect():
                # nebula1.0 Phase 2: same opacity scope as exec_cmds
                # (execute_software's own helper) -- see its comment.
                if cmd.alpha < 255 and cmd.radius <= 0:
                    c.fill_rect_alpha(cmd.x, cmd.y, cmd.w, cmd.h, cmd.fill, cmd.alpha)
                else:
                    paint_rounded_rect_aa(c, cmd.x, cmd.y, cmd.w, cmd.h, cmd.radius, cmd.fill, cmd.ambient)
            elif cmd.kind == cmd_rounded_box():
                paint_rounded_box_aa(c, cmd.x, cmd.y, cmd.w, cmd.h, cmd.radius, cmd.border_w, cmd.fill, cmd.stroke, cmd.ambient)
            elif cmd.kind == cmd_text():
                draw_text(c, fonts.pick(cmd.font_size), cmd.text, cmd.x, cmd.y, cmd.fill, cmd.ambient)
            elif cmd.kind == cmd_circle():
                r.circle(c, cmd.x, cmd.y, cmd.radius, cmd.fill, cmd.ambient)
            elif cmd.kind == cmd_circle_ring():
                r.circle_ring(c, cmd.x, cmd.y, cmd.radius, cmd.border_w, cmd.fill, cmd.stroke, cmd.ambient)
        i = i + 1
