# toolkit.ui.style — the Tailwind utility vocabulary, and the resolution cache.
#
# The whole point of resolving styles at runtime rather than at compile time is
# that a class string no longer has to be a literal the compiler can see. The
# cost of that freedom is a parse per string, and the cache is what makes the
# cost land once per unique string instead of once per node per frame.
#
# ## The scale changed on 2026-09-06 -- read this before editing any .ui file
#
# Class numbers are now Tailwind SCALE STEPS, not pixel counts. `p-4` is 16px
# (4 steps x 4px), where it used to mean 4px. Every number in every existing
# .ui file was migrated in the same commit that made this change. The
# arithmetic all lives in toolkit.ui.scale; this module only decides which
# Style field a given prefix targets.
#
# For a literal pixel count, use Tailwind's own arbitrary-value syntax:
# `w-[460px]`. That is what the old `w-460` became.
#
# ## What is deliberately NOT implemented
#
# Tokens whose CSS property this renderer has no concept of are ignored, the
# same way a typo is -- silently, because UI content can arrive from outside
# the build and must never be able to halt the renderer. Notably:
#
#   text-{xs,sm,lg,...}  font sizes. The toolkit has exactly one baked bitmap
#                        font at 8x14 (toolkit/text/); a second size means a
#                        second atlas, not a style token.
#   shadow-*, opacity-*  need an alpha channel Canvas does not have (see
#                        RASTERIZER.md 0 for why that is a deliberate
#                        constraint, not an oversight).
#   rounded-t-*, etc.    per-corner radii. The rasterizer takes one radius per
#                        box (paint_rounded_box_aa).
#   flex-*-reverse       the layout engine places children in list order only.
#   absolute/fixed/z-*   there is no positioning model beyond flex flow.
#
# Adding any of those is an engine change first and a token second.
#
# ## Reserved for markup-tag widgets, not this file's vocabulary
#
# `checked`, `on`, `selected`, `group-NAME`, `min-N`, `max-N`, `value-N` are
# meaningful only on `<checkbox>`/`<switch>`/`<radio>`/`<slider>`/`<progress>`
# tags (see toolkit/ui/widget_tags.tr) -- they ride the SAME class string
# every tag already has, parsed by a completely separate, independent pass
# (`resolve_widget()` below) into `WidgetTokens`, never into `Style`. This
# file's own `apply_utility` already ignores them like any other unrecognized
# token, so there is no runtime collision even if a future Style token
# happened to reuse one of these prefixes -- noted here so a future reader
# doesn't wonder whether `min-4` on a `<slider>` means something CSS-`min-`-
# width-like; it doesn't, Style never sees it as anything.

from toolkit.types import rgb
from toolkit.ui.palette import color_shade, no_color
from toolkit.ui.scale import no_px, spacing_px, radius_px, border_px
from toolkit.ui.widget_tags import WidgetTokens, parse_widget_tokens
from toolkit.ui.scale import fraction_num, fraction_den, strip_brackets, arbitrary_px
from string.str import Str

pub def dir_row() -> int:
    return 0

pub def dir_col() -> int:
    return 1

# Proposal v4 step E. A grid container ignores `justify`/`align`/`grow` (the
# flex-only distribution model) and instead wraps children into `grid_cols`
# equal-width columns, row-major, with each row's height fit to its tallest
# child -- see toolkit/layout/flex.tr's measure_grid/place_grid.
pub def dir_grid() -> int:
    return 2

# nebula1.0 Phase 2: the SAME three numbers toolkit.text.font's
# font_size_sm()/_base()/_lg() use -- re-declared here rather than
# imported, the same reason toolkit.ui.palette.no_color()'s own comment
# gives for unset() a few lines below: this file cannot import
# toolkit.text.font without risking a cycle (font.tr is reached from
# toolkit.ui.interp, which already imports this file), so both sides just
# agree on the same literal values instead.
pub def font_size_sm() -> int:
    return 0

pub def font_size_base() -> int:
    return 1

pub def font_size_lg() -> int:
    return 2

# nebula1.0 Phase 4: a 4th, app-baked slot -- see toolkit.text.font's
# Fonts.set_custom()/has_custom for the loading side of this. Only ever
# meaningful for an app that baked one via `font = ...` in nebula.conf;
# `text-custom` on a page that didn't falls back to base the same way
# Fonts.pick() already degrades any unrecognized size.
pub def font_size_custom() -> int:
    return 3

# Alignment values, shared by both axes -- `justify` positions children along
# the main axis, `align` along the cross axis, exactly as CSS flexbox does.
# `align_stretch` is cross-axis only (a child with no explicit cross size
# fills the parent's content box) and is the default, which is why it is
# listed first: it preserves the behavior every existing .ui file was written
# against, so adding these tokens changed nothing that didn't ask for it.
pub def align_stretch() -> int:
    return 0

pub def align_start() -> int:
    return 1

pub def align_center() -> int:
    return 2

pub def align_end() -> int:
    return 3

pub def align_between() -> int:
    return 4

pub def align_around() -> int:
    return 5

pub def align_evenly() -> int:
    return 6

pub def unset() -> int:
    # Sentinel for "this property was never set by any token". Distinguishable
    # from a legitimate 0 (a zero-width box) and from black (0x000000).
    # MUST equal toolkit.ui.palette.no_color(); that module cannot import this
    # one (Tauraro rejects circular imports) so it re-declares the value.
    return 0 - 1

pub class Style:
    pub dir:      int
    # Padding is per-side. `p-4` sets all four; `px-4`/`pt-4` set subsets.
    pub pad_t:    int
    pub pad_r:    int
    pub pad_b:    int
    pub pad_l:    int
    # Margins, same shape. Negative values are legal (`-mt-4`), which is why
    # nothing here clamps at zero.
    pub mar_t:    int
    pub mar_r:    int
    pub mar_b:    int
    pub mar_l:    int
    # Gap is per-axis (`gap-x-4` / `gap-y-4`); `gap-4` sets both. Only the one
    # matching the box's own direction is ever read, but both are carried so a
    # single class string can serve rows and columns.
    pub gap_x:    int
    pub gap_y:    int
    pub w:        int
    pub h:        int
    # nebula1.0 Phase 3 (gradients): a second background color -- unset() (the
    # same sentinel `bg` already uses) means "no gradient, `bg` is a flat
    # fill", exactly like `border`'s own unset()-means-none convention. Only
    # meaningful when `bg` is ALSO set: `bg` is the gradient's start color,
    # `bg2` its end color. See `grad_dir` for the axis.
    pub bg2:      int
    # 0 = horizontal (left->right), 1 = vertical (top->bottom), 2 = diagonal
    # (top-left->bottom-right). Meaningless unless `bg2` is set.
    pub grad_dir: int
    # Fractional sizing (`w-1/2`, `w-full`), kept as numerator/denominator and
    # resolved against the parent's content box at layout time. Denominator 0
    # means "not set" -- see toolkit.ui.scale for why this is a fraction and
    # not a percentage.
    pub w_num:    int
    pub w_den:    int
    pub h_num:    int
    pub h_den:    int
    pub grow:     int
    pub bg:       int
    pub fg:       int
    pub border:   int   # unset() = no border, matching bg's sentinel convention
    pub border_w: int   # px; a set border color with border_w==0 paints nothing
    pub radius:   int   # px corner radius, 0 = square corners
    pub justify:  int   # main-axis distribution  (justify-*)
    pub align:    int   # cross-axis alignment    (items-*)
    # Proposal v4 step E: column count for a `dir_grid()` container
    # (`grid-cols-N`). Meaningless for row/col direction. 0 = not set;
    # toolkit.layout.flex's measure_grid/place_grid treat anything < 1 as 1
    # column, the same "malformed input degrades safely" policy as the rest
    # of this file.
    pub grid_cols: int
    # Proposal v4 step F: explicit node identity (`key-<name>`). "" means
    # "no explicit key" -- toolkit.layout.flex's build() falls back to a
    # structural (tree-position) key in that case. An explicit key is what
    # keeps identity (and therefore state) attached to the right logical
    # item when a list of otherwise-identical siblings gets reordered; see
    # that file's own comment on build() for the full mechanism.
    pub key: str
    # nebula1.0 Phase 2: `clip` -- this box's own painted rect becomes an
    # "overflow: hidden" boundary for everything painted inside it (its own
    # background/border are NOT clipped by this, only its CHILDREN -- same
    # as CSS). See toolkit/render/clipped_canvas.tr for the mechanism.
    pub clip: bool
    # nebula1.0 Phase 3: `shadow` -- a soft drop shadow behind this box's own
    # fill, the "elevated card" look. See toolkit.ui.interp's emit() for the
    # actual paint (a few offset, increasingly pale solid rounded_rects,
    # not a real blur -- there is no alpha-blended-rounded-shape primitive
    # on the CPU path yet, see Style.opacity_pct's own note on that same
    # gap, so this fakes softness with flat layers instead).
    pub shadow: bool
    # nebula1.0 Phase 2: `opacity-N` (0-100, tailwind-style percent, NOT
    # this file's usual 4x spacing scale -- opacity has no natural "unit"
    # to scale). 100 = fully opaque, the default. Only honoured for a
    # box's own plain (radius<=0, no border) fill today -- see
    # toolkit.ui.interp.execute_software's own comment on why rounded/
    # bordered opacity isn't attempted yet.
    pub opacity_pct: int
    # nebula1.0 Phase 2: `text-sm` / `text-base` / `text-lg` -- which of
    # the three baked font atlases (toolkit/text/font.tr's font_size_sm()/
    # _base()/_lg(), the SAME three numbers) this node's own text (or a
    # text-node CHILD's text) renders at. Applies per text NODE, not
    # inherited down the tree like CSS font-size would be -- see
    # toolkit.layout.flex's measure()/place() and toolkit.ui.interp's
    # emit() for where this is actually read; a container node setting it
    # has no visible effect unless it IS the text node.
    pub font_size: int
    # nebula1.0 Phase 4: `overlay` -- the one positioning model beyond flex
    # flow this file's own header used to say didn't exist (see that
    # comment, now stale for this one case). A box with `overlay` set is
    # skipped by its PARENT's flow cursor entirely (siblings position as
    # if it weren't there, same idea CSS `position:absolute` has) but is
    # still measured and placed -- centered on the whole page by default,
    # or at an explicit pixel position if `x-N`/`y-N` were given -- and
    # painted in a SEPARATE FINAL PASS after the rest of the tree, so its
    # `Cmd`s land LAST in the `Scene` regardless of where in the markup it
    # sits (paint order IS `Scene` order -- see toolkit.render.scene's own
    # header). See toolkit.layout.flex's measure()/place() and
    # toolkit.ui.interp's emit()/build_scene() for the actual mechanism.
    pub overlay: bool
    # unset() (the default) means "center the overlay on the page"; an
    # explicit `x-N`/`y-N` token pair means "this exact pixel position
    # instead", both axes independent (only giving `x-N` still centers
    # vertically, and vice versa).
    pub overlay_x: int
    pub overlay_y: int

extend Style:
    pub def default() -> Style:
        mut s = Style()
        s.dir      = dir_row()
        s.pad_t    = 0
        s.pad_r    = 0
        s.pad_b    = 0
        s.pad_l    = 0
        s.mar_t    = 0
        s.mar_r    = 0
        s.mar_b    = 0
        s.mar_l    = 0
        s.gap_x    = 0
        s.gap_y    = 0
        s.w        = unset()
        s.h        = unset()
        s.bg2      = unset()
        s.grad_dir = 0
        s.w_num    = 0
        s.w_den    = 0
        s.h_num    = 0
        s.h_den    = 0
        s.grow     = 0
        s.bg       = unset()
        s.fg       = 0xE6E6E6
        s.border   = unset()
        s.border_w = 0
        s.radius   = 0
        s.justify  = align_start()
        s.align    = align_stretch()
        s.grid_cols = 0
        s.key      = ""
        s.clip     = false
        s.shadow   = false
        s.opacity_pct = 100
        s.font_size = font_size_base()
        s.overlay  = false
        s.overlay_x = unset()
        s.overlay_y = unset()
        return s

    pub def copy(self) -> Style:
        mut s = Style()
        s.dir      = self.dir
        s.pad_t    = self.pad_t
        s.pad_r    = self.pad_r
        s.pad_b    = self.pad_b
        s.pad_l    = self.pad_l
        s.mar_t    = self.mar_t
        s.mar_r    = self.mar_r
        s.mar_b    = self.mar_b
        s.mar_l    = self.mar_l
        s.gap_x    = self.gap_x
        s.gap_y    = self.gap_y
        s.w        = self.w
        s.h        = self.h
        s.bg2      = self.bg2
        s.grad_dir = self.grad_dir
        s.w_num    = self.w_num
        s.w_den    = self.w_den
        s.h_num    = self.h_num
        s.h_den    = self.h_den
        s.grow     = self.grow
        s.bg       = self.bg
        s.fg       = self.fg
        s.border   = self.border
        s.border_w = self.border_w
        s.radius   = self.radius
        s.justify  = self.justify
        s.align    = self.align
        s.grid_cols = self.grid_cols
        s.key      = self.key
        s.clip     = self.clip
        s.shadow   = self.shadow
        s.opacity_pct = self.opacity_pct
        s.font_size = self.font_size
        s.overlay  = self.overlay
        s.overlay_x = self.overlay_x
        s.overlay_y = self.overlay_y
        return s

    pub def to_str(self) -> str:
        return "Style(dir=" + self.dir.to_str() + " pad=" + self.pad_t.to_str() + "," + self.pad_r.to_str() + "," + self.pad_b.to_str() + "," + self.pad_l.to_str() + " gap=" + self.gap_x.to_str() + "/" + self.gap_y.to_str() + " w=" + self.w.to_str() + " h=" + self.h.to_str() + " grow=" + self.grow.to_str() + " bg=" + self.bg.to_str() + " bg2=" + self.bg2.to_str() + " grad_dir=" + self.grad_dir.to_str() + " border=" + self.border.to_str() + " bw=" + self.border_w.to_str() + " radius=" + self.radius.to_str() + " justify=" + self.justify.to_str() + " align=" + self.align.to_str() + " grid_cols=" + self.grid_cols.to_str() + " key=" + self.key + " clip=" + self.clip.to_str() + " shadow=" + self.shadow.to_str() + " opacity_pct=" + self.opacity_pct.to_str() + " font_size=" + self.font_size.to_str() + ")"

def hex_digit_val(c: str) -> int:
    if c == "0": return 0
    if c == "1": return 1
    if c == "2": return 2
    if c == "3": return 3
    if c == "4": return 4
    if c == "5": return 5
    if c == "6": return 6
    if c == "7": return 7
    if c == "8": return 8
    if c == "9": return 9
    if c == "a": return 10
    if c == "A": return 10
    if c == "b": return 11
    if c == "B": return 11
    if c == "c": return 12
    if c == "C": return 12
    if c == "d": return 13
    if c == "D": return 13
    if c == "e": return 14
    if c == "E": return 14
    if c == "f": return 15
    if c == "F": return 15
    return 0 - 1

# Arbitrary colors: exactly 6 hex digits (RRGGBB, no leading '#' -- the caller
# strips that). Same typo policy as everything else here: anything malformed
# resolves to the sentinel rather than a wrong color or a fatal error.
pub def parse_hex_color(s: str) -> int:
    if Str.len(s) != 6:
        return unset()
    mut v = 0
    mut i = 0
    while i < 6:
        mut d = hex_digit_val(Str.slice(s, i, i + 1))
        if d < 0:
            return unset()
        v = v * 16 + d
        i = i + 1
    return v

# Names that are NOT in the Tailwind palette but that UI authors reach for by
# habit, kept as a nebula extension. "steel" and "mist" predate the Tailwind
# port and are retained so class strings written before 2026-09-06 still
# resolve; everything else here is a convenience alias with no Tailwind
# equivalent. Prefer the real scale (bg-slate-700) in new markup -- these have
# no shades and cannot be tuned.
pub def extension_color(name: str) -> int:
    if name == "steel":
        return 0x334155
    if name == "mist":
        return 0x94A3B8
    if name == "grey":
        return 0x6B7280
    if name == "navy":
        return 0x1E3A8A
    if name == "maroon":
        return 0x7F1D1D
    if name == "brown":
        return 0x78350F
    if name == "gold":
        return 0xCA8A04
    if name == "silver":
        return 0xD1D5DB
    if name == "charcoal":
        return 0x27272A
    if name == "crimson":
        return 0xDC2626
    if name == "turquoise":
        return 0x06B6D4
    if name == "magenta":
        return 0xD946EF
    if name == "olive":
        return 0x65A30D
    return unset()

# Resolves the part of a color token after its prefix -- "blue-500",
# "[#1e293b]", "#1e293b", "white", "slate" -- to a packed color. One place
# that bg-/text-/border- all share.
#
# A bare hue with no shade means shade 500, which is the conceptual default
# even though real Tailwind requires the number. Note this CHANGED the meaning
# of three legacy names on 2026-09-06: bg-slate used to be 0x1E293B (which is
# slate-800) and is now slate-500. Every .ui file and markup string in the
# repo was migrated to spell the shade explicitly in the same commit.
pub def resolve_color_token(name: str) -> int:
    mut raw = name
    mut inner = strip_brackets(name)
    if inner != "":
        raw = inner

    if Str.starts_with(raw, "#"):
        return parse_hex_color(Str.slice(raw, 1, Str.len(raw)))

    if raw == "white":
        return 0xFFFFFF
    if raw == "black":
        return 0x000000
    # No alpha channel anywhere in Canvas, so "transparent" can only mean
    # "paint nothing", which is exactly what the unset sentinel already means.
    if raw == "transparent":
        return unset()

    mut dash = Str.index_of(raw, "-")
    if dash > 0:
        mut hue = Str.slice(raw, 0, dash)
        mut sh = Str.slice(raw, dash + 1, Str.len(raw))
        if Str.is_digit(sh):
            mut c = color_shade(hue, Str.parse_int(sh))
            if c != no_color():
                return c
        return unset()

    mut bare = color_shade(raw, 500)
    if bare != no_color():
        return bare
    return extension_color(raw)

# True when token begins with prefix; after() returns what follows it. Two
# one-line helpers rather than inlining Str.slice arithmetic thirty times
# below, where an off-by-one would be invisible.
def has(token: str, prefix: str) -> bool:
    return Str.starts_with(token, prefix)

def after(token: str, prefix: str) -> str:
    return Str.slice(token, Str.len(prefix), Str.len(token))

# Proposal v4 step E: grid direction + column count. A separate function
# rather than folded into apply_flex_token, per this file's own __chkstk
# lesson above -- a new token family is a new function, not a sixth family
# inlined into an existing one.
def apply_grid_token(s: Style, token: str) -> bool:
    if token == "grid":
        s.dir = dir_grid()
        return true
    if has(token, "grid-cols-"):
        mut v = after(token, "grid-cols-")
        if Str.is_digit(v):
            s.grid_cols = Str.parse_int(v)
        return true
    return false

# Proposal v4 step F: explicit node identity (`key-<name>`). A separate
# function for the same __chkstk reason apply_grid_token is: a new token
# family is a new function, not another branch folded into an existing one.
def apply_key_token(s: Style, token: str) -> bool:
    if has(token, "key-"):
        s.key = after(token, "key-")
        return true
    return false

# nebula1.0 Phase 2: `clip` -- see Style.clip's own field comment.
def apply_clip_token(s: Style, token: str) -> bool:
    if token == "clip":
        s.clip = true
        return true
    return false

# nebula1.0 Phase 3: `shadow` -- see Style.shadow's own field comment.
def apply_shadow_token(s: Style, token: str) -> bool:
    if token == "shadow":
        s.shadow = true
        return true
    return false

# nebula1.0 Phase 4: `overlay` + its `x-N`/`y-N` pixel-offset pair -- see
# Style.overlay's own field comment. `x-N`/`y-N` are harmless on a box
# that never set `overlay` (silently ignored, same "unrecognized token"
# policy this whole file already has), so there's no ordering requirement
# between them and the `overlay` token itself within one class string.
def apply_overlay_token(s: Style, token: str) -> bool:
    if token == "overlay":
        s.overlay = true
        return true
    if has(token, "x-"):
        mut vx = after(token, "x-")
        if Str.is_digit(vx):
            s.overlay_x = Str.parse_int(vx)
        return true
    if has(token, "y-"):
        mut vy = after(token, "y-")
        if Str.is_digit(vy):
            s.overlay_y = Str.parse_int(vy)
        return true
    return false

# nebula1.0 Phase 2: `opacity-N` -- see Style.opacity_pct's own field
# comment. Malformed/out-of-range values clamp rather than error, this
# file's usual policy: a typo must never crash the renderer.
def apply_opacity_token(s: Style, token: str) -> bool:
    if has(token, "opacity-"):
        mut v = after(token, "opacity-")
        if Str.is_digit(v):
            mut pct = Str.parse_int(v)
            if pct < 0: pct = 0
            if pct > 100: pct = 100
            s.opacity_pct = pct
        return true
    return false

# nebula1.0 Phase 2: `text-sm`/`text-base`/`text-lg` -- see
# Style.font_size's own field comment. An unrecognized `text-*` value
# (a typo, or a not-yet-supported size) leaves font_size at whatever it
# already was rather than guessing -- same "malformed input degrades
# safely" policy as the rest of this file, and here specifically it means
# a typo renders at the STILL-CORRECT default size rather than some
# arbitrary fallback.
def apply_font_size_token(s: Style, token: str) -> bool:
    if token == "text-sm":
        s.font_size = font_size_sm()
        return true
    if token == "text-base":
        s.font_size = font_size_base()
        return true
    if token == "text-lg":
        s.font_size = font_size_lg()
        return true
    if token == "text-custom":
        s.font_size = font_size_custom()
        return true
    return false

def set_pad_all(s: Style, v: int) -> void:
    s.pad_t = v
    s.pad_r = v
    s.pad_b = v
    s.pad_l = v

def set_mar_all(s: Style, v: int) -> void:
    s.mar_t = v
    s.mar_r = v
    s.mar_b = v
    s.mar_l = v

# Fractional sizing, shared by w-* and h-*. Returns true if the suffix was a
# fraction (1/2, full) and wrote num/den; the caller then knows not to also
# try the absolute scale.
def apply_fraction_w(s: Style, v: str) -> bool:
    mut n = fraction_num(v)
    if n < 0:
        return false
    s.w_num = n
    s.w_den = fraction_den(v)
    s.w = unset()
    return true

def apply_fraction_h(s: Style, v: str) -> bool:
    mut n = fraction_num(v)
    if n < 0:
        return false
    s.h_num = n
    s.h_den = fraction_den(v)
    s.h = unset()
    return true


# ## Why this is five functions and not one
#
# apply_utility was originally a single long if/elif chain. It compiled and
# ran fine on every hosted tier, and failed to LINK on UEFI:
#
#   lld-link: undefined symbol: __chkstk   (referenced by apply_utility)
#
# __chkstk is the Microsoft x64 ABI's stack-probe helper. A compiler emits a
# call to it for any function whose stack frame exceeds one 4KB page, so that
# the guard page is touched in order; UEFI shares the Microsoft x64 ABI (it is
# PE/COFF) but is freestanding, so nothing provides the helper. Every `mut`
# in every branch of that chain got its own frame slot, and forty-odd of them
# crossed the page.
#
# Splitting the chain by token family keeps each frame well under a page, and
# is the shape the code wanted anyway. Each helper returns whether it consumed
# the token, so apply_utility reads as a dispatch list.
#
# Keep this in mind before merging these back together or adding a sixth
# family inline: the failure is a link error on one tier only, long after the
# code looks correct everywhere else.

# Direction, flex, alignment. No spacing values, so no scale lookups.
def apply_flex_token(s: Style, token: str) -> bool:
    if token == "flex-row":
        s.dir = dir_row()
        return true
    if token == "flex-col":
        s.dir = dir_col()
        return true
    if token == "grow":
        s.grow = 1
        return true
    if token == "grow-0":
        s.grow = 0
        return true
    # flex-1 in CSS is grow + shrink + basis-0. There is no shrink here, so it
    # collapses to grow -- the visible result matches for the common case of
    # children that already fit.
    if token == "flex-1":
        s.grow = 1
        return true

    if token == "justify-start":
        s.justify = align_start()
        return true
    if token == "justify-center":
        s.justify = align_center()
        return true
    if token == "justify-end":
        s.justify = align_end()
        return true
    if token == "justify-between":
        s.justify = align_between()
        return true
    if token == "justify-around":
        s.justify = align_around()
        return true
    if token == "justify-evenly":
        s.justify = align_evenly()
        return true

    if token == "items-stretch":
        s.align = align_stretch()
        return true
    if token == "items-start":
        s.align = align_start()
        return true
    if token == "items-center":
        s.align = align_center()
        return true
    if token == "items-end":
        s.align = align_end()
        return true
    # No per-box baseline metric is tracked (every glyph cell is the same
    # height), so baseline and start are the same picture here.
    if token == "items-baseline":
        s.align = align_start()
        return true
    return false

# Radius and border. Border width is tried before border color: the width
# suffixes are a closed set of four numbers plus a bracketed literal, none of
# which can collide with a hue name, so the order is unambiguous.
def apply_edge_token(s: Style, token: str) -> bool:
    if token == "rounded":
        s.radius = radius_px("")
        return true
    if has(token, "rounded-"):
        mut rv = radius_px(after(token, "rounded-"))
        if rv != no_px():
            s.radius = rv
        return true
    if token == "border":
        s.border_w = border_px("")
        return true
    if has(token, "border-"):
        mut bv = after(token, "border-")
        mut bw = border_px(bv)
        if bw != no_px():
            s.border_w = bw
            return true
        mut bc = resolve_color_token(bv)
        if bc != unset():
            s.border = bc
        return true
    return false

# Padding, margin and gap -- everything that reads the spacing scale. One
# local `v` reused by every branch, deliberately: see the __chkstk note above.
def apply_spacing_token(s: Style, token: str) -> bool:
    mut v = no_px()

    if has(token, "px-"):
        v = spacing_px(after(token, "px-"))
        if v != no_px():
            s.pad_l = v
            s.pad_r = v
        return true
    if has(token, "py-"):
        v = spacing_px(after(token, "py-"))
        if v != no_px():
            s.pad_t = v
            s.pad_b = v
        return true
    if has(token, "pt-"):
        v = spacing_px(after(token, "pt-"))
        if v != no_px():
            s.pad_t = v
        return true
    if has(token, "pr-"):
        v = spacing_px(after(token, "pr-"))
        if v != no_px():
            s.pad_r = v
        return true
    if has(token, "pb-"):
        v = spacing_px(after(token, "pb-"))
        if v != no_px():
            s.pad_b = v
        return true
    if has(token, "pl-"):
        v = spacing_px(after(token, "pl-"))
        if v != no_px():
            s.pad_l = v
        return true
    # ps-/pe- are the CSS logical (start/end) properties. This renderer is
    # left-to-right only, so they are plain aliases for pl-/pr-.
    if has(token, "ps-"):
        v = spacing_px(after(token, "ps-"))
        if v != no_px():
            s.pad_l = v
        return true
    if has(token, "pe-"):
        v = spacing_px(after(token, "pe-"))
        if v != no_px():
            s.pad_r = v
        return true
    if has(token, "p-"):
        v = spacing_px(after(token, "p-"))
        if v != no_px():
            set_pad_all(s, v)
        return true

    if has(token, "mx-"):
        v = spacing_px(after(token, "mx-"))
        if v != no_px():
            s.mar_l = v
            s.mar_r = v
        return true
    if has(token, "my-"):
        v = spacing_px(after(token, "my-"))
        if v != no_px():
            s.mar_t = v
            s.mar_b = v
        return true
    if has(token, "mt-"):
        v = spacing_px(after(token, "mt-"))
        if v != no_px():
            s.mar_t = v
        return true
    if has(token, "mr-"):
        v = spacing_px(after(token, "mr-"))
        if v != no_px():
            s.mar_r = v
        return true
    if has(token, "mb-"):
        v = spacing_px(after(token, "mb-"))
        if v != no_px():
            s.mar_b = v
        return true
    if has(token, "ml-"):
        v = spacing_px(after(token, "ml-"))
        if v != no_px():
            s.mar_l = v
        return true
    if has(token, "m-"):
        v = spacing_px(after(token, "m-"))
        if v != no_px():
            set_mar_all(s, v)
        return true

    if has(token, "gap-x-"):
        v = spacing_px(after(token, "gap-x-"))
        if v != no_px():
            s.gap_x = v
        return true
    if has(token, "gap-y-"):
        v = spacing_px(after(token, "gap-y-"))
        if v != no_px():
            s.gap_y = v
        return true
    if has(token, "gap-"):
        v = spacing_px(after(token, "gap-"))
        if v != no_px():
            s.gap_x = v
            s.gap_y = v
        return true
    return false

# Width, height and the size- shorthand.
def apply_size_token(s: Style, token: str) -> bool:
    mut v = no_px()

    # size-4 is the shorthand for equal width and height.
    if has(token, "size-"):
        v = spacing_px(after(token, "size-"))
        if v != no_px():
            s.w = v
            s.h = v
        return true

    if has(token, "w-"):
        mut wv = after(token, "w-")
        if wv == "auto":
            s.w = unset()
            s.w_den = 0
            return true
        # w-screen is the viewport width. The root box already fills the
        # viewport, so "fill my parent" is the same picture at every depth
        # this renderer can express.
        if wv == "screen":
            apply_fraction_w(s, "full")
            return true
        if apply_fraction_w(s, wv):
            return true
        v = spacing_px(wv)
        if v != no_px():
            s.w = v
            s.w_den = 0
        return true

    if has(token, "h-"):
        mut hv = after(token, "h-")
        if hv == "auto":
            s.h = unset()
            s.h_den = 0
            return true
        if hv == "screen":
            apply_fraction_h(s, "full")
            return true
        if apply_fraction_h(s, hv):
            return true
        v = spacing_px(hv)
        if v != no_px():
            s.h = v
            s.h_den = 0
        return true
    return false

def apply_color_family_token(s: Style, token: str) -> bool:
    if has(token, "bg-"):
        mut c = resolve_color_token(after(token, "bg-"))
        if c != unset():
            s.bg = c
        return true
    if has(token, "text-"):
        mut c = resolve_color_token(after(token, "text-"))
        if c != unset():
            s.fg = c
        return true
    return false

# nebula1.0 Phase 3 (gradients): `to-<color>` sets the gradient's end color
# (`bg-<color>` is already its start), `bg-gradient-r`/`-b`/`-br` picks the
# axis. A separate function rather than folded into apply_color_family_token,
# same __chkstk stack-frame-size reason apply_grid_token/apply_key_token
# already are their own functions (this file's header above apply_flex_token
# explains the rule). A panel only actually gradient-fills once `bg2` is set
# AND `bg` (the start color) is also set -- see toolkit.ui.interp's emit(),
# which checks `bg2 != unset()` before ever reading `grad_dir`.
def apply_gradient_token(s: Style, token: str) -> bool:
    if has(token, "to-"):
        mut c = resolve_color_token(after(token, "to-"))
        if c != unset():
            s.bg2 = c
        return true
    if token == "bg-gradient-r":
        s.grad_dir = 0
        return true
    if token == "bg-gradient-b":
        s.grad_dir = 1
        return true
    if token == "bg-gradient-br":
        s.grad_dir = 2
        return true
    return false

# Apply one utility token to a style, in place. Unknown tokens are ignored
# rather than fatal: UI content can arrive from outside the build, and a typo
# in a class string must never be able to halt the renderer. See this file's
# header for the tokens that are ignored ON PURPOSE because the renderer has
# no such concept.
pub def apply_utility(s: Style, token: str) -> void:
    if token == "":
        return

    # Negative margins (-m-4, -mt-4, ...) re-enter with the sign stripped and
    # then flip whatever the recursive call wrote, so the seven margin
    # prefixes are spelled once rather than twice.
    if has(token, "-"):
        mut body = after(token, "-")
        if has(body, "m"):
            mut b_t = s.mar_t
            mut b_r = s.mar_r
            mut b_b = s.mar_b
            mut b_l = s.mar_l
            apply_utility(s, body)
            s.mar_t = b_t - (s.mar_t - b_t)
            s.mar_r = b_r - (s.mar_r - b_r)
            s.mar_b = b_b - (s.mar_b - b_b)
            s.mar_l = b_l - (s.mar_l - b_l)
        return

    if apply_key_token(s, token):
        return
    if apply_gradient_token(s, token):
        return
    if apply_clip_token(s, token):
        return
    if apply_shadow_token(s, token):
        return
    if apply_overlay_token(s, token):
        return
    if apply_opacity_token(s, token):
        return
    if apply_font_size_token(s, token):
        return
    if apply_grid_token(s, token):
        return
    if apply_flex_token(s, token):
        return
    if apply_edge_token(s, token):
        return
    if apply_spacing_token(s, token):
        return
    if apply_size_token(s, token):
        return
    if apply_color_family_token(s, token):
        return

# nebula1.0 Phase 3 (responsive breakpoints): the same 3 numbers Tailwind
# itself uses, so the mental model transfers exactly for anyone who's used
# it -- `sm:`/`md:`/`lg:` prefix ANY existing utility token
# (`md:flex-row`) and it only applies once the viewport is at least that
# wide (mobile-first, matching Tailwind's own `min-width` semantics: a
# `md:` token stays active at `lg` widths too).
pub def breakpoint_sm() -> int:
    return 640

pub def breakpoint_md() -> int:
    return 1024

pub def breakpoint_lg() -> int:
    return 1440

# Which of the 3 thresholds `viewport_w` clears, as a single small int --
# NOT the raw pixel width. This is the responsive StyleCache's actual
# cache-bucket key: two viewport widths that clear the exact same set of
# thresholds resolve every class string identically, so bucketing by tier
# (0..3) rather than by the live pixel width is what keeps a window resize
# from missing the cache on every single pixel of movement -- only an
# actual breakpoint CROSSING invalidates anything.
pub def viewport_tier(viewport_w: int) -> int:
    if viewport_w >= breakpoint_lg():
        return 3
    if viewport_w >= breakpoint_md():
        return 2
    if viewport_w >= breakpoint_sm():
        return 1
    return 0

# The responsive entry point `StyleCache.resolve` calls per token, instead
# of `apply_utility` directly. Strips a recognized breakpoint prefix and
# only forwards the REST of the token to the ordinary `apply_utility`
# dispatch chain if the current viewport clears that breakpoint -- every
# existing non-prefixed utility token is unaffected (falls straight
# through to the same `apply_utility` call it always got), and every
# token gains responsive behavior for free with no per-token duplication.
pub def apply_utility_responsive(s: Style, token: str, viewport_w: int) -> void:
    if has(token, "sm:"):
        if viewport_w >= breakpoint_sm():
            apply_utility(s, after(token, "sm:"))
        return
    if has(token, "md:"):
        if viewport_w >= breakpoint_md():
            apply_utility(s, after(token, "md:"))
        return
    if has(token, "lg:"):
        if viewport_w >= breakpoint_lg():
            apply_utility(s, after(token, "lg:"))
        return
    apply_utility(s, token)

pub class StyleCache:
    pub cache:  Dict[str, Style]
    pub hits:   int
    pub misses: int
    # Markup-tag widgets (phase 1): a SECOND cache, same key (the raw class
    # string), same one-parse-per-unique-string cost model as `cache` above
    # -- kept separate rather than folded into `Style` itself (see this
    # file's header reservation note) so Style stays exactly what it always
    # was: 24 fields, purely visual, no widget-config leakage. A class
    # string with no widget tokens at all just caches an all-defaults
    # WidgetTokens, at the same cost as caching one with real ones.
    pub widget_cache: Dict[str, WidgetTokens]

extend StyleCache:
    pub def init() -> StyleCache:
        mut sc = StyleCache()
        sc.cache = {}
        sc.hits = 0
        sc.misses = 0
        sc.widget_cache = {}
        return sc

    # Returns a fresh copy every time. The cached Style is the canonical parse
    # of that class string; handing callers the shared instance would let one
    # node's layout mutate every other node that used the same classes.
    #
    # nebula1.0 Phase 3 (responsive breakpoints): `viewport_w` is the live
    # canvas width this frame's layout_tree() was called with -- the cache
    # key becomes `class_str + "@" + tier`, not `class_str` alone, since
    # the SAME class string (`md:flex-row`) now resolves DIFFERENTLY
    # depending on viewport width. `viewport_tier` buckets by which
    # breakpoints are cleared, not the raw pixel width, so a live window
    # resize only misses the cache on an actual breakpoint crossing, not
    # every frame. A class string with no `sm:`/`md:`/`lg:` tokens at all
    # resolves identically at every tier -- costs one extra Dict entry per
    # tier it's actually seen at (up to 4), not a cache-hit-rate regression
    # for markup that never uses the feature.
    pub def resolve(self, class_str: str, viewport_w: int) -> Style:
        mut key = class_str + "@" + viewport_tier(viewport_w).to_str()
        if key in self.cache:
            self.hits = self.hits + 1
            mut cached = self.cache[key]
            return cached.copy()

        self.misses = self.misses + 1
        mut s = Style.default()
        mut tokens = Str.split(class_str, " ")
        mut i = 0
        while i < len(tokens):
            apply_utility_responsive(s, Str.trim(tokens[i]), viewport_w)
            i = i + 1

        self.cache[key] = s
        return s.copy()

    # Markup-tag widgets (phase 1): the widget-token counterpart to
    # resolve() above, same cache-by-raw-string shape, entirely independent
    # of it (does not read or write `self.cache`, does not affect `hits`/
    # `misses`) -- see this file's header reservation note and
    # toolkit/ui/widget_tags.tr's own header for why this is a second parse
    # of the same string rather than an extension of Style.
    pub def resolve_widget(self, class_str: str) -> WidgetTokens:
        if class_str in self.widget_cache:
            mut cached = self.widget_cache[class_str]
            return cached.copy()

        mut t = parse_widget_tokens(class_str)
        self.widget_cache[class_str] = t
        return t.copy()

    pub def stats(self) -> str:
        return "StyleCache(hits=" + self.hits.to_str() + " misses=" + self.misses.to_str() + " unique=" + len(self.cache).to_str() + ")"
