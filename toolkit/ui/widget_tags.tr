# toolkit.ui.widget_tags — markup-tag widgets (proposal-v6 follow-up,
# "widgets as tags" phase 1): checkbox/switch/radio/slider/progress.
#
# Before this, every stateful widget (Checkbox, Radio, Switch, Slider,
# ProgressBar, and the rest in toolkit/ui/) was "host-painted" -- a plain
# class each example constructs, paints, and hit-tests by hand in its own
# main loop, never part of the parsed markup tree at all. That was never an
# oversight; it was because mutable state (checked, dragging, scroll offset)
# had nowhere to live in a tree that gets rebuilt from scratch every frame --
# see toolkit/ui/interp.tr's own "Proposal v4 step F" comment on
# `Interpreter.state`/`LayoutBox.node_key`, which shipped 2026-09-08
# specifically to remove that barrier ("...or a future native widget uses
# for its own state"). This file is that future widget support, arriving.
#
# ## Configuration rides the EXISTING class-string, not a new grammar
#
# `toolkit/ui/parser.tr`'s grammar has exactly one class-string and one
# `@event(handler)` per tag -- no `attr="value"` syntax, and none is added
# here. Instead, a handful of new space-separated tokens
# (`checked`/`on`/`selected`/`group-NAME`/`min-N`/`max-N`/`value-N`) ride the
# SAME class-string every markup tag already carries for visual styling
# (`<slider "min-0 max-100 value-65 w-full"/>`). `toolkit/ui/style.tr`'s
# `apply_utility` already silently ignores any token it doesn't recognize
# (that file's own header/comment, confirmed before this was written) --
# these tokens are a SEPARATE, independent parse of the SAME string into a
# DIFFERENT struct, not a Style extension. Style stays exactly what it's
# always been: 24 fields, purely visual, no widget-config leakage.
#
# ## Why five tag names as functions, not magic strings
#
# Same convention `toolkit/layout/flex.tr`'s `kind_element()`/`kind_text()`
# already use -- a typo in a function name is a compile error; a typo in a
# bare string literal scattered across `emit()`'s tag-dispatch branches is a
# silent no-op bug found only by noticing a widget never renders.

from string.str import Str
from toolkit.ui.style import resolve_color_token, unset

pub def tag_checkbox() -> str:
    return "checkbox"

pub def tag_switch() -> str:
    return "switch"

pub def tag_radio() -> str:
    return "radio"

pub def tag_slider() -> str:
    return "slider"

pub def tag_progress() -> str:
    return "progress"

# Phase 2 ("Nebula Studio" IDE demo): unlike the five leaf tags above,
# these two are CONTAINERS -- a `<tabitem>`/`<listitem>` wraps its own
# `<text>` label, the same shape `<button>` already has. They reuse radio's
# exact group-exclusive-selection mechanism (WidgetTokens' `group`/
# `selected`/`value` fields, unchanged -- no new token parsing needed) but
# paint as a top tab (background + underline bar) or a full-width sidebar
# row (highlight fill) instead of a circle+dot. See toolkit/ui/interp.tr's
# `emit_widget`/`hit_test_widget` for the paint/click logic, and
# `deselect_group_siblings` for why matching is (tag, group) together, not
# group alone -- a `<listitem>` click must never clear a `<tabitem>`'s
# selection even if a caller reused the same group name for both.
pub def tag_tabitem() -> str:
    return "tabitem"

pub def tag_listitem() -> str:
    return "listitem"

# nebula1.0 Phase 3 (dashboard widgets): three more tags, for the shapes a
# smart-home-style dashboard needs that nothing above covers -- a radial
# value control, a radial read-only gauge, and a concentric-glow icon
# button. `dial` is a LEAF like slider (reuses WidgetTokens' min/max/value,
# no children); `gauge` and `iconring` are CONTAINERS like tabitem/listitem
# (they paint their own ring/glow as decoration and let an ordinary child --
# typically a `<text>` or an icon panel -- lay out and center inside them
# via normal flex measurement, not a special-cased leaf size). See
# toolkit/ui/interp.tr's emit_widget/hit_test_widget for the paint/click
# logic and toolkit/layout/flex.tr's widget_intrinsic_w/h /
# is_measured_widget_tag for why only `dial` is added there.
pub def tag_dial() -> str:
    return "dial"

pub def tag_gauge() -> str:
    return "gauge"

pub def tag_iconring() -> str:
    return "iconring"

# nebula1.0 Phase 3 (icon support): a LEAF tag painting one of a small
# curated set of vector glyphs (see toolkit/ui/interp.tr's emit_widget ->
# paint_icon for the list) instead of a bitmap/font-glyph dependency this
# toolkit has neither the asset pipeline nor the freestanding-target file
# access for. `icon-<name>` (parsed into WidgetTokens.name below) picks
# which one; `text-<color>` (the ordinary Style token every tag already
# has) tints it, reusing Style.fg rather than inventing a second color
# token -- an icon is conceptually "colored like text" the same way a
# glyph would be.
pub def tag_icon() -> str:
    return "icon"

# nebula1.0 Phase 3: a real text-input field -- a LEAF like `checkbox`/
# `dial` (see toolkit/layout/flex.tr's widget_intrinsic_w/h). Reads
# `placeholder-<text>` for its empty-state hint. Its actual typed content
# does NOT live in WidgetTokens/LayoutBox at all (a string can't ride the
# `int`-only w_value the other stateful tags share, and it changes on
# every keystroke rather than being fixed per class-string like every
# other widget token) -- see Interpreter.text_state's own comment in
# toolkit/ui/interp.tr for where it actually lives and why.
pub def tag_textinput() -> str:
    return "textinput"

# nebula1.0 Phase 4 (baked images): a LEAF like `icon`, and configured the
# SAME way -- `src-<name>` (reusing WidgetTokens.name, the identical field
# `icon-<name>` already populates; only the TOKEN PREFIX differs) picks
# which baked image module to paint. Unlike `icon`'s small curated built-in
# set, a baked image's pixel data is inherently per-app (see
# scripts/bake-image.ps1's own header), so the actual dispatch from name ->
# pixels/w/h lives in the APP's own generated `main.tr` (cli/codegen.tr),
# not in this toolkit-wide file.
pub def tag_image() -> str:
    return "image"

# nebula1.0 Phase 4 (show/hide primitive): a CONTAINER like `gauge`/
# `iconring` -- an ordinary child tree lays out and paints normally inside
# it (see toolkit/layout/flex.tr's own collapse comment for how its HEIGHT
# becomes 0 when closed and eases between open/closed, the genuinely new
# layout mechanism this tag needed). Reuses the checkbox/switch "checked"/
# "on" token (WidgetTokens.checked, `box.w_checked`) as its OWN "open by
# default" flag -- same bool-state shape, no new token. Not clicked
# directly (no hit_test_widget branch): an ordinary sibling `@on_click`
# handler calls the ALREADY-EXISTING `Interpreter.state_toggle(key, ...)`
# on this node's own `key-<name>` to open/close it -- collapse needs no new
# click-handling code at all, only the read+animate side.
pub def tag_collapse() -> str:
    return "collapse"

# nebula1.0 Phase 4 (`<label>`): a CONTAINER like `tabitem` -- wraps an
# ordinary `<text>` (or icon, or both) child that lays out and paints
# normally, adding exactly one behavior: clicking anywhere inside it FOCUSES
# another node, the same "click the caption, not just the tiny circle/box"
# convenience HTML's own `<label for="...">`/`<legend>` give a form field.
# `for-<name>` (WidgetTokens.for_key, shared with `tooltip` below -- both
# mean "the OTHER node this one refers to") names the target the same way
# `key-<name>` already names ITS OWN node ("K:" + name). See toolkit/ui/
# interp.tr's hit_test_widget for the actual focus-setting logic, which is
# the textinput click-focus branch's own logic, just retargeted.
pub def tag_label() -> str:
    return "label"

# nebula1.0 Phase 4 (`<hr/>`): a LEAF like `icon` -- a plain filled bar,
# `text-<color>` tinted (reusing Style.fg, same "colored like text"
# convention `icon` already established) since a divider line has no
# content of its own to hang a dedicated color token off of.
pub def tag_hr() -> str:
    return "hr"

# nebula1.0 Phase 4 (`<link>`): a CONTAINER like `label` -- wraps its own
# `<text>` child (styled by the author, same as any other tag; this file
# adds no automatic underline/color) and opens `href-<url>` (WidgetTokens.
# href) in the host's browser on click, via toolkit.platform.browser's
# UrlOpener -- see that file's own header for why one target-specific
# implementation exists per tier, and toolkit/ui/interp.tr's hit_test_widget
# for where the actual launch() call happens.
pub def tag_link() -> str:
    return "link"

# nebula1.0 Phase 4 (tooltip): an OVERLAY leaf/container, shown only while
# a SIBLING trigger named by `for-<name>` is hovered -- see toolkit/layout/
# flex.tr's build() for where `tag_tooltip()` gets `style.overlay` set
# automatically (an author never has to remember to also type the `overlay`
# token themselves) and toolkit/ui/interp.tr's emit() for the hover-pct
# visibility gate. Positioning rides the SAME `x-N`/`y-N` explicit-pixel
# tokens `overlay` already has -- there is no "follow the trigger's live
# position automatically" yet (a real, documented gap: it would need a
# key->box lookup this tree has no index for today), so a tooltip's
# `x-`/`y-` has to be hand-placed near wherever its trigger actually sits.
pub def tag_tooltip() -> str:
    return "tooltip"

# True for any widget tag -- used by dispatch() to decide whether a click
# needs the widget-state-mutation path at all before falling through to the
# ordinary handler-allowlist dispatch.
pub def is_widget_tag(tag: str) -> bool:
    if tag == tag_checkbox(): return true
    if tag == tag_switch(): return true
    if tag == tag_radio(): return true
    if tag == tag_slider(): return true
    if tag == tag_progress(): return true
    if tag == tag_tabitem(): return true
    if tag == tag_listitem(): return true
    if tag == tag_dial(): return true
    if tag == tag_gauge(): return true
    if tag == tag_iconring(): return true
    if tag == tag_icon(): return true
    if tag == tag_textinput(): return true
    if tag == tag_image(): return true
    if tag == tag_collapse(): return true
    # hr paints its own bar in emit_widget; label/link/tooltip need no
    # decoration of their own (label/link are plain clickable wrappers
    # around ordinary children, tooltip's look is just ordinary Style
    # tokens on an auto-overlay box) so they are deliberately NOT here --
    # see this function's own header comment on what membership means.
    if tag == tag_hr(): return true
    return false

# Same two one-line helpers toolkit/ui/style.tr's own token parsing uses
# (`has`/`after`) -- kept as a second, independent copy rather than
# imported, since importing them would pull in all of style.tr's `Style`
# machinery for two one-line string helpers this file has no other use for.
def has(token: str, prefix: str) -> bool:
    return Str.starts_with(token, prefix)

def after(token: str, prefix: str) -> str:
    return Str.slice(token, Str.len(prefix), Str.len(token))

pub class WidgetTokens:
    pub checked:  bool   # "checked" or "on" token present
    pub selected: bool   # "selected" token present (radio's initial pick)
    pub group:    str    # "group-NAME" token's NAME, "" if none (radio only)
    pub min:      int    # "min-N" token's N (slider only, default 0)
    pub max:      int    # "max-N" token's N (slider only, default 100)
    pub value:    int    # "value-N" token's N (slider/progress initial value)
    pub name:     str    # "icon-NAME" token's NAME, "" if none (icon only)
    # "sel-<color>"/"sel-to-<color>" -- tabitem/listitem's SELECTED-state
    # fill, unset() (no fill, the pre-existing hardcoded look) by default.
    # A SEPARATE token family from the ordinary `bg-*`/`to-*` Style tokens
    # on purpose: `bg-*` paints unconditionally (every frame, selected or
    # not -- see toolkit.ui.style's own apply_color_family_token), and a
    # themed "selected pill" tab strip needs a fill that only ever shows up
    # WHILE selected. Reading it here, off WidgetTokens' own independent
    # parse of the same class string, is what lets `<tabitem
    # "sel-sky-500 sel-to-blue-600">` skip painting anything at all until
    # `state_get` says this particular tab is the selected one.
    pub sel_bg:   int
    pub sel_bg2:  int
    # "placeholder-<text>" -- textinput only, shown (muted) while empty and
    # unfocused. Class-string tokens are split on spaces (see this file's
    # own `parse_widget_tokens`), so a raw multi-word placeholder can't
    # survive that split -- `_` stands in for a space in the token itself
    # (`placeholder-What_are_you_looking_for`) and is decoded back to " "
    # here, once, at parse time, not on every paint.
    pub placeholder: str
    # "for-<name>" -- label/tooltip only. Names the OTHER node this one
    # refers to, decoded the same way `key-<name>` already names a node's
    # OWN identity ("K:" + name, see toolkit/layout/flex.tr's build()) --
    # so `<label "for-search">`'s target is the SAME "K:search" a sibling
    # `<textinput "key-search">` already answers to.
    pub for_key: str
    # "href-<url>" -- link only. Never `_`-decoded the way `placeholder-`
    # is: a URL can carry its own real underscores, and `Str.split(" ")`
    # already can't see a literal space in it either way (an author who
    # needs one has to percent-encode it, the author's problem to have, not
    # this parser's to solve).
    pub href: str
    # "tint" -- image only. A bare keyword (like "overlay"), not a
    # color itself: opts a `<image>` into recoloring via its OWN
    # `text-*`/fg, the same way `<icon>` always does. Deliberately NOT
    # automatic (see toolkit/ui/interp.tr's emit_widget tag_image()
    # branch for why: most `<image>` usage is a real photo, which fg's
    # ALWAYS-present default would silently corrupt if tinting applied
    # unconditionally).
    pub tint: bool

extend WidgetTokens:
    pub def default() -> WidgetTokens:
        mut t = WidgetTokens()
        t.checked = false
        t.selected = false
        t.group = ""
        t.min = 0
        t.max = 100
        t.value = 0
        t.name = ""
        t.sel_bg = unset()
        t.sel_bg2 = unset()
        t.placeholder = ""
        t.for_key = ""
        t.href = ""
        t.tint = false
        return t

    # Same reason StyleCache.resolve() returns Style.copy() rather than the
    # cached instance directly: a shared mutable instance would let one
    # node's (hypothetical, future) mutation bleed into every other node
    # that happened to share the same class string.
    pub def copy(self) -> WidgetTokens:
        mut t = WidgetTokens()
        t.checked = self.checked
        t.selected = self.selected
        t.group = self.group
        t.min = self.min
        t.max = self.max
        t.value = self.value
        t.name = self.name
        t.sel_bg = self.sel_bg
        t.sel_bg2 = self.sel_bg2
        t.placeholder = self.placeholder
        t.for_key = self.for_key
        t.href = self.href
        t.tint = self.tint
        return t

def apply_widget_token(t: WidgetTokens, token: str) -> void:
    if token == "tint":
        t.tint = true
        return
    if token == "checked" or token == "on":
        t.checked = true
        return
    if token == "selected":
        t.selected = true
        return
    if has(token, "group-"):
        t.group = after(token, "group-")
        return
    if has(token, "min-"):
        mut v = after(token, "min-")
        if Str.is_digit(v):
            t.min = Str.parse_int(v)
        return
    if has(token, "max-"):
        mut v = after(token, "max-")
        if Str.is_digit(v):
            t.max = Str.parse_int(v)
        return
    if has(token, "value-"):
        mut v = after(token, "value-")
        if Str.is_digit(v):
            t.value = Str.parse_int(v)
        return
    if has(token, "icon-"):
        t.name = after(token, "icon-")
        return
    if has(token, "src-"):
        t.name = after(token, "src-")
        return
    if has(token, "placeholder-"):
        t.placeholder = Str.replace(after(token, "placeholder-"), "_", " ")
        return
    if has(token, "sel-to-"):
        mut c2 = resolve_color_token(after(token, "sel-to-"))
        if c2 != unset():
            t.sel_bg2 = c2
        return
    if has(token, "sel-"):
        mut c1 = resolve_color_token(after(token, "sel-"))
        if c1 != unset():
            t.sel_bg = c1
        return
    if has(token, "for-"):
        t.for_key = after(token, "for-")
        return
    if has(token, "href-"):
        t.href = after(token, "href-")
        return

# Parses every widget-config token out of a class string, ignoring every
# ordinary Style utility token it also contains (bg-/w-/gap-/flex-row/...) --
# this is the "second, independent read of the same string" this file's own
# header describes; nothing here affects, or is affected by, StyleCache's
# own resolve(). Called from `toolkit/ui/style.tr`'s `StyleCache.
# resolve_widget(...)`, which caches the result exactly like `resolve()`
# already caches `Style`, so a class string is never re-split more than once
# per unique string regardless of how many frames re-render it.
pub def parse_widget_tokens(class_str: str) -> WidgetTokens:
    mut t = WidgetTokens.default()
    mut tokens = Str.split(class_str, " ")
    mut i = 0
    while i < len(tokens):
        apply_widget_token(t, Str.trim(tokens[i]))
        i = i + 1
    return t
