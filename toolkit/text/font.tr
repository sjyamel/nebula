# toolkit.text.font — lookup over the baked antialiased glyph atlas.
#
# The atlas itself (toolkit/text/font_data.tr) is generated, not written by
# hand — see scripts/bake-font.ps1 for why a baked atlas exists at all rather
# than parsing the TTF on-device (no rasterizer in Tauraro's stdlib, no
# float/curve math verified on the freestanding tiers, no filesystem to load
# a .ttf from on bare metal or UEFI anyway). This module is the only thing
# between that raw byte data and toolkit.ui.interp's glyph painting.
#
# Each stored pixel is a 0-16 COVERAGE LEVEL (2026-09-05: previously a single
# on/off bit — hard-edged 8x14 letterforms were the most visible "not smooth"
# thing anywhere in the toolkit, more than any rounded corner, so this
# changed first), the same scale toolkit.ui.interp.mix_color() already
# blends circles and rounded corners against. `pixel_coverage` is the text
# equivalent of that same idea: callers blend it against their own known
# backdrop color exactly the way fill_circle_aa/paint_rounded_rect_aa do.

from toolkit.text.font_data import font_cell_w, font_cell_h, font_first_char, font_glyph_count, font_coverage
from toolkit.text.font_data_sm import font_sm_cell_w, font_sm_cell_h, font_sm_first_char, font_sm_glyph_count, font_sm_coverage
from toolkit.text.font_data_lg import font_lg_cell_w, font_lg_cell_h, font_lg_first_char, font_lg_glyph_count, font_lg_coverage

# nebula1.0 Phase 2: three baked atlases (toolkit/text/font_data{,_sm,_lg}.tr,
# scripts/bake-font.ps1 -Suffix), selected by this small int rather than a
# real enum -- toolkit.ui.style.Style.font_size (the `text-sm`/`text-base`/
# `text-lg` tokens) already carries the identical convention, so a markup
# author's token and this loader agree on the same three numbers with no
# translation layer between them.
pub def font_size_sm() -> int:
    return 0

pub def font_size_base() -> int:
    return 1

pub def font_size_lg() -> int:
    return 2

# nebula1.0 Phase 4: a 4th, app-baked slot -- see Fonts.set_custom()'s own
# comment. Unlike the three above, there is no toolkit.text.font_data
# module for this one; its data comes entirely from whatever a specific
# app baked (`font = ...` in nebula.conf, via the EXISTING scripts/
# bake-font.ps1 -- already fully generic, no script changes needed).
pub def font_size_custom() -> int:
    return 3

pub class Font:
    pub coverage: List[u8]
    # Copied out of the selected baked atlas at load_size() time, once, into
    # plain instance fields -- so every OTHER method here reads self.* only,
    # never one of the three differently-sized font_data modules' free
    # functions directly. That is what makes one Font value fully self-
    # describing regardless of which atlas it was loaded from.
    pub cell_w_v:      int
    pub cell_h_v:      int
    pub first_char_v:  int
    pub glyph_count_v: int

extend Font:
    # Unchanged behavior for every existing call site (checkbox/switch/
    # textinput/interp's own default) -- always the base (text-base) size.
    pub def load() -> Font:
        return Font.load_size(font_size_base())

    pub def load_size(size: int) -> Font:
        mut f = Font()
        if size == font_size_sm():
            f.coverage = font_sm_coverage()
            f.cell_w_v = font_sm_cell_w()
            f.cell_h_v = font_sm_cell_h()
            f.first_char_v = font_sm_first_char()
            f.glyph_count_v = font_sm_glyph_count()
        elif size == font_size_lg():
            f.coverage = font_lg_coverage()
            f.cell_w_v = font_lg_cell_w()
            f.cell_h_v = font_lg_cell_h()
            f.first_char_v = font_lg_first_char()
            f.glyph_count_v = font_lg_glyph_count()
        else:
            f.coverage = font_coverage()
            f.cell_w_v = font_cell_w()
            f.cell_h_v = font_cell_h()
            f.first_char_v = font_first_char()
            f.glyph_count_v = font_glyph_count()
        return f

    pub def cell_w(self) -> int:
        return self.cell_w_v

    pub def cell_h(self) -> int:
        return self.cell_h_v

    # 0-16 coverage for pixel (col, row) within the glyph cell for
    # `codepoint` -- 0 is fully background, 16 is fully foreground, anything
    # between is a real antialiased edge. A codepoint outside the baked range
    # (currently ASCII 32..126) or an out-of-cell (col, row) returns 0
    # unconditionally, same policy the old boolean version had: an
    # unsupported character renders as blank space, never garbage or a
    # crash. UI text content is not trusted input.
    pub def pixel_coverage(self, codepoint: int, col: int, row: int) -> int:
        mut idx = codepoint - self.first_char_v
        if idx < 0:
            return 0
        if idx >= self.glyph_count_v:
            return 0
        if col < 0:
            return 0
        if col >= self.cell_w_v:
            return 0
        if row < 0:
            return 0
        if row >= self.cell_h_v:
            return 0

        mut cell = self.cell_w_v * self.cell_h_v
        mut byte_index = idx * cell + row * self.cell_w_v + col
        return self.coverage[byte_index] as int

# nebula1.0 Phase 2: the three sizes an Interpreter needs simultaneously --
# a single scene can (and typically does) mix text-sm/text-base/text-lg
# nodes in one frame, so one Font is no longer enough to paint a whole
# scene. Loaded ONCE (toolkit.ui.interp.Interpreter.init), not per-frame or
# per-node.
pub class Fonts:
    pub sm:   Font
    pub base: Font
    pub lg:   Font
    # nebula1.0 Phase 4: the 4th, app-baked slot -- unlike sm/base/lg (baked
    # into the toolkit itself, always present), `custom` is only ever
    # populated by an app that declared `font = ...` in nebula.conf, via
    # `set_custom()` below, called once from generated main.tr right after
    # `Fonts.load()` -- so `has_custom` guards it the same "optional field,
    # boolean says whether it's safe to read" shape `Interpreter.has_root`/
    # `has_image_painter` already use.
    pub custom:     Font
    pub has_custom: bool

extend Fonts:
    pub def load() -> Fonts:
        mut f = Fonts()
        f.sm = Font.load_size(font_size_sm())
        f.base = Font.load_size(font_size_base())
        f.lg = Font.load_size(font_size_lg())
        f.has_custom = false
        return f

    # Populates the custom slot from whatever scripts/bake-font.ps1 -Suffix
    # _custom produced -- same 5 values Font.load_size's own branches copy
    # out of a font_data module, just handed in directly since there is no
    # `toolkit.text.font_data_custom` module (the data is per-app, not
    # toolkit-owned, same reasoning as baked images).
    pub def set_custom(self, cell_w: int, cell_h: int, first_char: int, glyph_count: int, coverage: List[u8]) -> void:
        mut f = Font()
        f.coverage = coverage
        f.cell_w_v = cell_w
        f.cell_h_v = cell_h
        f.first_char_v = first_char
        f.glyph_count_v = glyph_count
        self.custom = f
        self.has_custom = true

    # `size` is font_size_sm()/_base()/_lg()/_custom(); anything else (a bad
    # value that should never occur, but this file's "malformed input
    # degrades safely" policy applies here too) falls back to base -- same
    # fallback an app that asks for `_custom()` without ever baking one
    # gets, via the `has_custom` guard.
    pub def pick(self, size: int) -> Font:
        if size == font_size_sm():
            return self.sm
        if size == font_size_lg():
            return self.lg
        if size == font_size_custom() and self.has_custom:
            return self.custom
        return self.base
