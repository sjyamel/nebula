# tauraroc writes generated C into build/ in the current working directory,
# which is the repo root because module resolution requires compiling from here.
build/
build-bare*/
build-uefi*/
build-desktop*/
build-web*/
buil*/
*.elf
*.ld
*.efi
*_link.log
*_build_log.txt
*.txt

# SDL2's runtime DLL -- a redistributable, not source; build-desktop.ps1
# copies it from the local mingw64 install next to every build automatically.
SDL2.dll

# Compiled executables (tauraroc names them after the entry file's basename)
# and their MSVC debug-symbol byproduct.
*.exe
*.pdb
*.png
*.jpg
*.jepg
main
hello
smoke_*

# Renderer output -- both the raw capture and any PNG a viewer script wrote
# from it (scripts/ppm-to-png.ps1). Source .ui/.tr files are never affected;
# this only matches what the demos write out.
*.ppm
*.png

# nebula CLI build output
nebula.exe
nebula.pdb
.nebula/
demo-app/

# The Tauraro defect log is source, not build output -- the blanket *.txt
# rule above would otherwise silently swallow it (it did, once).
!bugs.txt
