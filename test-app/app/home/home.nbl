# The UI is data. Edit this file and re-run -- on hosted and desktop it is
# read at runtime, so no rebuild is needed. Class strings are Tailwind:
# numbers are scale steps, so p-6 is 24px, not 6px.

<panel "flex-col p-6 gap-4 bg-slate-900 items-center justify-center">
  <panel "w-1/2 flex-col p-5 gap-4 bg-slate-800 rounded-2xl border border-slate-600">
    <text "text-slate-100">HELLO FROM NEBULA</text>
    <panel "h-24 bg-indigo-500 rounded-xl" />
    <panel "flex-row gap-4 h-12">
      <button "grow bg-sky-500 rounded-lg justify-center items-center" @on_click(on_ok)>
        <text "text-white">OK</text>
      </button>
      <button "grow bg-slate-600 rounded-lg border border-slate-400 justify-center items-center" @on_click(on_cancel)>
        <text "text-slate-100">CANCEL</text>
      </button>
    </panel>
  </panel>
</panel>
