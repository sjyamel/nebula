# cli.nebula — the `nebula` command.
#
#   nebula init <name>        scaffold a project
#   nebula build --<target>   generate + compile
#   nebula run   --<target>   build, then launch
#   nebula targets             list platforms
#
# Written in Tauraro, which was not a foregone conclusion: it needed the
# stdlib to be able to walk directories and spawn processes, and the plan
# (proposal v3, open question 1) said to settle that with a probe before
# designing anything. It can -- `io.dir.Dir.list()` and
# `sys.process.Process.system/shell_output` all work -- so this is one binary
# rather than a Tauraro core wrapped in a shell script.
#
# What it replaces: four PowerShell scripts, their accumulated flag folklore
# (`-nostartfiles`, `-fno-sanitize=undefined`, `-U_WIN32`, `-rdynamic`,
# `--freestanding`), and five hand-written `main.tr` files that between them
# carried four verbatim copies of the same bump allocator.

from io.file import File
from io.dir import Dir
from sys.process import Process
from sys.os import OS

# argv, via the runtime primitives rather than OS.args() or Env.
#
# Both documented APIs are broken: OS.args() emits a call to a symbol the
# runtime does not define, and Env.init() exits with heap corruption. These
# two externs are what actually works. See bugs.txt #6 and #7.
extern "C":
    def _tr_get_argc() -> int
    def _tr_get_arg(n: int) -> str
from string.str import Str
from cli.config import Config, load_config, target_from_name, target_name
from cli.config import target_hosted, target_desktop, target_web, target_uefi, target_bare
from cli.config import target_unknown, all_target_names, is_freestanding
from cli.codegen import generate

def usage() -> void:
    print("nebula -- a cross-platform GUI engine")
    print("")
    print("  nebula init <name>         scaffold a new project")
    print("  nebula build --<target>    generate the entry point and compile")
    print("  nebula run   --<target>    build, then launch it")
    print("  nebula targets             list the platforms")
    print("")
    print("targets: " + all_target_names())
    print("")
    print("  nebula init my-app")
    print("  cd my-app")
    print("  nebula run --desktop")

# The SDK lives under the user's profile; every tool the CLI shells out to is
# found relative to it rather than trusted to be on PATH, because a shell
# started before the SDK was installed will not have it.
def sdk_root() -> str:
    return Process.shell_output("echo %USERPROFILE%")

def tool(name: str) -> str:
    mut home = Str.trim(sdk_root())
    # Forward slashes on purpose: a literal backslash cannot currently be
    # written in a Tauraro string at all -- `\` produces nothing (bugs.txt #8).
    # Windows accepts forward slashes in paths everywhere this matters.
    return "\"" + home + "/.taupkg/bin/tauraroc-windows-x64/" + name + "\""

def say(s: str) -> void:
    print(s)

def fail(s: str) -> void:
    print("error: " + s)

# --- init --------------------------------------------------------------

def scaffold_conf(name: str) -> str:
    mut s = "# nebula.conf -- one key = value per line, # for comments.\n"
    s = s + "name    = " + name + "\n"
    s = s + "width   = 900\n"
    s = s + "height  = 560\n"
    s = s + "page_dir = app\n"
    s = s + "pages   = home\n"
    s = s + "bg      = #0F172A\n"
    return s

def scaffold_home_nbl() -> str:
    mut s = "# The UI is data. Edit this file and re-run -- on hosted and desktop it is\n"
    s = s + "# read at runtime, so no rebuild is needed. Class strings are Tailwind:\n"
    s = s + "# numbers are scale steps, so p-6 is 24px, not 6px.\n\n"
    s = s + "<panel \"flex-col p-6 gap-4 bg-slate-900 items-center justify-center\">\n"
    s = s + "  <panel \"w-1/2 flex-col p-5 gap-4 bg-slate-800 rounded-2xl border border-slate-600\">\n"
    s = s + "    <text \"text-slate-100\">HELLO FROM NEBULA</text>\n"
    s = s + "    <panel \"h-24 bg-indigo-500 rounded-xl\" />\n"
    s = s + "    <panel \"flex-row gap-4 h-12\">\n"
    s = s + "      <button \"grow bg-sky-500 rounded-lg justify-center items-center\" @on_click(on_ok)>\n"
    s = s + "        <text \"text-white\">OK</text>\n"
    s = s + "      </button>\n"
    s = s + "      <button \"grow bg-slate-600 rounded-lg border border-slate-400 justify-center items-center\" @on_click(on_cancel)>\n"
    s = s + "        <text \"text-slate-100\">CANCEL</text>\n"
    s = s + "      </button>\n"
    s = s + "    </panel>\n"
    s = s + "  </panel>\n"
    s = s + "</panel>\n"
    return s

def scaffold_home_tr() -> str:
    mut s = "# Handlers for app/home/home.nbl.\n"
    s = s + "#\n"
    s = s + "# The contract is one function: `register_all(it)`. Nebula never scans this\n"
    s = s + "# file for handler names -- a convention the compiler checks beats a regex\n"
    s = s + "# that guesses -- so anything you want reachable from markup has to be\n"
    s = s + "# registered here. A page may also export `on_frame(canvas, w, h, mx, my,\n"
    s = s + "# buttons, key, wheel)`, called every frame while this page is active, for\n"
    s = s + "# anything the markup tree alone can't draw (see cli/codegen.tr's header).\n"
    s = s + "#\n"
    s = s + "# A handler is a class implementing EventHandler rather than a function,\n"
    s = s + "# which also gives it somewhere to keep state.\n\n"
    s = s + "from toolkit.types import Event, EventHandler\n"
    s = s + "from toolkit.ui.interp import Interpreter, register_handler\n\n"
    s = s + "pub class Say implements EventHandler:\n"
    s = s + "    pub label: str\n\n"
    s = s + "extend Say:\n"
    s = s + "    pub def init(label: str) -> Say:\n"
    s = s + "        mut h = Say()\n"
    s = s + "        h.label = label\n"
    s = s + "        return h\n\n"
    s = s + "    pub def handle(self, e: Event) -> void:\n"
    s = s + "        print(\"[handler] \" + self.label + \" at (\" + e.x.to_str() + \",\" + e.y.to_str() + \")\")\n\n"
    s = s + "pub def register_all(it: Interpreter) -> void:\n"
    s = s + "    register_handler(it, \"on_ok\", Say.init(\"OK\"))\n"
    s = s + "    register_handler(it, \"on_cancel\", Say.init(\"CANCEL\"))\n"
    return s

def cmd_init(name: str) -> int:
    if name == "":
        fail("usage: nebula init <name>")
        return 1

    mut root = Dir.init(name)
    if root.exists():
        fail("'" + name + "' already exists here")
        return 1
    root.make()
    mut app = Dir.init(name + "/app")
    app.make()
    mut home = Dir.init(name + "/app/home")
    home.make()

    File.write_text(name + "/nebula.conf", scaffold_conf(name))
    File.write_text(name + "/app/home/home.nbl", scaffold_home_nbl())
    File.write_text(name + "/app/home/home.tr", scaffold_home_tr())

    say("created " + name + "/")
    say("  nebula.conf")
    say("  app/home/home.nbl    the UI, as data")
    say("  app/home/home.tr     handlers, via register_all(it)")
    say("")
    say("add another page: mkdir app/settings, write app/settings/settings.nbl")
    say("+.tr, then add it to nebula.conf's `pages = home, settings` line and")
    say("navigate to it (toolkit.ui.router.Router.navigate) from any handler.")
    say("")
    say("next:")
    say("  cd " + name)
    say("  nebula run --hosted     # fastest loop, writes a PPM")
    say("  nebula run --desktop    # a real window")
    say("  nebula run --web        # a browser tab")
    return 0

# --- build ---------------------------------------------------------------

def emit_entry(cfg: Config, target: int) -> str:
    mut out = Dir.init(".nebula")
    if not out.exists():
        out.make()

    mut src = generate(cfg, target)
    if src == "":
        fail("no generator for target " + target_name(target))
        return ""

    mut path = ".nebula/main.tr"
    File.write_text(path, src)
    return path

def clean_build_dir() -> void:
    Process.system("powershell -NoProfile -Command \"Remove-Item build -Recurse -Force -ErrorAction SilentlyContinue\"")

# Wraps a forward-slash exe path so PowerShell will launch it.
def launch(path: str) -> str:
    return "powershell -NoProfile -Command \"& '" + path + "'\""

# The directory nebula.exe itself was invoked from, so a resource that
# ships ALONGSIDE it (scripts/bake-image.ps1) can be found regardless of
# the CALLER's own current directory (an app being built typically lives
# outside this repo entirely). `_tr_get_arg(0)` is argv[0] -- how it was
# actually invoked, which is a real path (relative or absolute) whenever
# invoked as `nebula.exe`/`./nebula.exe`/a full path, though not when
# resolved bare through PATH (no separator in argv[0] at all; falls back
# to "." -- the existing CWD-relative scripts/... calls this doesn't touch
# yet have exactly that same assumption already). Scans for the LAST `/`
# OR `\` by codepoint rather than a string literal search, because a
# literal backslash cannot currently be written in a Tauraro string at all
# (bugs.txt #8, the same limitation launch()'s own comment works around).
def exe_dir() -> str:
    mut p = _tr_get_arg(0)
    mut n = Str.len(p)
    mut cut = 0 - 1
    mut i = 0
    while i < n:
        mut c = Str.char_at(p, i)
        if c == 47 or c == 92:
            cut = i
        i = i + 1
    if cut <= 0:
        return "."
    return Str.slice(p, 0, cut)

def run_cmd(label: str, cmd: str) -> bool:
    mut rc = Process.system(cmd)
    if rc != 0:
        fail(label + " failed (exit " + rc.to_str() + ")")
        return false
    return true

# nebula1.0 Phase 4: bakes every `images = name:path, ...` entry (see
# ImageEntry's own comment in cli/config.tr) into `nebula_assets/
# image_<name>.tr` via scripts/bake-image.ps1 -- BEFORE emit_entry() runs,
# since cli/codegen.tr's generate() needs to know the image list to emit
# the right imports/AppImagePainter class, and that file mirrors
# whatever's actually on disk rather than baking on demand at import time
# (freestanding targets have no filesystem to bake FROM at runtime anyway,
# same reasoning as markup being embedded as a string constant -- see that
# file's own header). A no-op (returns true immediately) for the common
# case of an app with no `images` line at all.
def bake_images(cfg: Config) -> bool:
    if len(cfg.images) == 0:
        return true
    mut out = Dir.init("nebula_assets")
    if not out.exists():
        out.make()
    mut i = 0
    while i < len(cfg.images):
        mut e = cfg.images[i]
        mut outTr = "nebula_assets/image_" + e.name + ".tr"
        # 128x128 cap: a baked image is compiled-in SOURCE (see
        # scripts/bake-image.ps1's own header on why), so an accidentally
        # huge source photo must not turn into a multi-megabyte .tr file --
        # plenty for the icon/logo-sized assets this is meant for.
        mut cmd = "powershell -NoProfile -File " + exe_dir() + "/scripts/bake-image.ps1 -ImagePath \"" + e.path + "\" -Name " + e.name + " -OutTr " + outTr + " -MaxW 128 -MaxH 128"
        if not run_cmd("bake-image (" + e.name + ")", cmd):
            return false
        i = i + 1
    return true

# Hosted and desktop compile straight to a native exe. Desktop additionally
# needs SDL2 linked by path: `-lSDL2` fails with "searched paths: none",
# because tauraroc's -l resolution does not look in the working directory.
def build_native(cfg: Config, target: int, entry: str) -> bool:
    clean_build_dir()
    mut exe = ".nebula/" + cfg.name + ".exe"
    mut cmd = tool("tauraroc.exe") + " " + entry + " -o " + exe
    if target == target_desktop():
        # SDL2 is not vendored: the .dll is gitignored upstream and the .lib
        # is derived from it. Checked here rather than left to the linker,
        # whose "SDL2.lib: file not found" says nothing about what to do.
        # `--link <path>` and not `-lSDL2`: tauraroc's -l resolution does not
        # search the working directory and fails with "searched paths: none".
        if File.read_text("SDL2.lib") == "":
            fail("SDL2.lib not found in this directory.")
            say("  The desktop backend links SDL2, which is not vendored with Nebula.")
            say("  Copy SDL2.lib and SDL2.dll next to nebula.conf, then retry.")
            say("  (Generate SDL2.lib from an official SDL2.dll with dumpbin + lib,")
            say("   or take the pair from the Nebula repo root.)")
            return false
        cmd = cmd + " --link SDL2.lib"
    return run_cmd("tauraroc", cmd)

# Freestanding wasm: one tauraroc invocation does it all now -- per-module
# object caching + a direct wasm-ld link (tauraroc/src/main.tr's
# compile_wasm_incremental), not a separate `zig build-exe` pass over every
# generated .c file every time. That older pattern (still visible in git
# history) reran zig's own build driver from scratch on every build and was
# measured at 8.8GB peak RSS linking a ~30-file toolkit -- the actual cause
# of "wasm builds take an hour and time out", not anything about wasm
# itself. See tauraro's own commit history for the full story.
def build_web(cfg: Config, entry: str) -> bool:
    clean_build_dir()
    mut wasm = ".nebula/nebula.wasm"
    # 512MB, not 64: every frame's LayoutBox tree + Scene is currently never
    # reclaimed (see cli/codegen.tr's gen_web, the comment on why a
    # per-frame arena release was tried and reverted -- it corrupted
    # Interpreter.state instead). Until that gets a real two-region
    # allocator fix, a bigger ceiling is the whole mitigation: 64MB filled
    # (and hung the tab) in under a minute on a dashboard-sized page; 512MB
    # buys roughly 8x the session length before the same thing happens.
    # Costs nothing up front (wasm memory is lazily committed), so there is
    # no reason to size this any tighter.
    mut cmd = tool("tauraroc.exe") + " " + entry + " --target wasm --freestanding -Os --wasm-memory 512 -o " + wasm
    return run_cmd("tauraroc", cmd)

# The host page. Written out beside the .wasm so `nebula run --web` produces
# something a browser can open with no other files and no bundler.
#
# Renders through toolkit.render.web.canvas2d_renderer's real Canvas2D calls
# (js_set_canvas_size/js_fill_rect/js_rounded_rect/js_circle/js_fill_text),
# not a raw-pixel ImageData blit -- see cli/codegen.tr's gen_web for why.
# HiDPI-correct: the canvas buffer is sized to CSS-size*devicePixelRatio and
# the 2D context is scaled to match, or the whole page renders visibly soft
# on any display with devicePixelRatio > 1 (basically every laptop screen),
# not just at the edges -- confirmed the hard way building examples/web_ide.
def host_page(cfg: Config) -> str:
    mut w = cfg.width.to_str()
    mut h = cfg.height.to_str()
    mut s = "<!doctype html>\n<meta charset=\"utf-8\">\n"
    s = s + "<title>" + cfg.name + "</title>\n"
    s = s + "<style>\n"
    s = s + "  html, body { margin:0; height:100%; background:" + cfg.bg + ";\n"
    s = s + "               font:13px ui-monospace,SFMono-Regular,Menlo,monospace; color:#94a3b8; }\n"
    if cfg.fixed_size:
        s = s + "  body { display:grid; place-items:center; gap:12px; }\n"
        s = s + "  canvas { border-radius:12px; box-shadow:0 24px 60px #0008; }\n"
    else:
        # nebula1.0 Phase 3: fills the browser window by default (the OLD
        # centered-fixed-canvas layout is opt-in now, via `fixed_size =
        # true` in nebula.conf -- see Config.fixed_size's own comment).
        # overflow:hidden on both stops a 1px scroll-bounce from ever
        # showing a scrollbar next to a canvas already sized to fill
        # exactly -- the same reasoning examples/web_ide's own index.html
        # documents.
        s = s + "  html, body { width:100%; overflow:hidden; }\n"
        s = s + "  canvas { display:block; }\n"
    s = s + "  #hud { opacity:.75; position:fixed; bottom:6px; left:10px; pointer-events:none; }\n"
    s = s + "</style>\n"
    s = s + "<canvas id=\"c\" tabindex=\"0\"></canvas>\n"
    s = s + "<div id=\"hud\">loading...</div>\n"
    s = s + "<script type=\"module\">\n"
    if cfg.fixed_size:
        s = s + "let W = " + w + ", H = " + h + ";\n"
    else:
        s = s + "let W = window.innerWidth, H = window.innerHeight;\n"
    s = s + "const cv = document.getElementById('c'), ctx = cv.getContext('2d');\n"
    s = s + "const hud = document.getElementById('hud');\n"
    s = s + "let mem = null;\n\n"
    s = s + "function unpack(c) { return [(c>>16)&255, (c>>8)&255, c&255]; }\n\n"
    # HiDPI fix -- see this function's own header comment. Sizing is
    # factored into its own function (not run once at the top): a
    # non-fixed-size page needs to redo this on window resize too, guarded
    # against redundant reallocation -- js_set_canvas_size fires EVERY
    # frame (Canvas2DCanvas.init runs inside nebula_frame), and reassigning
    # cv.width/height unconditionally reallocates the entire backing store
    # every single time; once the canvas fills the whole window that is a
    # full-screen GPU buffer realloc 60 times a second, which is exactly
    # what hung a tab building examples/web_ide earlier this session.
    s = s + "let lastW = -1, lastH = -1, lastDpr = 0;\n"
    s = s + "function applyCanvasSize(w, h) {\n"
    s = s + "  const dpr = window.devicePixelRatio || 1;\n"
    s = s + "  if (w === lastW && h === lastH && dpr === lastDpr) return;\n"
    s = s + "  lastW = w; lastH = h; lastDpr = dpr;\n"
    s = s + "  cv.width = Math.round(w * dpr);\n"
    s = s + "  cv.height = Math.round(h * dpr);\n"
    s = s + "  cv.style.width = w + 'px';\n"
    s = s + "  cv.style.height = h + 'px';\n"
    s = s + "  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n"
    s = s + "}\n"
    s = s + "applyCanvasSize(W, H);\n"
    if not cfg.fixed_size:
        s = s + "window.addEventListener('resize', () => {\n"
        s = s + "  W = window.innerWidth; H = window.innerHeight;\n"
        s = s + "});\n"
    s = s + "\n"
    s = s + "const importObj = { env: {\n"
    s = s + "  js_set_canvas_size(w, h) { applyCanvasSize(w, h); },\n"
    s = s + "  js_fill_rect(x, y, w, h, color, alpha) {\n"
    s = s + "    const [r,g,b] = unpack(color);\n"
    s = s + "    ctx.fillStyle = alpha >= 255 ? `rgb(${r},${g},${b})` : `rgba(${r},${g},${b},${alpha/255})`;\n"
    s = s + "    ctx.fillRect(x, y, w, h);\n"
    s = s + "  },\n"
    s = s + "  js_rounded_rect(x, y, w, h, radius, color) {\n"
    s = s + "    const [r,g,b] = unpack(color);\n"
    s = s + "    ctx.fillStyle = `rgb(${r},${g},${b})`;\n"
    s = s + "    ctx.beginPath(); ctx.roundRect(x, y, w, h, Math.max(0, radius)); ctx.fill();\n"
    s = s + "  },\n"
    s = s + "  js_circle(cx, cy, r, color) {\n"
    s = s + "    const [rr,gg,bb] = unpack(color);\n"
    s = s + "    ctx.fillStyle = `rgb(${rr},${gg},${bb})`;\n"
    s = s + "    ctx.beginPath(); ctx.arc(cx, cy, Math.max(0, r), 0, Math.PI*2); ctx.fill();\n"
    s = s + "  },\n"
    s = s + "  js_fill_text(ptr, len, x, y, sizePx, color) {\n"
    s = s + "    const [r,g,b] = unpack(color);\n"
    s = s + "    const bytes = new Uint8Array(mem.buffer, ptr, len);\n"
    s = s + "    const text = new TextDecoder().decode(bytes);\n"
    s = s + "    ctx.fillStyle = `rgb(${r},${g},${b})`;\n"
    s = s + "    ctx.font = `${sizePx}px ui-monospace,SFMono-Regular,Menlo,monospace`;\n"
    s = s + "    ctx.textBaseline = 'top';\n"
    s = s + "    ctx.fillText(text, x, y);\n"
    s = s + "  },\n"
    # nebula1.0 Phase 3: real ctx.createLinearGradient + ctx.arc, matching
    # toolkit/render/web/canvas2d_renderer.tr's js_gradient_rect/js_arc_ring
    # extern signatures. dir: 0=horizontal, 1=vertical, 2=diagonal --
    # angle convention for arc_ring: 0 degrees is straight up (12 o'clock),
    # increasing clockwise (matches toolkit.ui.trig's sin1000/cos1000,
    # which the CPU-rasterizer path this mirrors uses the same way) --
    # canvas's own 0-radians is 3-o'clock with clockwise-positive angles in
    # its y-down coordinate space, hence the `- 90` degree shift below.
    s = s + "  js_gradient_rect(x, y, w, h, radius, colorA, colorB, dir) {\n"
    s = s + "    const [ar,ag,ab] = unpack(colorA);\n"
    s = s + "    const [br,bg,bb] = unpack(colorB);\n"
    s = s + "    let grad;\n"
    s = s + "    if (dir === 1) grad = ctx.createLinearGradient(x, y, x, y + h);\n"
    s = s + "    else if (dir === 2) grad = ctx.createLinearGradient(x, y, x + w, y + h);\n"
    s = s + "    else grad = ctx.createLinearGradient(x, y, x + w, y);\n"
    s = s + "    grad.addColorStop(0, `rgb(${ar},${ag},${ab})`);\n"
    s = s + "    grad.addColorStop(1, `rgb(${br},${bg},${bb})`);\n"
    s = s + "    ctx.fillStyle = grad;\n"
    s = s + "    ctx.beginPath(); ctx.roundRect(x, y, w, h, Math.max(0, radius)); ctx.fill();\n"
    s = s + "  },\n"
    s = s + "  js_arc_ring(cx, cy, r, ringW, startDeg, sweepDeg, active, track) {\n"
    s = s + "    const [tr,tg,tb] = unpack(track);\n"
    s = s + "    const rad = Math.max(1, r - ringW / 2);\n"
    s = s + "    ctx.lineWidth = Math.max(1, ringW);\n"
    s = s + "    ctx.lineCap = 'butt';\n"
    s = s + "    ctx.strokeStyle = `rgb(${tr},${tg},${tb})`;\n"
    s = s + "    ctx.beginPath(); ctx.arc(cx, cy, rad, 0, Math.PI * 2); ctx.stroke();\n"
    s = s + "    if (sweepDeg > 0) {\n"
    s = s + "      const [ar,ag,ab] = unpack(active);\n"
    s = s + "      const a0 = (startDeg - 90) * Math.PI / 180;\n"
    s = s + "      const a1 = (startDeg + sweepDeg - 90) * Math.PI / 180;\n"
    s = s + "      ctx.strokeStyle = `rgb(${ar},${ag},${ab})`;\n"
    s = s + "      ctx.lineCap = 'round';\n"
    s = s + "      ctx.beginPath(); ctx.arc(cx, cy, rad, a0, a1, false); ctx.stroke();\n"
    s = s + "    }\n"
    s = s + "  },\n"
    # nebula1.0 Phase 4: `ImageData`/`putImageData` is the natural fit for
    # RGBA pixel data (its own native format, no conversion) -- but
    # putImageData ignores the canvas's own transform (the dpr scale set up
    # by applyCanvasSize), so it's drawn through a same-size OFFSCREEN
    # canvas first and blitted via ctx.drawImage(...), which DOES respect
    # the transform -- otherwise a baked image would land at the wrong
    # physical pixel on any non-1x display.
    s = s + "  js_image_blit(x, y, w, h, ptr, len) {\n"
    s = s + "    const bytes = new Uint8ClampedArray(mem.buffer, ptr, len).slice();\n"
    s = s + "    const imgData = new ImageData(bytes, w, h);\n"
    s = s + "    const off = document.createElement('canvas');\n"
    s = s + "    off.width = w; off.height = h;\n"
    s = s + "    off.getContext('2d').putImageData(imgData, 0, 0);\n"
    s = s + "    ctx.drawImage(off, x, y, w, h);\n"
    s = s + "  },\n"
    s = s + "}};\n\n"
    s = s + "const { instance } = await WebAssembly.instantiateStreaming(fetch('nebula.wasm'), importObj);\n"
    s = s + "const ex = instance.exports;\n"
    s = s + "mem = ex.memory;\n\n"
    s = s + "const heapBase = Number(ex.__heap_base.value ?? ex.__heap_base);\n"
    s = s + "const total = ex.memory.buffer.byteLength;\n"
    s = s + "ex.nebula_heap_init(heapBase, BigInt(total - heapBase));\n"
    s = s + "ex.nebula_init(BigInt(W), BigInt(H));\n\n"
    s = s + "let mx = 0, my = 0, buttons = 0, key = 0, wheel = 0;\n"
    s = s + "cv.addEventListener('mousemove', e => {\n"
    s = s + "  const r = cv.getBoundingClientRect();\n"
    s = s + "  mx = Math.round((e.clientX - r.left) * (W / r.width));\n"
    s = s + "  my = Math.round((e.clientY - r.top) * (H / r.height));\n"
    s = s + "});\n"
    s = s + "cv.addEventListener('mousedown', () => { buttons = 1; cv.focus(); });\n"
    s = s + "window.addEventListener('mouseup', () => { buttons = 0; });\n"
    s = s + "cv.addEventListener('contextmenu', e => e.preventDefault());\n"
    s = s + "cv.addEventListener('wheel', e => { e.preventDefault(); wheel = e.deltaY < 0 ? 1 : -1; }, { passive: false });\n\n"
    # Key-code contract: 8=Backspace 9=Tab 13=Enter 1001..1009=Left/Right/Up/
    # Down/Home/End/PageUp/PageDown/Delete, 32..126=printable ASCII. A page's
    # own on_frame handler reads these the same way examples/web_ide's does.
    s = s + "const KEY_MAP = { Backspace:8, Tab:9, Enter:13, ArrowLeft:1001, ArrowRight:1002,\n"
    s = s + "  ArrowUp:1003, ArrowDown:1004, Home:1005, End:1006, PageUp:1007, PageDown:1008, Delete:1009 };\n"
    s = s + "const NAV_KEYS = new Set(Object.keys(KEY_MAP));\n"
    s = s + "cv.addEventListener('keydown', e => {\n"
    s = s + "  if (e.ctrlKey || e.metaKey || e.altKey) return;\n"
    s = s + "  if (NAV_KEYS.has(e.key)) { key = KEY_MAP[e.key]; e.preventDefault(); }\n"
    s = s + "  else if (e.key.length === 1) { key = e.key.charCodeAt(0); }\n"
    s = s + "});\n\n"
    s = s + "let lastCursor = -1;\n"
    s = s + "function frame() {\n"
    s = s + "  ex.nebula_frame(BigInt(W), BigInt(H), BigInt(mx), BigInt(my), BigInt(buttons), BigInt(key), BigInt(wheel));\n"
    s = s + "  key = 0; wheel = 0;\n"
    # A single <canvas> has no per-region native cursor -- the wasm side
    # tells us what's under (mx,my) each frame (1 = I-beam over a
    # `<textinput>`, 0 = default) and we set the CSS cursor to match. Only
    # touches the DOM on an actual change, not every frame.
    s = s + "  const ck = Number(ex.nebula_cursor_kind());\n"
    s = s + "  if (ck !== lastCursor) { cv.style.cursor = ck === 1 ? 'text' : 'default'; lastCursor = ck; }\n"
    s = s + "  hud.textContent = ex.nebula_frames() + ' frames - arena ' + ex.nebula_arena_used() + ' bytes';\n"
    s = s + "  requestAnimationFrame(frame);\n"
    s = s + "}\n"
    s = s + "requestAnimationFrame(frame);\n"
    s = s + "</script>\n"
    return s

# --- build / run dispatch --------------------------------------------------

def do_build(cfg: Config, target: int) -> bool:
    say("building " + cfg.name + " for " + target_name(target) + "...")
    if not bake_images(cfg):
        return false
    mut entry = emit_entry(cfg, target)
    if entry == "":
        return false
    say("  generated " + entry)

    if target == target_hosted():
        return build_native(cfg, target, entry)
    if target == target_desktop():
        return build_native(cfg, target, entry)
    if target == target_web():
        if not build_web(cfg, entry):
            return false
        File.write_text(".nebula/index.html", host_page(cfg))
        say("  wrote .nebula/index.html")
        return true
    # UEFI and bare metal still go through the PowerShell scripts: both need a
    # linker script, a zig stub, or a qemu invocation whose flag folklore is
    # already encoded there and not yet worth re-deriving here. The generated
    # entry point above is the part that mattered; absorbing the scripts is
    # tracked as the remainder of phase 3.
    if target == target_uefi():
        return run_cmd("build-uefi", "powershell -NoProfile -File scripts/build-uefi.ps1 -Source " + entry + " -Stub examples/uefi_demo/boot_interactive.zig -OutDir .nebula/uefi")
    if target == target_bare():
        return run_cmd("build-bare", "powershell -NoProfile -File scripts/build-bare.ps1 -Source " + entry)
    return false

def do_run(cfg: Config, target: int) -> bool:
    if not do_build(cfg, target):
        return false

    # Launched through PowerShell, not directly: cmd.exe reads a leading `/`
    # as a switch, and a literal backslash cannot be written in a Tauraro
    # string at all (bugs.txt #8), so a forward-slash path is the only one
    # this program can construct -- and PowerShell accepts it.
    if target == target_hosted():
        return run_cmd("run", launch(".nebula/" + cfg.name + ".exe"))
    if target == target_desktop():
        # SDL2.dll has to sit beside the exe, and it is gitignored, so copy
        # whatever the repo root has rather than making the user do it.
        Process.system("powershell -NoProfile -Command \"Copy-Item SDL2.dll .nebula/ -Force -ErrorAction SilentlyContinue\"")
        return run_cmd("run", launch(".nebula/" + cfg.name + ".exe"))
    if target == target_web():
        say("")
        say("serve it (the page fetches the .wasm, so file:// will not work):")
        say("  cd .nebula && python -m http.server 8000")
        say("then open http://localhost:8000/")
        return true
    if target == target_uefi():
        return run_cmd("run-uefi", "powershell -NoProfile -File scripts/run-uefi.ps1 -OutDir .nebula/uefi -Build:$false")
    if target == target_bare():
        return run_cmd("run-bare", "powershell -NoProfile -File scripts/run-bare.ps1")
    return false

# --- entry point -----------------------------------------------------------

# Accepts `--web`, `-web` or a bare `web`, because all three are things
# people type and none of them is ambiguous.
def parse_target(arg: str) -> int:
    mut a = arg
    while Str.starts_with(a, "-"):
        a = Str.slice(a, 1, Str.len(a))
    return target_from_name(a)

def main():
    mut nargs = _tr_get_argc()
    if nargs < 2:
        usage()
        return

    mut cmd = _tr_get_arg(1)

    if cmd == "help" or cmd == "--help" or cmd == "-h":
        usage()
        return

    if cmd == "targets":
        say("targets: " + all_target_names())
        return

    if cmd == "init":
        mut name = ""
        if nargs > 2:
            name = _tr_get_arg(2)
        Process.exit(cmd_init(name))
        return

    if cmd == "build" or cmd == "run":
        if nargs < 3:
            fail("which target? one of: " + all_target_names())
            return
        mut targ = _tr_get_arg(2)
        mut t = parse_target(targ)
        if t == target_unknown():
            fail("unknown target '" + targ + "' -- expected one of: " + all_target_names())
            return
        mut cfg = load_config("nebula.conf")
        if not cfg.ok:
            fail(cfg.err)
            return
        mut ok = false
        if cmd == "build":
            ok = do_build(cfg, t)
        else:
            ok = do_run(cfg, t)
        if ok:
            return
        Process.exit(1)
        return

    fail("unknown command '" + cmd + "'")
    usage()
