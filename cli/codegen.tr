# cli.codegen — generates the per-target entry point.
#
# This is the CLI's real reason to exist. Before it, every tier needed a
# hand-written `main.tr` carrying the same three things: an ~80-line bump
# allocator (copy-pasted verbatim into four programs), a platform event loop,
# and the boilerplate to wire a parser to an Interpreter to a Canvas. None of
# that is app code, and none of it is what a person writing a UI should be
# reading, let alone maintaining five copies of.
#
# What the app author writes is one or more PAGES -- `app/<name>/<name>.nbl`
# (markup) plus an optional `app/<name>/<name>.tr` -- and everything below is
# generated into `.nebula/main.tr` and compiled. Multiple pages are wired
# into one toolkit.ui.router.Router; `cfg.pages[0]` is the initial route.
#
# ## The page contract
#
# A page's `.tr` file may define either or both of:
#   pub def register_all(it: Interpreter) -> void
#       Event handlers for this page's markup, via register_handler(). Called
#       once at startup for every page (handler names are global across the
#       whole Interpreter, same as markup dispatch already is).
#   pub def on_frame(canvas: Canvas, w: int, h: int, mx: int, my: int,
#                     buttons: int, key: int, wheel: int) -> void
#       Called every frame, AFTER the tree renders, but ONLY while this page
#       is the router's current one. For anything the markup tree can't
#       express on its own -- a text editor's own buffer+cursor, a custom
#       chart, anything hand-painted. Most pages don't need this.
# A SINGLE-page app can name these exactly `register_all`/`on_frame`, as
# written above. An app with TWO OR MORE pages that each define one MUST
# instead name them `<page>_register_all`/`<page>_on_frame` (e.g. a page
# named "settings" exports `settings_register_all`) -- see load_page's own
# comment in the PageInfo section below for the real tauraroc bug this
# works around (an aliased import of a same-named symbol from a second
# module silently collapses onto the first module's one once there's more
# than one). Presence of either is decided by a plain substring check on
# the page's own .tr source, checked in BOTH the prefixed and plain forms
# (register_prefixed/on_frame_prefixed) -- same spirit as the original
# has_handlers check (a file-existence test) just extended to two possible
# exports and two possible spellings instead of one, still not a regex
# guessing at MARKUP handler names, which is the thing the project's own
# convention explicitly rejects (see register_all's own doc comment below).
#
# ## Why the markup is baked in for freestanding targets
#
# Web, UEFI and bare metal have no filesystem to read a `.nbl` file from. So
# for those, every page's markup is embedded as a string constant at BUILD
# time. Hosted and desktop read the same files from disk at RUNTIME, which is
# what makes a dev loop able to reload them without a rebuild. Same source
# files, same rendering, two delivery mechanisms -- and the escaping below is
# what lets one `.nbl` file serve both.

from string.str import Str
from io.file import File
from cli.config import Config, target_hosted, target_desktop, target_web
from cli.config import target_uefi, target_bare, is_freestanding

# Turns arbitrary markup into a Tauraro string literal. Quotes, backslashes
# and newlines all have to survive being pasted into generated source -- a
# `.nbl` file is full of quoted class strings, so this is the common case,
# not an edge case.
pub def escape_literal(s: str) -> str:
    mut out = ""
    mut i = 0
    mut n = Str.len(s)
    while i < n:
        mut ch = Str.slice(s, i, i + 1)
        if ch == "\\":
            out = out + "\\\\"
        elif ch == "\"":
            out = out + "\\\""
        elif ch == "\n":
            out = out + "\n"
        elif ch == "\r":
            out = out + ""
        elif ch == "\t":
            out = out + "  "
        else:
            out = out + ch
        i = i + 1
    return out

# The allocator hooks every freestanding target needs. Named distinctively on
# purpose: a hook becomes a C macro (`#define TAURARO_CALLOC(n,sz) name(n,sz)`)
# that is expanded inside tauraro_rt.h, so a short name like `c` collides with
# the runtime's own locals and fails with an error that names neither.
def arena_hooks() -> str:
    mut s = ""
    s = s + "from toolkit.platform.arena import arena_init, arena_alloc, arena_realloc, arena_calloc\n"
    s = s + "from toolkit.platform.arena import arena_mark, arena_release, arena_used\n\n"
    s = s + "@allocator\n"
    s = s + "def nebula_alloc(n: usize) -> Pointer[u8]:\n"
    s = s + "    return arena_alloc(n)\n\n"
    s = s + "@free\n"
    s = s + "def nebula_free(p: Pointer[u8]):\n"
    s = s + "    pass\n\n"
    s = s + "@realloc\n"
    s = s + "def nebula_realloc(p: Pointer[u8], n: usize) -> Pointer[u8]:\n"
    s = s + "    return arena_realloc(p, n)\n\n"
    s = s + "@calloc\n"
    s = s + "def nebula_calloc(n: usize, sz: usize) -> Pointer[u8]:\n"
    s = s + "    return arena_calloc(n, sz)\n\n"
    return s

def banner(cfg: Config, target: str) -> str:
    mut s = "# GENERATED by `nebula build --" + target + "`. Do not edit.\n"
    s = s + "#\n"
    s = s + "# Edit app/<page>/<page>.nbl (the UI) or app/<page>/<page>.tr (the\n"
    s = s + "# handlers) instead; this file is rewritten on every build. See\n"
    s = s + "# cli/codegen.tr for what goes into it and why each target differs.\n#\n"
    s = s + "# app: " + cfg.name + "  " + cfg.width.to_str() + "x" + cfg.height.to_str() + "  pages=" + Str.join(cfg.pages, ",") + "\n\n"
    return s

# Per-page info this module needs repeatedly: its markup (baked or empty, per
# is_freestanding), and whether its own .tr defines each optional export.
pub class PageInfo:
    pub name:          str
    pub markup:        str    # baked literal text, "" if read-from-disk at runtime
    pub has_tr:        bool
    pub has_register:  bool
    pub has_on_frame:  bool
    # True when this page's own .tr already names its exports `<page>_
    # register_all`/`<page>_on_frame` (page_imports' own comment has the
    # full story on why this form exists and when it's required).
    pub register_prefixed: bool
    pub on_frame_prefixed: bool

pub def load_page(cfg: Config, name: str, baked: bool) -> PageInfo:
    mut p = PageInfo()
    p.name = name
    p.markup = ""
    if baked:
        mut raw = File.read_text(cfg.page_nbl(name))
        p.markup = escape_literal(raw)
    mut tr_src = File.read_text(cfg.page_tr(name))
    p.has_tr = tr_src != ""
    # A real tauraroc bug: `from module import name as alias`, resolved at
    # its OWN call site, rewrites the alias back to the bare, un-aliased
    # `name` -- harmless for exactly one such import in a file, but once a
    # SECOND page's .tr ALSO exports a `register_all`, its own `register_all
    # as page2_register_all` import collapses onto the exact same bare
    # `register_all` symbol as page1's, so EVERY page's "own" handler ends
    # up silently calling whichever page's register_all happened to load
    # first -- reproduced exactly this way: a dashboard SPA's per-page
    # collapse/modal toggles all silently no-op on every page except the
    # very first one, despite each page's own .tr correctly defining and
    # registering its own handler. A page that names its export `<page>_
    # register_all`/`<page>_on_frame` directly sidesteps the bug entirely
    # (an already-unique name needs no alias, so there's nothing to
    # collapse) -- REQUIRED for any app with 2+ pages that each define one;
    # a single-page app can keep using the plain, un-prefixed name safely
    # (only one import exists, so no collision is possible either way).
    p.register_prefixed = Str.contains(tr_src, "pub def " + name + "_register_all(")
    p.on_frame_prefixed = Str.contains(tr_src, "pub def " + name + "_on_frame(")
    p.has_register = p.register_prefixed or Str.contains(tr_src, "pub def register_all(")
    p.has_on_frame = p.on_frame_prefixed or Str.contains(tr_src, "pub def on_frame(")
    return p

pub def load_pages(cfg: Config, target: int) -> List[PageInfo]:
    mut out: List[PageInfo] = []
    mut baked = is_freestanding(target)
    mut i = 0
    while i < len(cfg.pages):
        out.append(load_page(cfg, cfg.pages[i], baked))
        i = i + 1
    return out

# A page's module path, dotted: `app/home/home.tr` -> `app.home.home`.
def page_module(cfg: Config, name: str) -> str:
    mut path = cfg.page_tr(name)
    mut modpath = Str.slice(path, 0, Str.len(path) - 3)
    mut dotted = ""
    mut i = 0
    while i < Str.len(modpath):
        mut ch = Str.slice(modpath, i, i + 1)
        if ch == "/" or ch == "\\":
            dotted = dotted + "."
        else:
            dotted = dotted + ch
        i = i + 1
    return dotted

# See load_page's own comment for the full story on register_prefixed/
# on_frame_prefixed: a page whose .tr already names its export `<page>_
# register_all`/`<page>_on_frame` gets a plain, unaliased import (nothing
# to collapse); a page still using the shorter, un-prefixed `register_all`/
# `on_frame` gets the OLD aliased form, which stays real-bug-safe as long
# as at most one page in this build uses it (a lone alias never collides
# with anything) -- exactly the single-page case this convention has
# always covered.
def page_imports(cfg: Config, pages: List[PageInfo]) -> str:
    mut s = ""
    mut i = 0
    while i < len(pages):
        mut p = pages[i]
        if p.has_register or p.has_on_frame:
            mut names = ""
            if p.has_register:
                if p.register_prefixed: names = p.name + "_register_all"
                else: names = "register_all as " + p.name + "_register_all"
            if p.has_on_frame:
                if names != "": names = names + ", "
                if p.on_frame_prefixed: names = names + p.name + "_on_frame"
                else: names = names + "on_frame as " + p.name + "_on_frame"
            s = s + "from " + page_module(cfg, p.name) + " import " + names + "\n"
        i = i + 1
    return s

# `router` -- not just `var` (the Interpreter) -- so a page's own
# register_all() can register a handler that navigates (SPA sidebar/nav
# links, "back" buttons, ...) via toolkit.ui.router.Router.navigate(),
# without needing its own separate wiring path. Every register_calls()
# call site sits AFTER router_setup()'s own generated code in the same
# function (see gen_web/gen_desktop/gen_hosted's own ordering), which is
# always what names it bare `router` regardless of target -- see
# router_setup's own `declare` param for the one difference (mut vs
# plain assignment) between a fresh local and a module-level global.
def register_calls(pages: List[PageInfo], indent: str, var: str) -> str:
    mut s = ""
    mut i = 0
    while i < len(pages):
        mut p = pages[i]
        if p.has_register:
            s = s + indent + p.name + "_register_all(" + var + ", router)\n"
        i = i + 1
    return s

# nebula1.0 Phase 4 (baked images): `nebula run/build` scans `cfg.assets`
# and bakes every image file it finds into `nebula_assets/image_<name>.tr`
# (see cli/nebula.tr's bake_images()/ImageEntry) BEFORE this file's
# generate() ever runs -- `nebula_assets` is a plain, non-dotted-leading-
# char directory name on purpose, since `.nebula` (a leading dot) cannot
# appear inside a dotted Tauraro import path (`from .nebula.assets.x
# import y` doesn't parse the way `from app.home.home import y` does).
# One `from nebula_assets.image_<name> import <name>_w, <name>_h,
# <name>_pixels` per discovered image, `<name>` the SANITIZED identifier
# (ImageEntry.name), not the markup-facing path (ImageEntry.rel).
def image_imports(cfg: Config) -> str:
    mut s = ""
    mut i = 0
    while i < len(cfg.images):
        mut e = cfg.images[i]
        s = s + "from nebula_assets.image_" + e.name + " import " + e.name + "_w, " + e.name + "_h, " + e.name + "_pixels\n"
        i = i + 1
    return s

# The ImagePainter implementor every app with a discovered `images` list
# gets, generated rather than hand-written for the same reason
# register_handler's callers are generated: the SET of baked images is
# per-app (discovered from disk), unknowable to toolkit.ui.interp (see
# that file's own ImagePainter comment for why the toolkit can't just
# import app code directly). Matches on `name` against ImageEntry.rel --
# the exact `src-<rel>` value markup used -- NOT the sanitized identifier,
# so an author never needs to know the sanitization happened at all.
def image_painter_class(cfg: Config) -> str:
    if len(cfg.images) == 0:
        return ""
    mut s = "class AppImagePainter implements ImagePainter:\n"
    s = s + "    _unused: int\n\n"
    s = s + "extend AppImagePainter:\n"
    s = s + "    pub def init() -> AppImagePainter:\n"
    s = s + "        mut p = AppImagePainter()\n"
    s = s + "        p._unused = 0\n"
    s = s + "        return p\n\n"
    s = s + "    pub def paint(self, scene: Scene, x: int, y: int, w: int, h: int, ambient: int, name: str, tint: int) -> void:\n"
    mut branch = "if"
    mut i = 0
    while i < len(cfg.images):
        mut e = cfg.images[i]
        s = s + "        " + branch + " name == \"" + e.rel + "\":\n"
        s = s + "            scene.add(Cmd.image(x, y, w, h, " + e.name + "_w(), " + e.name + "_h(), " + e.name + "_pixels(), ambient, tint))\n"
        branch = "elif"
        i = i + 1
    s = s + "\n"
    return s

# nebula1.0 Phase 4 (custom font): `nebula_assets/font_data_custom.tr` (see
# cli/nebula.tr's bake_font()) exists only when `cfg.font != ""`. One
# import + one `Fonts.set_custom(...)` call, right after `Interpreter.init()`
# (which already built `fonts` via `Fonts.load()`) so `text-custom` is live
# from the very first render -- same "wire it in before anything reads it"
# shape register_image_painter()'s call site already follows.
def font_imports(cfg: Config) -> str:
    if cfg.font == "":
        return ""
    return "from nebula_assets.font_data_custom import font_custom_cell_w, font_custom_cell_h, font_custom_first_char, font_custom_glyph_count, font_custom_coverage\n"

def font_set_custom_call(cfg: Config, indent: str, var: str) -> str:
    if cfg.font == "":
        return ""
    return indent + var + ".fonts.set_custom(font_custom_cell_w(), font_custom_cell_h(), font_custom_first_char(), font_custom_glyph_count(), font_custom_coverage())\n"

# Emits `if router.current == "home": home_on_frame(...) \n elif ...` for
# whichever pages define it. `args` is the parameter list already
# comma-joined (canvas/w/h/mx/my/buttons/key/wheel -- the exact set a given
# target has available; hosted/desktop don't have a wheel, for instance).
def on_frame_dispatch(pages: List[PageInfo], indent: str, args: str) -> str:
    mut s = ""
    mut branch = "if"
    mut i = 0
    while i < len(pages):
        mut p = pages[i]
        if p.has_on_frame:
            s = s + indent + branch + " router.current == \"" + p.name + "\":\n"
            s = s + indent + "    " + p.name + "_on_frame(" + args + ")\n"
            branch = "elif"
        i = i + 1
    return s

# Registers every page's (baked or disk-read) markup with a Router and
# navigates to the initial one. `read_at_runtime` selects which -- see the
# module header's own note on why freestanding bakes and hosted/desktop read.
# `declare` is false for web/uefi: those already declare `router` as a
# module-level global (see gen_web/gen_uefi), and this runs inside a function
# body -- `mut router = ...` there would shadow the global with a local that
# dies on return, leaving the real global router with nothing registered.
def router_setup(cfg: Config, pages: List[PageInfo], read_at_runtime: bool, indent: str, declare: bool) -> str:
    mut s = ""
    if declare:
        s = s + indent + "mut router = Router.init()\n"
    else:
        s = s + indent + "router = Router.init()\n"
    mut i = 0
    while i < len(pages):
        mut p = pages[i]
        mut src_expr = ""
        if read_at_runtime:
            src_expr = "File.read_text(\"" + cfg.page_nbl(p.name) + "\")"
        else:
            src_expr = "\"" + p.markup + "\""
        s = s + indent + "router.register(\"" + p.name + "\", UiParser.init().parse(" + src_expr + "))\n"
        i = i + 1
    s = s + indent + "router.navigate(\"" + cfg.initial_page() + "\", {})\n"
    return s

# --- hosted: render one frame to a PPM ------------------------------------
def gen_hosted(cfg: Config, pages: List[PageInfo]) -> str:
    mut s = banner(cfg, "hosted")
    s = s + "from io.file import File\n"
    s = s + "from toolkit.ui.parser import UiParser\n"
    s = s + "from toolkit.ui.interp import Interpreter, render_to\n"
    s = s + "from toolkit.ui.router import Router\n"
    s = s + "from toolkit.render.hosted.buffer import BufferCanvas\n"
    s = s + page_imports(cfg, pages)
    s = s + font_imports(cfg)
    s = s + "\ndef main():\n"
    s = s + router_setup(cfg, pages, true, "    ", true)
    s = s + "\n    mut it = Interpreter.init()\n"
    s = s + "    it.root_bg = " + hex_of(cfg.bg) + "\n"
    s = s + font_set_custom_call(cfg, "    ", "it")
    s = s + register_calls(pages, "    ", "it")
    s = s + "    mut canvas = BufferCanvas.init(" + cfg.width.to_str() + ", " + cfg.height.to_str() + ", " + hex_of(cfg.bg) + ")\n"
    s = s + "    render_to(it, router.page({}), canvas)\n"
    s = s + on_frame_dispatch(pages, "    ", "canvas, " + cfg.width.to_str() + ", " + cfg.height.to_str() + ", -1, -1, 0, 0, 0")
    s = s + "    canvas.save_ppm(\".nebula/out.ppm\")\n"
    s = s + "    print(\"wrote .nebula/out.ppm  \" + it.stats())\n"
    return s

# --- desktop: a real SDL2 window with a live event loop -------------------
def gen_desktop(cfg: Config, pages: List[PageInfo]) -> str:
    mut s = banner(cfg, "desktop")
    s = s + "from io.file import File\n"
    s = s + "from toolkit.types import Event\n"
    s = s + "from toolkit.ui.parser import UiParser\n"
    s = s + "from toolkit.ui.interp import Interpreter, render_to, register_url_opener\n"
    s = s + "from toolkit.ui.router import Router\n"
    s = s + "from toolkit.render.desktop.sdl_canvas import SdlCanvas, poll_event, last_click, mouse_state\n"
    s = s + "from toolkit.render.desktop.sdl_bindings import SDL_Delay, Uint32\n"
    s = s + "from toolkit.platform.native_browser import NativeUrlOpener\n"
    s = s + page_imports(cfg, pages)
    s = s + font_imports(cfg)
    s = s + "\ndef main():\n"
    s = s + router_setup(cfg, pages, true, "    ", true)
    s = s + "\n    mut it = Interpreter.init()\n"
    s = s + "    it.root_bg = " + hex_of(cfg.bg) + "\n"
    s = s + font_set_custom_call(cfg, "    ", "it")
    s = s + register_calls(pages, "    ", "it")
    # nebula1.0 Phase 4 (`<link>`): a desktop window's own OS always has
    # SOME way to open a URL (Process.system("start ...") on this box's own
    # Windows target -- see toolkit.platform.browser's own header for the
    # non-Windows gap), unlike bare-metal/UEFI, so this is unconditional
    # the same way the web target's registration just below is.
    s = s + "    register_url_opener(it, NativeUrlOpener.init())\n"
    s = s + "    mut canvas = SdlCanvas.open(\"" + cfg.name + "\", " + cfg.width.to_str() + ", " + cfg.height.to_str() + ")\n"
    s = s + "    if not canvas.ok():\n"
    s = s + "        print(\"could not open a window -- is SDL2.dll beside the exe?\")\n"
    s = s + "        return\n\n"
    s = s + "    mut running = true\n"
    s = s + "    mut key = 0\n"
    s = s + "    while running:\n"
    # Drain every pending event per frame; one poll per frame lags under fast
    # input, and two poll call sites would steal each other's events.
    s = s + "        key = 0\n"
    s = s + "        mut draining = true\n"
    s = s + "        while draining:\n"
    s = s + "            mut code = poll_event()\n"
    s = s + "            if code == 0:\n"
    s = s + "                draining = false\n"
    s = s + "            elif code == 1:\n"
    s = s + "                running = false\n"
    s = s + "                draining = false\n"
    s = s + "            elif code == 2:\n"
    s = s + "                it.dispatch(last_click())\n\n"
    s = s + "        mut mx, my, mdown = mouse_state()\n"
    s = s + "        it.hover_x = mx\n"
    s = s + "        it.hover_y = my\n"
    s = s + "        it.pressed = mdown\n\n"
    s = s + "        canvas.clear(" + hex_of(cfg.bg) + ")\n"
    s = s + "        render_to(it, router.page({}), canvas)\n"
    s = s + on_frame_dispatch(pages, "        ", "canvas, " + cfg.width.to_str() + ", " + cfg.height.to_str() + ", mx, my, b2i(mdown), key, 0")
    s = s + "        canvas.present()\n"
    s = s + "        unsafe: SDL_Delay(16 as Uint32)\n\n"
    s = s + "    canvas.close()\n\n"
    s = s + "def b2i(b: bool) -> int:\n"
    s = s + "    if b: return 1\n"
    s = s + "    return 0\n"
    return s

# --- web: wasm exports, host page drives the loop --------------------------
#
# Renders through toolkit.render.web.canvas2d_renderer.Canvas2DCanvas (the
# browser's OWN Canvas2D -- real ctx.fillText/ctx.roundRect/etc via a few
# `extern "C"` JS imports), NOT the older toolkit.render.web.canvas.WebCanvas
# raw-pixel-buffer approach this generator used before: that one paints into
# a wasm linear-memory bitmap and blits it via ImageData, which is CPU-
# rasterized and comes out visibly softer than native text -- confirmed
# directly building examples/web_ide (a real text editor) with each and
# comparing. Canvas2DCanvas also needs toolkit.ui.interp's exec_cmds/
# execute_diff to route through the Renderer interface for panel fills and
# text (not just circles) to get this benefit -- see that file's own note,
# fixed the same session this generator was.
def gen_web(cfg: Config, pages: List[PageInfo]) -> str:
    mut s = banner(cfg, "web")
    s = s + "from toolkit.types import Event\n"
    s = s + "from toolkit.ui.parser import UiParser\n"
    s = s + "from toolkit.ui.interp import Interpreter, render_to, prewarm_widget_state, ImagePainter, register_image_painter, register_url_opener\n"
    s = s + "from toolkit.ui.router import Router\n"
    s = s + "from toolkit.render.scene import Scene, Cmd\n"
    s = s + "from toolkit.render.web.canvas2d_renderer import Canvas2DCanvas, canvas2d_renderer_of, Canvas2DUrlOpener\n"
    s = s + "from toolkit.render.renderer import Renderer\n"
    s = s + page_imports(cfg, pages)
    s = s + image_imports(cfg)
    s = s + font_imports(cfg)
    s = s + arena_hooks()
    s = s + image_painter_class(cfg)
    s = s + "pub export def nebula_heap_init(base: Pointer[u8], size: usize) -> void:\n"
    s = s + "    arena_init(base, size)\n\n"
    # Scalars only: module-level initializers with an ALLOCATING right-hand
    # side (a class .init(), a List/Dict literal) are deferred by tauraroc's
    # own wasm codegen to whichever exported call first references them --
    # see tauraro/src/codegen/c.tr's is_safe_global_init -- so Router/
    # Interpreter are built for real inside nebula_init's own body below,
    # not up here as a declared initializer.
    s = s + "mut _frames: int = 0\n"
    s = s + "mut _it: Interpreter = Interpreter.init()\n"
    s = s + "mut router: Router = Router.init()\n"
    # nebula1.0 Phase 3 (real fix, not the wasm-memory mitigation this
    # replaces): every frame's LayoutBox tree + Scene is genuinely reclaimed
    # now. The EARLIER attempt at this corrupted Interpreter.state, because
    # Interpreter.dispatch()'s click-driven state_set calls (checkbox
    # toggle, radio/tab selection, slider/dial value) can grow the state
    # Dict's backing storage the FIRST time any given element is ever
    # clicked -- unlike the hover/knob animation keys (grown deterministically
    # by ONE warm-up render, since anim_toward runs for every node with an
    # event_name regardless of mouse position), a click can land on a
    # never-before-clicked element at ANY point in a session, including
    # after per-frame release had already started -- and that growth landed
    # in the exact region about to be reclaimed. `prewarm_widget_state()`
    # (toolkit/ui/interp.tr) closes that gap: called once, right after the
    # warm-up render below, it force-touches EVERY click-driven key the tree
    # could ever have (each to its own already-correct default, so nothing
    # visibly changes) -- after which the state Dict's backing storage is
    # exactly as fully grown as StyleCache's already was, and a click can
    # never again need to allocate. Verified with the SAME 10k-frame
    # synthetic-click stress test that caught the original corruption --
    # this version holds arena_used() flat indefinitely instead of crashing.
    s = s + "mut _frame_mark: usize = 0 as usize\n"
    # Edge-detected, not polled: `buttons` is the CURRENT mouse-button state
    # every frame, not a one-shot click event, so dispatching whenever it's
    # nonzero fired once per frame for as long as a click was held (steps at
    # 60fps) -- toggling a checkbox/switch several times on a single click
    # that happened to span more than one frame, which read as "flickering".
    # Dispatch now only fires on the true down-edge (`buttons != 0` this
    # frame, `_prev_buttons == 0` last frame); a slider drag still continues
    # every frame regardless (see toolkit.ui.interp's own tag_slider()
    # comment: that path reads `self.pressed`/`self.mouse_x`, set below
    # unconditionally, not something gated on dispatch firing).
    s = s + "mut _prev_buttons: int = 0\n\n"
    s = s + "pub export def nebula_init(w: int, h: int) -> void:\n"
    s = s + router_setup(cfg, pages, false, "    ", false)
    s = s + "    _it = Interpreter.init()\n"
    s = s + "    _it.root_bg = " + hex_of(cfg.bg) + "\n"
    s = s + font_set_custom_call(cfg, "    ", "_it")
    s = s + register_calls(pages, "    ", "_it")
    if len(cfg.images) > 0:
        s = s + "    register_image_painter(_it, AppImagePainter.init())\n"
    # nebula1.0 Phase 4 (`<link>`): every web build gets a real UrlOpener --
    # unlike baked images/fonts, this needs no opt-in `nebula.conf` line
    # (a browser is always there to `window.open` into on this target).
    s = s + "    register_url_opener(_it, Canvas2DUrlOpener.init())\n"
    s = s + "    mut warm = Canvas2DCanvas.init(w, h)\n"
    s = s + "    _it.renderer = canvas2d_renderer_of(warm)\n"
    s = s + "    render_to(_it, router.page({}), warm)\n"
    s = s + "    prewarm_widget_state(_it)\n"
    # nebula1.0 Phase 4 (SPA nav): prewarm EVERY registered page's tree, not
    # just the initial one. The block above only ever renders+prewarms
    # whichever page `router_setup()` navigated to first -- but `router.
    # navigate()` (wired to every sidebar `@on_click` handler) can swap
    # `router.page({})` to any OTHER registered page on any later frame,
    # building THAT page's LayoutBox tree for the very first time, post-
    # `arena_mark()`. Its own click-driven state keys (radio/tabitem/
    # collapse/textinput -- see prewarm_widget_state's own comment on why
    # those specifically need this) were never touched by the single
    # initial-page prewarm above, so the FIRST navigation to a new page can
    # grow Interpreter.state's Dict backing storage mid-flight, in the
    # exact region about to be reclaimed -- the same crash class the
    # single-page prewarm above already exists to prevent, just never
    # extended past page 1. Reproduced exactly this way: `_trdrop_
    # LayoutBox` "memory access out of bounds" on frame 0 of a stress test
    # whose very first synthetic click lands on a sidebar nav icon.
    # Navigating through every page here (each render+prewarm is a no-op
    # past the first time any given key is touched) then back to the
    # initial page leaves `_it`/`router` in the same state this block
    # already left them in before, just with every page's keys pre-grown.
    mut i = 0
    while i < len(pages):
        mut p = pages[i]
        if p.name != cfg.initial_page():
            s = s + "    router.navigate(\"" + p.name + "\", {})\n"
            s = s + "    render_to(_it, router.page({}), warm)\n"
            s = s + "    prewarm_widget_state(_it)\n"
        i = i + 1
    if len(pages) > 1:
        s = s + "    router.navigate(\"" + cfg.initial_page() + "\", {})\n"
        s = s + "    render_to(_it, router.page({}), warm)\n"
    s = s + "    _frame_mark = arena_mark()\n"
    s = s + "\npub export def nebula_frames() -> int:\n"
    s = s + "    return _frames\n\n"
    s = s + "pub export def nebula_arena_used() -> int:\n"
    s = s + "    return arena_used() as int\n\n"
    # Host-cursor hint (1 = I-beam, 0 = default) -- the web host polls this
    # once per frame and sets the canvas element's own CSS `cursor` style,
    # since a single <canvas> has no per-region native cursor of its own.
    s = s + "pub export def nebula_cursor_kind() -> int:\n"
    s = s + "    return _it.hover_cursor_kind()\n\n"
    # nebula1.0 Phase 4 (page scroll): the host JS polls this after every
    # frame and grows the canvas/page to match when content is taller than
    # the viewport -- see toolkit.ui.interp's content_height() own comment.
    s = s + "pub export def nebula_content_height() -> int:\n"
    s = s + "    return _it.content_height()\n\n"
    s = s + "pub export def nebula_frame(w: int, h: int, mx: int, my: int, buttons: int, key: int, wheel: int) -> void:\n"
    s = s + "    _frames = _frames + 1\n\n"
    # dispatch() hit-tests against Interpreter.root, which is the tree the
    # PREVIOUS call's render_to built -- must run before that tree (and its
    # Scene) gets released just below, per arena.tr's own ordering rule.
    s = s + "    if buttons != 0 and _prev_buttons == 0:\n"
    s = s + "        _it.dispatch(Event.click(mx, my))\n"
    s = s + "    _prev_buttons = buttons\n"
    # nebula1.0 Phase 3: `key` was received by every generated nebula_frame
    # since this CLI existed, but never actually reached Interpreter.
    # dispatch() -- there was no `Event.key(...)` dispatch call anywhere in
    # generated code, on ANY target. `@on_key` handlers and (new)
    # `<textinput>` typing were both silently unreachable through the CLI
    # pipeline as a result (examples/web_ide's own hand-rolled key handling
    # never went through Interpreter.dispatch() at all, which is why this
    # went unnoticed until a textinput widget needed it). `key` is a
    # one-shot-per-frame value already (the host page zeroes it right after
    # each nebula_frame() call), so no edge-detection is needed the way
    # `buttons` (a live held-state) requires above.
    s = s + "    if key != 0:\n"
    s = s + "        _it.dispatch(Event.key(key))\n\n"
    s = s + "    _it.hover_x = mx\n"
    s = s + "    _it.hover_y = my\n"
    s = s + "    _it.pressed = buttons != 0\n"
    s = s + "    _it.mouse_x = mx\n"
    s = s + "    _it.mouse_y = my\n\n"
    s = s + "    arena_release(_frame_mark)\n"
    s = s + "    _frame_mark = arena_mark()\n\n"
    s = s + "    mut canvas = Canvas2DCanvas.init(w, h)\n"
    s = s + "    canvas.clear(" + hex_of(cfg.bg) + ")\n"
    s = s + "    mut renderer: Renderer = canvas2d_renderer_of(canvas)\n"
    s = s + "    _it.renderer = renderer\n\n"
    s = s + "    render_to(_it, router.page({}), canvas)\n"
    s = s + on_frame_dispatch(pages, "    ", "canvas, w, h, mx, my, buttons, key, wheel")
    return s

# --- uefi: the zig stub calls this once per frame ---------------------------
def gen_uefi(cfg: Config, pages: List[PageInfo]) -> str:
    mut s = banner(cfg, "uefi")
    s = s + "from toolkit.types import Event\n"
    s = s + "from toolkit.ui.parser import UiParser\n"
    s = s + "from toolkit.ui.interp import Interpreter, render_to\n"
    s = s + "from toolkit.ui.router import Router\n"
    s = s + "from toolkit.render.uefi.gop import GopCanvas\n"
    s = s + page_imports(cfg, pages)
    s = s + arena_hooks()
    s = s + "pub export def tauraro_heap_init(base: Pointer[u8], size: usize) -> void:\n"
    s = s + "    arena_init(base, size)\n\n"
    s = s + "mut _marked: bool = false\n"
    s = s + "mut _mark:   usize = 0 as usize\n"
    s = s + "mut _back:   Pointer[u32] = 0 as Pointer[u32]\n"
    s = s + "mut _it:     Interpreter = Interpreter.init()\n"
    s = s + "mut router:  Router = Router.init()\n"
    # Same edge-detection fix as gen_web -- see that function's own comment
    # for why polling `buttons != 0` every frame double/triple-fires a
    # click for as long as it's held.
    s = s + "mut _prev_buttons: int = 0\n\n"
    s = s + "pub export def tauraro_ui_frame(fb: Pointer[u32], width: int, height: int, pitch: int, mouse_x: int, mouse_y: int, buttons: int, key: int) -> int:\n"
    # Draw into RAM and blit once: the GOP framebuffer is uncached
    # write-combining memory, so per-pixel writes there are far slower than
    # RAM plus one sequential pass -- and painting straight to the scanout
    # means anything watching sees half-drawn frames.
    s = s + "    if not _marked:\n"
    s = s + "        unsafe:\n"
    s = s + "            _back = alloc[u32](width * height)\n"
    s = s + "        _mark = arena_mark()\n"
    s = s + "        _marked = true\n"
    s = s + router_setup(cfg, pages, false, "        ", false)
    s = s + "        _it = Interpreter.init()\n"
    s = s + "        _it.root_bg = " + hex_of(cfg.bg) + "\n"
    s = s + register_calls(pages, "        ", "_it")
    s = s + "    arena_release(_mark)\n\n"
    s = s + "    _it.hover_x = mouse_x\n"
    s = s + "    _it.hover_y = mouse_y\n"
    s = s + "    _it.pressed = buttons != 0\n\n"
    s = s + "    mut canvas = GopCanvas.init(_back, width, height, width)\n"
    s = s + "    render_to(_it, router.page({}), canvas)\n"
    s = s + on_frame_dispatch(pages, "    ", "canvas, width, height, mouse_x, mouse_y, buttons, key, 0")
    s = s + "    if buttons != 0 and _prev_buttons == 0:\n"
    s = s + "        _it.dispatch(Event.click(mouse_x, mouse_y))\n"
    s = s + "    _prev_buttons = buttons\n"
    # Same missing wiring as gen_web -- see that function's own comment:
    # `key` was never actually reaching Interpreter.dispatch() as an
    # Event.key(...) on any target.
    s = s + "    if key != 0:\n"
    s = s + "        _it.dispatch(Event.key(key))\n\n"
    s = s + "    unsafe:\n"
    s = s + "        mut y = 0\n"
    s = s + "        while y < height:\n"
    s = s + "            mut sr = y * width\n"
    s = s + "            mut dr = y * pitch\n"
    s = s + "            mut x = 0\n"
    s = s + "            while x < width:\n"
    s = s + "                fb.offset(dr + x).write(_back.offset(sr + x).read())\n"
    s = s + "                x = x + 1\n"
    s = s + "            y = y + 1\n\n"
    s = s + "    if key == 27:\n"
    s = s + "        return 1\n"
    s = s + "    return 0\n"
    return s

# --- bare metal: Tauraro's own boot glue, PPM over UART ---------------------
def gen_bare(cfg: Config, pages: List[PageInfo]) -> str:
    mut s = banner(cfg, "bare")
    s = s + "from std.hal.mmio import write32\n"
    s = s + "from toolkit.ui.parser import UiParser\n"
    s = s + "from toolkit.ui.interp import Interpreter, render_to\n"
    s = s + "from toolkit.ui.router import Router\n"
    s = s + "from toolkit.render.bare.framebuffer import FrameBuffer\n"
    s = s + page_imports(cfg, pages)
    s = s + arena_hooks()
    # print() has nowhere to go on a bare board; this is the CMSDK UART0 the
    # MPS2-AN385 exposes, which is also how the PPM leaves the machine.
    s = s + "@output\n"
    s = s + "def uart_write(t: Pointer[char]):\n"
    s = s + "    unsafe:\n"
    s = s + "        write32(0x40004008 as usize, 1 as u32)\n"
    s = s + "        mut i = 0\n"
    s = s + "        while t.offset(i).read() != (0 as char):\n"
    s = s + "            write32(0x40004000 as usize, t.offset(i).read() as u32)\n"
    s = s + "            i = i + 1\n\n"
    s = s + "@entry\n"
    s = s + "def kernel_main():\n"
    s = s + "    unsafe:\n"
    s = s + "        arena_init(0x20080000 as Pointer[u8], 0x00400000 as usize)\n\n"
    s = s + router_setup(cfg, pages, false, "    ", true)
    s = s + "\n    mut it = Interpreter.init()\n"
    s = s + "    it.root_bg = " + hex_of(cfg.bg) + "\n"
    s = s + register_calls(pages, "    ", "it")
    s = s + "    mut fb = FrameBuffer.init(" + cfg.width.to_str() + ", " + cfg.height.to_str() + ", " + hex_of(cfg.bg) + ")\n"
    s = s + "    render_to(it, router.page({}), fb)\n"
    s = s + on_frame_dispatch(pages, "    ", "fb, " + cfg.width.to_str() + ", " + cfg.height.to_str() + ", -1, -1, 0, 0, 0")
    s = s + "    fb.emit_ppm()\n"
    s = s + "    print(\"# \" + it.stats())\n"
    return s

# `#RRGGBB` (or a bare `RRGGBB`) -> a `0x...` literal for generated source.
# Anything malformed falls back to the project default rather than emitting
# code that will not compile.
pub def hex_of(s: str) -> str:
    mut v = s
    if Str.starts_with(v, "#"):
        v = Str.slice(v, 1, Str.len(v))
    if Str.len(v) != 6:
        return "0x0F172A"
    return "0x" + v

# The one entry point the rest of the CLI calls.
pub def generate(cfg: Config, target: int) -> str:
    mut pages = load_pages(cfg, target)
    if target == target_hosted():
        return gen_hosted(cfg, pages)
    if target == target_desktop():
        return gen_desktop(cfg, pages)
    if target == target_web():
        return gen_web(cfg, pages)
    if target == target_uefi():
        return gen_uefi(cfg, pages)
    if target == target_bare():
        return gen_bare(cfg, pages)
    return ""
