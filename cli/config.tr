# cli.config — nebula.conf, and the target table.
#
# The config format is deliberately trivial: `key = value`, one per line, `#`
# comments, everything a string until someone asks for it as an int. Tauraro
# has no TOML or JSON parser, and adding one to read six settings would be a
# larger dependency than the thing it configures.
#
# ## Pages, not a single entry file
#
# An app is one or more PAGES, each its own folder: `app/<name>/<name>.nbl`
# (the UI, as markup -- renamed from `.ui` so it reads as nebula's own
# format, not a generic "user interface" file) plus an optional
# `app/<name>/<name>.tr` (handlers, via `register_all(it)`, and optionally
# `on_frame(...)` for a page that needs to paint something the markup tree
# can't express -- see cli/codegen.tr's own header). `pages = home` is the
# default single-page app; `pages = home, settings, about` builds all three
# and wires them into one toolkit.ui.router.Router, navigable by name from
# any page's own handler code. This replaced a single `entry`/`handlers`
# pair per app -- found too cramped the first time a real app (an editor)
# needed more than one screen.

from io.file import File
from string.str import Str

# One baked image, DISCOVERED (not configured) by cli/nebula.tr's
# bake_images() scanning Config.assets -- there is no per-image line in
# nebula.conf; dropping a file in the assets dir is the whole registration
# step. `rel` is the file's path relative to the assets dir (e.g.
# "hero.jpg", or "icons/logo.png" for a nested one) -- this is BOTH the
# `src-<rel>` value an `<image>` tag matches by AND the generated
# AppImagePainter's dispatch key (cli/codegen.tr), so what you type in
# markup is exactly the path under the assets dir, nothing translated.
# `name` is `rel` sanitized into a valid Tauraro identifier (every non
# [a-zA-Z0-9] character becomes `_`) for the baked module's function names
# (`<name>_w()`/`_h()`/`_pixels()`) and its `nebula_assets/image_<name>.tr`
# filename -- markup never sees this form.
pub class ImageEntry:
    pub name: str
    pub rel:  str

pub class Config:
    pub name:     str
    pub width:    int
    pub height:   int
    pub page_dir: str        # base directory pages live under
    pub pages:    List[str]  # page names; pages[0] is the initial route
    pub bg:       str        # page background, as a #RRGGBB literal
    # nebula1.0 Phase 3: `width`/`height` are the INITIAL size on every
    # target and the ONLY size on hosted/desktop/uefi/bare (there is no
    # "window" to fill on those). On web, the default is to fill the
    # browser window and ignore width/height after the first paint --
    # `fixed_size = true` opts back into the old fixed-canvas behavior
    # (matches how every other nebula target already behaves, and is
    # useful for a kiosk-style app that wants a specific canvas size
    # regardless of the browser window). See cli/nebula.tr's host_page().
    pub fixed_size: bool
    # `assets = assets/` -- a DIRECTORY, scanned (recursively) for image
    # files at build time by cli/nebula.tr's bake_images(); "" (the
    # default) means no assets dir, nothing baked. See ImageEntry's own
    # comment for how a discovered file becomes a `src-<path>` token.
    pub assets:   str
    # Populated by bake_images() (a filesystem scan), NOT parsed from
    # nebula.conf directly -- unlike every other Config field, this one is
    # discovered, not configured. Empty until a build with `assets` set
    # actually runs.
    pub images:   List[ImageEntry]
    # `font = tools/fonts/MyFont.ttf` -- a custom text font, baked via the
    # EXISTING scripts/bake-font.ps1 (already fully generic -- takes an
    # arbitrary -FontPath/-OutTr/-Suffix, confirmed before this was added,
    # no script changes needed) into a 4th atlas slot
    # (toolkit.text.font.font_size_custom(), selected by the `text-custom`
    # Style token). "" (the default) means no custom font; every page keeps
    # using the toolkit's own baked-in JetBrains Mono.
    pub font:     str
    pub ok:       bool
    pub err:      str

extend Config:
    pub def defaults() -> Config:
        mut c = Config()
        c.name = "nebula-app"
        c.width = 900
        c.height = 560
        c.page_dir = "app"
        c.pages = ["home"]
        c.bg = "#0F172A"
        c.fixed_size = false
        c.assets = ""
        c.images = []
        c.font = ""
        c.ok = true
        c.err = ""
        return c

    pub def to_str(self) -> str:
        return self.name + " " + self.width.to_str() + "x" + self.height.to_str() + " pages=" + Str.join(self.pages, ",")

    pub def page_nbl(self, name: str) -> str:
        return self.page_dir + "/" + name + "/" + name + ".nbl"

    pub def page_tr(self, name: str) -> str:
        return self.page_dir + "/" + name + "/" + name + ".tr"

    pub def initial_page(self) -> str:
        if len(self.pages) == 0: return "home"
        return self.pages[0]

def apply_line(c: Config, line: str) -> void:
    mut s = Str.trim(line)
    if s == "":
        return
    if Str.starts_with(s, "#"):
        return
    mut eq = Str.index_of(s, "=")
    if eq <= 0:
        return
    mut key = Str.trim(Str.slice(s, 0, eq))
    mut val = Str.trim(Str.slice(s, eq + 1, Str.len(s)))
    # Strip one layer of surrounding quotes, so both `name = app` and
    # `name = "my app"` work and a value can contain spaces.
    mut n = Str.len(val)
    if n >= 2:
        if Str.starts_with(val, "\"") and Str.slice(val, n - 1, n) == "\"":
            val = Str.slice(val, 1, n - 1)

    if key == "name":
        c.name = val
    elif key == "width":
        if Str.is_digit(val):
            c.width = Str.parse_int(val)
    elif key == "height":
        if Str.is_digit(val):
            c.height = Str.parse_int(val)
    elif key == "page_dir":
        c.page_dir = val
    elif key == "pages":
        mut parts = Str.split(val, ",")
        mut cleaned: List[str] = []
        mut i = 0
        while i < len(parts):
            mut p = Str.trim(parts[i])
            if p != "": cleaned.append(p)
            i = i + 1
        if len(cleaned) > 0: c.pages = cleaned
    elif key == "bg":
        c.bg = val
    elif key == "fixed_size":
        c.fixed_size = val == "true"
    elif key == "assets":
        c.assets = val
    elif key == "font":
        c.font = val

pub def load_config(path: str) -> Config:
    mut c = Config.defaults()
    mut text = File.read_text(path)
    if text == "":
        c.ok = false
        c.err = "no " + path + " here -- run `nebula init <name>` first, or cd into a project"
        return c
    mut lines = Str.split(text, "\n")
    mut i = 0
    while i < len(lines):
        apply_line(c, lines[i])
        i = i + 1
    return c

# --- targets ---------------------------------------------------------------
#
# One place that knows the platform list, so `nebula run --wat` can say what
# it should have been rather than failing obscurely three layers down.

pub def target_hosted() -> int:
    return 0

pub def target_desktop() -> int:
    return 1

pub def target_web() -> int:
    return 2

pub def target_uefi() -> int:
    return 3

pub def target_bare() -> int:
    return 4

pub def target_unknown() -> int:
    return 0 - 1

pub def target_from_name(s: str) -> int:
    if s == "hosted":
        return target_hosted()
    if s == "desktop":
        return target_desktop()
    if s == "web":
        return target_web()
    if s == "uefi":
        return target_uefi()
    if s == "bare":
        return target_bare()
    return target_unknown()

pub def target_name(t: int) -> str:
    if t == target_hosted():
        return "hosted"
    if t == target_desktop():
        return "desktop"
    if t == target_web():
        return "web"
    if t == target_uefi():
        return "uefi"
    if t == target_bare():
        return "bare"
    return "?"

pub def all_target_names() -> str:
    return "hosted, desktop, web, uefi, bare"

# Freestanding targets have no filesystem, so their UI markup must be baked
# into the binary at build time rather than read at runtime. This one
# predicate drives that difference everywhere it matters.
pub def is_freestanding(t: int) -> bool:
    if t == target_web():
        return true
    if t == target_uefi():
        return true
    if t == target_bare():
        return true
    return false
