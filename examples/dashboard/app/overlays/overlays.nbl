# Overlays showcase -- part of the SPA sidebar nav (nebula1.0 Phase 4). See
# app/widgets/widgets.nbl's own header for why the chrome below is
# duplicated per page rather than shared.

<panel "flex-col w-full h-full bg-slate-50">

  <panel "flex-row items-center justify-between px-8 py-4 bg-white gap-6">
    <text "text-lg text-slate-800">Overlays</text>
  </panel>

  <panel "flex-row grow">

    <panel "flex-col w-20 bg-violet-600 to-pink-500 bg-gradient-b items-center py-8 gap-6">
      <listitem "group-nav value-0 key-overlaysnav0 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_home)>
        <image "tint src-icons/house.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-1 key-overlaysnav1 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_widgets)>
        <image "tint src-icons/user.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-2 key-overlaysnav2 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_forms)>
        <image "tint src-icons/gear.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-3 key-overlaysnav3 selected w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_overlays)>
        <image "tint src-icons/lock.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-4 key-overlaysnav4 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_media)>
        <image "tint src-icons/display.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-5 key-overlaysnav5 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_tabs)>
        <image "tint src-icons/circle-question.svg text-white w-6 h-6"/>
      </listitem>
    </panel>

    <panel "flex-col grow p-8 gap-6">
      <text "text-2xl text-slate-800">Overlays</text>
      <panel "flex-row gap-6 items-center">
        <panel "px-6 py-3 rounded-full bg-fuchsia-500 items-center justify-center" @on_click(on_toggle_demo_modal)>
          <text "text-white">Open modal</text>
        </panel>
        <panel "px-6 py-3 rounded-full bg-sky-500 items-center justify-center key-tooltiptrigger" @on_click(on_tooltip_trigger_noop)>
          <text "text-white">Hover for tooltip</text>
        </panel>
      </panel>
      <tooltip "for-tooltiptrigger x-260 y-160">
        <panel "bg-slate-800 rounded-lg px-3 py-2">
          <text "text-white text-sm">A tooltip, positioned near its trigger</text>
        </panel>
      </tooltip>
    </panel>
  </panel>

  <collapse "key-demomodal">
    <panel "overlay bg-black opacity-50 items-center justify-center" @on_click(on_toggle_demo_modal)>
      <panel "w-[380px] bg-white rounded-2xl p-6 gap-4 flex-col items-center shadow" @on_click(on_demo_dialog_body)>
        <text "text-lg text-slate-800">A modal dialog</text>
        <hr "text-slate-200 w-full"/>
        <text "text-slate-500">Built from `collapse` + `overlay`, same as the Settings modal on the Home page.</text>
        <panel "px-6 py-2 rounded-full bg-fuchsia-500 items-center justify-center" @on_click(on_toggle_demo_modal)>
          <text "text-white">Close</text>
        </panel>
      </panel>
    </panel>
  </collapse>
</panel>
