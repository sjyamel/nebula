# Tabs & lists showcase -- part of the SPA sidebar nav (nebula1.0 Phase 4).
# See app/widgets/widgets.nbl's own header for why the chrome below is
# duplicated per page rather than shared.

<panel "flex-col w-full h-full bg-slate-50">

  <panel "flex-row items-center justify-between px-8 py-4 bg-white gap-6">
    <text "text-lg text-slate-800">Tabs & Lists</text>
  </panel>

  <panel "flex-row grow">

    <panel "flex-col w-20 bg-violet-600 to-pink-500 bg-gradient-b items-center py-8 gap-6">
      <listitem "group-nav value-0 key-tabsnav0 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_home)>
        <image "tint src-icons/house.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-1 key-tabsnav1 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_widgets)>
        <image "tint src-icons/user.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-2 key-tabsnav2 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_forms)>
        <image "tint src-icons/gear.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-3 key-tabsnav3 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_overlays)>
        <image "tint src-icons/lock.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-4 key-tabsnav4 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_media)>
        <image "tint src-icons/display.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-5 key-tabsnav5 selected w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_tabs)>
        <image "tint src-icons/circle-question.svg text-white w-6 h-6"/>
      </listitem>
    </panel>

    <panel "flex-col grow p-8 gap-6">
      <text "text-2xl text-slate-800">Tabs & Lists</text>
      <panel "bg-white rounded-xl p-6 gap-4 flex-col shadow w-[480px]">
        <panel "flex-row gap-3">
          <tabitem "group-demotabs value-0 selected sel-sky-500 sel-to-blue-600 rounded-full border border-slate-300 px-5 py-2 items-center justify-center">
            <text "text-slate-700">Overview</text>
          </tabitem>
          <tabitem "group-demotabs value-1 sel-sky-500 sel-to-blue-600 rounded-full border border-slate-300 px-5 py-2 items-center justify-center">
            <text "text-slate-700">Activity</text>
          </tabitem>
          <tabitem "group-demotabs value-2 sel-sky-500 sel-to-blue-600 rounded-full border border-slate-300 px-5 py-2 items-center justify-center">
            <text "text-slate-700">Settings</text>
          </tabitem>
        </panel>
        <hr "text-slate-200 w-full"/>
        <panel "flex-col gap-1">
          <listitem "group-demolist value-0 selected rounded-lg px-3 py-2">
            <text "text-slate-700">List item one</text>
          </listitem>
          <listitem "group-demolist value-1 rounded-lg px-3 py-2">
            <text "text-slate-700">List item two</text>
          </listitem>
          <listitem "group-demolist value-2 rounded-lg px-3 py-2">
            <text "text-slate-700">List item three</text>
          </listitem>
        </panel>
        <hr "text-slate-200 w-full"/>
        <panel "grid grid-cols-3 gap-4">
          <panel "bg-slate-100 rounded-lg p-4 items-center justify-center">
            <text "text-slate-700">Grid 1</text>
          </panel>
          <panel "bg-slate-100 rounded-lg p-4 items-center justify-center">
            <text "text-slate-700">Grid 2</text>
          </panel>
          <panel "bg-slate-100 rounded-lg p-4 items-center justify-center">
            <text "text-slate-700">Grid 3</text>
          </panel>
        </panel>
      </panel>
    </panel>
  </panel>
</panel>
