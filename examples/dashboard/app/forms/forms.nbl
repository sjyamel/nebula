# Forms showcase -- part of the SPA sidebar nav (nebula1.0 Phase 4). See
# app/widgets/widgets.nbl's own header for why the chrome below is
# duplicated per page rather than shared.

<panel "flex-col w-full h-full bg-slate-50">

  <panel "flex-row items-center justify-between px-8 py-4 bg-white gap-6">
    <text "text-lg text-slate-800">Forms</text>
  </panel>

  <panel "flex-row grow">

    <panel "flex-col w-20 bg-violet-600 to-pink-500 bg-gradient-b items-center py-8 gap-6">
      <listitem "group-nav value-0 key-formsnav0 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_home)>
        <image "tint src-icons/house.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-1 key-formsnav1 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_widgets)>
        <image "tint src-icons/user.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-2 key-formsnav2 selected w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_forms)>
        <image "tint src-icons/gear.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-3 key-formsnav3 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_overlays)>
        <image "tint src-icons/lock.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-4 key-formsnav4 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_media)>
        <image "tint src-icons/display.svg text-white w-6 h-6"/>
      </listitem>
      <listitem "group-nav value-5 key-formsnav5 w-11 h-11 rounded-xl items-center justify-center" @on_click(on_nav_tabs)>
        <image "tint src-icons/circle-question.svg text-white w-6 h-6"/>
      </listitem>
    </panel>

    <panel "flex-col grow p-8 gap-6">
      <text "text-2xl text-slate-800">Forms</text>
      <panel "bg-white rounded-xl p-6 gap-4 flex-col shadow w-[420px]">
        <label "for-demoinput">
          <text "text-slate-600">Your name (click this label to focus the field)</text>
        </label>
        <textinput "key-demoinput bg-slate-100 rounded-lg px-3 py-2 placeholder-Type_here..."/>
        <hr "text-slate-200 w-full"/>
        <panel "flex-col">
          <panel "flex-row items-center justify-between" @on_click(on_toggle_demo_dropdown)>
            <text "text-slate-700">Choose a plan</text>
            <text "text-slate-400">v</text>
          </panel>
          <collapse "key-plandropdown">
            <panel "flex-col gap-1 pt-2">
              <panel "flex-row items-center gap-3 p-1">
                <radio "group-demoplan value-0 selected w-4 h-4"/>
                <text "text-slate-700">Free</text>
              </panel>
              <panel "flex-row items-center gap-3 p-1">
                <radio "group-demoplan value-1 w-4 h-4"/>
                <text "text-slate-700">Pro</text>
              </panel>
              <panel "flex-row items-center gap-3 p-1">
                <radio "group-demoplan value-2 w-4 h-4"/>
                <text "text-slate-700">Team</text>
              </panel>
            </panel>
          </collapse>
        </panel>
      </panel>
    </panel>
  </panel>
</panel>
