# The same screen after an "edit": the row became a column, the palette
# changed, and a row was added. Nothing was recompiled to make this happen --
# the demo renders app.ui and then this file through the SAME live Interpreter.

<panel "flex-col p-4 gap-3 bg-steel">
  <text "text-amber">RELOADED WITHOUT A REBUILD</text>
  <panel "flex-col gap-2 h-90">
    <panel "bg-violet grow" />
    <panel "bg-amber grow" />
  </panel>
  <panel "flex-row gap-3 h-40 p-3 bg-slate">
    <button "bg-green grow" @on_click(on_ok)>
      <text "text-white">OK</text>
    </button>
    <button "bg-red grow" @on_click(on_cancel)>
      <text "text-white">CANCEL</text>
    </button>
    <panel "bg-mist w-40" />
  </panel>
</panel>
